local function isCharacterObject(obj)
    local current = obj
    while current and current ~= workspace do
        if current:IsA("Model") then
            local humanoid = current:FindFirstChildOfClass("Humanoid")
            if humanoid then
                return true
            end
        end
        current = current.Parent
    end
    return false
end

local function isGroundPart(part)
    if not part:IsA("BasePart") then return false end

    local name = part.Name:lower()
    local groundNames = {
        "baseplate", "floor", "ground", "chão", "chao",
        "grass", "grama", "terrain", "water", "água", "agua",
        "sand", "areia", "road", "estrada", "asphalt", "asfalto",
        "path", "caminho", "tile", "piso", "platform", "plataforma"
    }
    for _, pattern in ipairs(groundNames) do
        if name:find(pattern, 1, true) then
            return true
        end
    end

    local size = part.Size
    if size.Y < 3 and (size.X > 50 or size.Z > 50) then
        return true
    end

    return false
end

local function isIndicator(obj)
    if not obj:IsA("BasePart") then return false end

    local mat = obj.Material
    if mat == Enum.Material.Neon or mat == Enum.Material.ForceField then
        return true
    end

    local name = obj.Name:lower()
    local indicatorNames = {
        "range", "circle", "radius", "indicator", "hitbox",
        "aura", "ring", "zone", "area", "marker", "highlight",
        "visual", "effect", "glow", "outline", "selection"
    }
    for _, pattern in ipairs(indicatorNames) do
        if name:find(pattern, 1, true) then
            return true
        end
    end

    return false
end

local function hideStructures()
    OriginalStructures = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if not isCharacterObject(obj) and not isIndicator(obj) then

            if obj:IsA("BasePart") and not isGroundPart(obj) then
                table.insert(OriginalStructures, {
                    obj = obj,
                    type = "part",
                    transparency = obj.Transparency,
                    canCollide = obj.CanCollide,
                })
                obj.Transparency = 1
                obj.CanCollide = false

            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                local parent = obj.Parent
                local parentIsGround = parent and parent:IsA("BasePart") and isGroundPart(parent)
                local parentIsChar = parent and isCharacterObject(parent)
                if not parentIsGround and not parentIsChar then
                    table.insert(OriginalStructures, {
                        obj = obj,
                        type = "decal",
                        transparency = obj.Transparency,
                    })
                    obj.Transparency = 1
                end

            elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                local parent = obj.Parent
                local parentIsGround = parent and parent:IsA("BasePart") and isGroundPart(parent)
                local parentIsChar = parent and isCharacterObject(parent)
                if not parentIsGround and not parentIsChar then
                    table.insert(OriginalStructures, {
                        obj = obj,
                        type = "gui",
                        enabled = obj.Enabled,
                    })
                    obj.Enabled = false
                end
            end
        end
    end

    print(("[RAMDOM HUB] Estruturas escondidas: %d objetos"):format(#OriginalStructures))
end

local function restoreStructures()
    for _, data in ipairs(OriginalStructures) do
        pcall(function()
            if data.obj and data.obj.Parent then
                if data.type == "part" then
                    data.obj.Transparency = data.transparency
                    data.obj.CanCollide = data.canCollide
                elseif data.type == "decal" then
                    data.obj.Transparency = data.transparency
                elseif data.type == "gui" then
                    data.obj.Enabled = data.enabled
                end
            end
        end)
    end
    OriginalStructures = {}
    print("[RAMDOM HUB] Estruturas restauradas!")
end

