local function getClickPosition()
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(800, 600)

    local candidates = {
        Vector2.new(vp.X * 0.50, vp.Y * 0.50),
        Vector2.new(vp.X * 0.50, vp.Y * 0.25),
        Vector2.new(vp.X * 0.80, vp.Y * 0.50),
        Vector2.new(vp.X * 0.20, vp.Y * 0.50),
        Vector2.new(vp.X * 0.97, vp.Y * 0.50),
        Vector2.new(vp.X * 0.03, vp.Y * 0.50),
    }

    if not (ScreenGui and Main and ScreenGui.Enabled) then
        return candidates[1]
    end

    local PAD = 12
    local pos, size = Main.AbsolutePosition, Main.AbsoluteSize
    for _, p in ipairs(candidates) do
        local inside = p.X >= pos.X - PAD and p.X <= pos.X + size.X + PAD
            and p.Y >= pos.Y - PAD and p.Y <= pos.Y + size.Y + PAD
        if not inside then
            return p
        end
    end
    return nil
end

local function clickOnce(singleBackend)
    local p = getClickPosition()
    if not p then return false end

    local clicked = false

    if CombatCfg.ClickVIM then
        local ok = pcall(function()
            VirtualInputManager:SendMouseButtonEvent(p.X, p.Y, 0, true, game, 0)
            task.wait(0.01)
            VirtualInputManager:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 0)
        end)
        clicked = ok
    end

    if CombatCfg.ClickVirtualUser and (not singleBackend or not clicked) then
        local ok = pcall(function()
            local cam = workspace.CurrentCamera
            local cf = cam and cam.CFrame or CFrame.new()
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(p, cf)
            task.wait(0.01)
            VirtualUser:Button1Up(p, cf)
        end)
        clicked = clicked or ok
    end

    return clicked
end

