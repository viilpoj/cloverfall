local function createDragHandle(axis)
    local h = Instance.new("Frame")
    h.Name = "Drag_" .. axis
    h.BackgroundTransparency = 1
    h.BorderSizePixel = 0
    h.Active = true
    h.ZIndex = 10
    h.Parent = Main

    local EDGE = 16
    local CORNER = 36

    if axis == "left" then
        h.Size = UDim2.new(0, EDGE, 1, -HEADER_H)
        h.Position = UDim2.new(0, 0, 0, HEADER_H)
    elseif axis == "right" then
        h.Size = UDim2.new(0, EDGE, 1, -HEADER_H)
        h.Position = UDim2.new(1, -EDGE, 0, HEADER_H)
    elseif axis == "top" then
        h.Size = UDim2.new(1, -140, 0, EDGE)
        h.Position = UDim2.new(0, 0, 0, 0)
    elseif axis == "bottom" then
        h.Size = UDim2.new(1, 0, 0, EDGE)
        h.Position = UDim2.new(0, 0, 1, -EDGE)
    elseif axis == "topleft" then
        h.Size = UDim2.new(0, CORNER, 0, CORNER)
        h.Position = UDim2.new(0, 0, 0, 0)
    elseif axis == "topright" then
        h.Size = UDim2.new(0, CORNER, 0, CORNER)
        h.Position = UDim2.new(1, -CORNER, 0, 0)
    elseif axis == "bottomleft" then
        h.Size = UDim2.new(0, CORNER, 0, CORNER)
        h.Position = UDim2.new(0, 0, 1, -CORNER)
    elseif axis == "bottomright" then
        h.Size = UDim2.new(0, CORNER, 0, CORNER)
        h.Position = UDim2.new(1, -CORNER, 1, -CORNER)
    end

    makeDraggable(h, Main)
end

