local uiOpen = true

local function openUI()
    if uiOpen then return end
    uiOpen = true
    ScreenGui.Enabled = true
    Main.Size = UDim2.new(0, 0, 0, 0)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    tween(Main, {Size = CONFIG.UISize, Position = CONFIG.UIOffset}, 0.3, Enum.EasingStyle.Back)
end

local function closeUI()
    if not uiOpen then return end
    uiOpen = false
    tween(Main, {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
    }, 0.2)
    task.wait(0.2)
    ScreenGui.Enabled = false
end

local function toggleUI()
    if uiOpen then closeUI() else openUI() end
end

local function destroyScript()
    pcall(AutoMob.Stop)
    pcall(AutoMiner.Stop)
    if _G.CombatToggleAttack then _G.CombatToggleAttack(false) end
    if _G.CombatToggleSkill then _G.CombatToggleSkill(false) end
    if _G.CombatEquipSlot then _G.CombatEquipSlot(0) end
    pcall(function() if ScreenGui then ScreenGui:Destroy() end end)
    pcall(function() if SmallGui then SmallGui:Destroy() end end)
    optimizationLoading = false
    restoreStructures()
    stopAntiAFK()
    stopNoclip()
    pcall(function()
        settings().Rendering.QualityLevel = OriginalGraphics
    end)
end

_G.__RamdomHubStop = destroyScript

