local CHARACTER_NAME_HINTS = {
    "npc", "mob", "enemy", "enemies", "monster", "boss", "paladin",
    "skeleton", "zombie", "bandit", "goblin", "warrior", "guard",
    "soldier", "creature", "character", "dummy", "minion", "undead",
    "pirate", "knight", "merchant", "vendor", "shopkeeper", "questgiver",
    "trainer", "raider", "beast", "demon", "savage", "slime", "orc",
    "wolf", "bear", "sorcerer", "mage", "assassin", "archer", "villager"
}

local CHARACTER_CONTAINER_NAMES = {
    npcs = true, npc = true, mobs = true, enemies = true, monsters = true,
    characters = true, actors = true, creatures = true, livecharacters = true,
    liveentities = true, hostilemobs = true,
}

-- Constantes fora de isGroundPart para evitar milhares de tabelas temporárias
-- durante a varredura inicial do mapa.
local GROUND_NAME_MIN_HORIZONTAL = {
    baseplate = 8, mapground = 8, worldground = 8, terrain = 8,
    ground = 12, groundpart = 12, grassground = 8, sandground = 8,
    grass = 8, sand = 8, dirt = 8, earth = 12,
    road = 12, asphalt = 12, path = 14, floor = 50, floorbase = 25,
    mapfloor = 25, land = 20,
}
local GROUND_NAME_PREFIXES = {
    { "baseplate", 8 }, { "mapground", 8 }, { "worldground", 8 },
    { "ground", 12 }, { "sand", 8 }, { "grass", 8 }, { "dirt", 8 },
    { "asphalt", 12 }, { "road", 12 }, { "path", 14 },
}
local GROUND_MATERIALS = {
    ["Enum.Material.Grass"] = true,
    ["Enum.Material.LeafyGrass"] = true,
    ["Enum.Material.Sand"] = true,
    ["Enum.Material.Ground"] = true,
    ["Enum.Material.Mud"] = true,
    ["Enum.Material.Asphalt"] = true,
}

local function isCharacterObject(obj)
    local current = obj
    while current and current ~= workspace do
        local lowerName = string.lower(tostring(current.Name or ""))
        local compactName = lowerName:gsub("[%s_%-]", "")

        if current == player.Character then
            return true
        end
        if CHARACTER_CONTAINER_NAMES[compactName] then
            return true
        end
        if current:IsA("Model") then
            if current:FindFirstChildOfClass("Humanoid") then
                return true
            end
            -- Protege mobs/NPCs que usem um modelo sem Humanoid.
            for _, hint in ipairs(CHARACTER_NAME_HINTS) do
                if compactName:find(hint, 1, true) then
                    return true
                end
            end
        end
        current = current.Parent
    end
    return false
end

local function isGroundPart(part)
    if not part or not part:IsA("BasePart") then return false end

    local name = string.lower(tostring(part.Name or "")):gsub("[%s_%-]", "")
    local size = part.Size
    local horizontal = math.max(size.X, size.Z)
    local thin = size.Y <= math.max(3, horizontal * 0.12)

    -- Nomes de superfície só são aceitos quando a peça realmente parece uma
    -- superfície horizontal fina; folhas e galhos chamados "Grass" não passam.
    local minHorizontal = GROUND_NAME_MIN_HORIZONTAL[name]
    if not minHorizontal then
        -- Também reconhece nomes comuns de chão numerados, por exemplo Grass_1,
        -- SandTile02 ou Ground_Part, sem tratar copa/galhos grossos como terreno.
        for _, rule in ipairs(GROUND_NAME_PREFIXES) do
            if name:find(rule[1], 1, true) then
                minHorizontal = rule[2]
                break
            end
        end
    end
    if minHorizontal and horizontal >= minHorizontal and thin then
        return true
    end

    -- Fallback para Baseplate/mapas que usam nomes genéricos.
    if size.Y <= 2.5 and (size.X >= 150 or size.Z >= 150) then
        return true
    end

    -- Uma superfície de terreno enorme pode não ter nome reconhecível.
    local materialName = tostring(part.Material)
    if GROUND_MATERIALS[materialName] and horizontal >= 100 and size.Y <= 3 then
        return true
    end

    return false
end

local function addHighlight(obj)
    if not obj or not obj.Parent or not obj:IsA("BasePart") then return end
    if StructureHighlights[obj] then return end

    local sb = Instance.new("SelectionBox")
    sb.Adornee = obj
    sb.Color3 = Color3.fromRGB(120, 90, 255)
    sb.LineThickness = 0.05
    sb.SurfaceTransparency = 1
    sb.Parent = obj
    StructureHighlights[obj] = sb
end

local function removeHighlight(obj)
    if StructureHighlights[obj] then
        pcall(function() StructureHighlights[obj]:Destroy() end)
        StructureHighlights[obj] = nil
    end
end

local function removeAllHighlights()
    for obj, sb in pairs(StructureHighlights) do
        pcall(function() sb:Destroy() end)
    end
    StructureHighlights = {}
end

local function updateHighlightsLoop()
    if LocateThread then pcall(task.cancel, LocateThread) end
    LocateThread = task.spawn(function()
        while getLocateStructures and getLocateStructures() and getOtimizacao and getOtimizacao() do
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local pos = root and root.Position

            if pos then
                for _, data in ipairs(OriginalStructures) do
                    if data.type == "part" and data.obj and data.obj.Parent then
                        local dist = (data.obj.Position - pos).Magnitude
                        if dist <= LOCATE_RADIUS then
                            addHighlight(data.obj)
                        else
                            removeHighlight(data.obj)
                        end
                    end
                end
            end
            task.wait(0.5)
        end
        LocateThread = nil
    end)
end

local function rememberAndHide(obj, data)
    if StructureRecordByObject[obj] then return end
    StructureRecordByObject[obj] = data
    table.insert(OriginalStructures, data)
end

local function processStructure(obj)
    if not obj or not obj.Parent then return end
    if isCharacterObject(obj) then return end

    if obj:IsA("BasePart") then
        if isGroundPart(obj) then return end
        if StructureRecordByObject[obj] then
            -- Outra rotina pode ter alterado a peça depois do primeiro scan.
            pcall(function()
                obj.Transparency = 1
                obj.LocalTransparencyModifier = 1
                obj.CanCollide = false
                obj.CastShadow = false
            end)
            return
        end

        local data = {
            obj = obj,
            type = "part",
            transparency = obj.Transparency,
            localTransparencyModifier = obj.LocalTransparencyModifier,
            canCollide = obj.CanCollide,
        }
        rememberAndHide(obj, data)
        pcall(function()
            obj.Transparency = 1
            obj.LocalTransparencyModifier = 1
            obj.CanCollide = false
            obj.CastShadow = false
        end)

    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        local parent = obj.Parent
        if parent and parent:IsA("BasePart") and isGroundPart(parent) then return end
        if StructureRecordByObject[obj] then return end
        rememberAndHide(obj, {
            obj = obj,
            type = "decal",
            transparency = obj.Transparency,
        })
        pcall(function() obj.Transparency = 1 end)

    elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
        local parent = obj.Parent
        if parent and parent:IsA("BasePart") and isGroundPart(parent) then return end
        if StructureRecordByObject[obj] then return end
        rememberAndHide(obj, {
            obj = obj,
            type = "gui",
            enabled = obj.Enabled,
        })
        pcall(function() obj.Enabled = false end)
    end
end

--// ============ CONTROLE DE SOMBRAS ============
local ShadowState = {
    GlobalShadows = nil,
    Parts = setmetatable({}, { __mode = "k" }),
    Connection = nil,
}

local function recordAndDisableShadow(part)
    if not part or not part:IsA("BasePart") then return end
    if ShadowState.Parts[part] == nil then
        ShadowState.Parts[part] = part.CastShadow
    end
    if part.CastShadow then
        pcall(function() part.CastShadow = false end)
    end
end

local function removeAllShadows()
    pcall(function()
        if ShadowState.GlobalShadows == nil then
            ShadowState.GlobalShadows = Lighting.GlobalShadows
        end
        Lighting.GlobalShadows = false
    end)

    if ShadowState.Connection then
        ShadowState.Connection:Disconnect()
        ShadowState.Connection = nil
    end
    -- Conecta antes do scan para também capturar peças que apareçam durante ele.
    ShadowState.Connection = workspace.DescendantAdded:Connect(function(obj)
        if not obj:IsA("BasePart") then return end
        task.defer(function()
            if obj.Parent and getOtimizacao and getOtimizacao() then
                recordAndDisableShadow(obj)
            end
        end)
    end)

    local count = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if not (getOtimizacao and getOtimizacao()) then
            return
        end
        if obj:IsA("BasePart") then
            recordAndDisableShadow(obj)
            count = count + 1
            if count % 500 == 0 then task.wait() end
        end
    end

    if not (getOtimizacao and getOtimizacao()) then return end
    print(("[RAMDOM HUB] Sombras desativadas em %d partes"):format(count))
end

local function restoreAllShadows()
    if ShadowState.Connection then
        ShadowState.Connection:Disconnect()
        ShadowState.Connection = nil
    end

    for part, originalValue in pairs(ShadowState.Parts) do
        pcall(function()
            if part and part.Parent then
                part.CastShadow = originalValue
            end
        end)
    end
    ShadowState.Parts = setmetatable({}, { __mode = "k" })

    if ShadowState.GlobalShadows ~= nil then
        pcall(function() Lighting.GlobalShadows = ShadowState.GlobalShadows end)
        ShadowState.GlobalShadows = nil
    end
    print("[RAMDOM HUB] Sombras restauradas!")
end

local function isInCameraView(part)
    local camera = workspace.CurrentCamera
    if not camera or not part or not part.Parent then return false end
    local ok, projected, onScreen = pcall(function()
        local point, visible = camera:WorldToViewportPoint(part.Position)
        return point, visible
    end)
    return ok and projected and onScreen and projected.Z > 0
end

local function startVisibleStructureSweep()
    if visibleSweepThread then return end
    visibleSweepThread = task.spawn(function()
        while getOtimizacao and getOtimizacao() do
            local descendants = workspace:GetDescendants()
            for index, obj in ipairs(descendants) do
                if not (getOtimizacao and getOtimizacao()) then break end
                if obj:IsA("BasePart")
                    and not StructureRecordByObject[obj]
                    and not isCharacterObject(obj)
                    and not isGroundPart(obj)
                    and isInCameraView(obj) then
                    processStructure(obj)
                end
                if index % VISIBLE_SWEEP_YIELD_EVERY == 0 then
                    task.wait()
                end
            end
            task.wait(VISIBLE_SWEEP_INTERVAL)
        end
        visibleSweepThread = nil
    end)
end

local function hideStructures()
    if optimizationConnection then
        optimizationConnection:Disconnect()
        optimizationConnection = nil
    end
    if visibleSweepThread then
        pcall(task.cancel, visibleSweepThread)
        visibleSweepThread = nil
    end

    OriginalStructures = {}
    StructureRecordByObject = setmetatable({}, { __mode = "k" })

    -- Conecta primeiro para não perder estruturas que apareçam enquanto o scan inicial roda.
    optimizationConnection = workspace.DescendantAdded:Connect(function(obj)
        task.delay(0.25, function()
            if getOtimizacao and getOtimizacao() and obj and obj.Parent then
                processStructure(obj)
            end
        end)
    end)

    local descendants = workspace:GetDescendants()
    for index, obj in ipairs(descendants) do
        if not (getOtimizacao and getOtimizacao()) then break end
        processStructure(obj)
        if index % 500 == 0 then task.wait() end
    end

    if getOtimizacao and getOtimizacao() then
        startVisibleStructureSweep()
    end
    print(("[RAMDOM HUB] Estruturas escondidas: %d objetos"):format(#OriginalStructures))
end

local function restoreStructures()
    if optimizationConnection then
        optimizationConnection:Disconnect()
        optimizationConnection = nil
    end
    if visibleSweepThread then
        pcall(task.cancel, visibleSweepThread)
        visibleSweepThread = nil
    end
    if LocateThread then
        pcall(task.cancel, LocateThread)
        LocateThread = nil
    end
    removeAllHighlights()

    for _, data in ipairs(OriginalStructures) do
        pcall(function()
            if data.obj and data.obj.Parent then
                if data.type == "part" then
                    data.obj.Transparency = data.transparency
                    data.obj.LocalTransparencyModifier = data.localTransparencyModifier or 0
                    data.obj.CanCollide = data.canCollide
                elseif data.type == "decal" then
                    data.obj.Transparency = data.transparency
                elseif data.type == "gui" then
                    data.obj.Enabled = data.enabled
                end
            end
        end)
    end
    OriginalStructures = {}
    StructureRecordByObject = setmetatable({}, { __mode = "k" })
    print("[RAMDOM HUB] Estruturas restauradas!")
end

local optimizationLoading = false

local function waitAndHide(stateChecker)
    if optimizationLoading then return end
    optimizationLoading = true

    task.spawn(function()
        pcall(applyMaxViewDistance)

        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Fps Boost",
                Text = "Removendo estruturas do cenário e desativando sombras...",
                Duration = 3,
            })
        end)

        if stateChecker() then
            hideStructures()
            if stateChecker() then
                removeAllShadows()
            end
            if stateChecker() and getLocateStructures and getLocateStructures() then
                updateHighlightsLoop()
            end
        else
            restoreStructures()
            restoreAllShadows()
            restoreViewDistance()
        end

        optimizationLoading = false
    end)
end

