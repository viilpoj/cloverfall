local function createToggleCard(parent, layoutOrder, label, defaultOn, callback)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 64)
    card.BackgroundColor3 = Theme.Card
    card.BorderSizePixel = 0
    card.LayoutOrder = layoutOrder
    card.Parent = parent
    addCorner(card, 14)
    addStroke(card, Theme.Stroke, 1, 0.5)
    addGradient(card, Theme.CardHover, Theme.Card, 90)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -120, 1, 0)
    title.Position = UDim2.new(0, 16, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = label
    title.TextColor3 = Theme.Text
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = card

    local track = Instance.new("TextButton")
    track.Size = UDim2.new(0, 52, 0, 28)
    track.Position = UDim2.new(1, -68, 0.5, -14)
    track.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = card
    addCorner(track, 14)
    local trackStroke = addStroke(track, Theme.Stroke, 1, 0.3)

    local trackGrad = Instance.new("UIGradient")
    trackGrad.Color = TOGGLE_OFF
    trackGrad.Rotation = 0
    trackGrad.Enabled = true
    trackGrad.Parent = track

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(22, 22)
    knob.Position = UDim2.new(0, 3, 0.5, -11)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = track
    addCorner(knob, 11)

    local isOn = false

    local function render()
        if isOn then
            trackGrad.Color = TOGGLE_ON
            trackStroke.Transparency = 0.6
            tween(knob, {Position = UDim2.new(1, -25, 0.5, -11)}, 0.18)
        else
            trackGrad.Color = TOGGLE_OFF
            trackStroke.Transparency = 0.3
            tween(knob, {Position = UDim2.new(0, 3, 0.5, -11)}, 0.18)
        end
    end

    local function setState(state, silent)
        isOn = state
        render()
        if not silent and callback then
            callback(isOn)
        end
    end

    track.MouseButton1Click:Connect(function()
        setState(not isOn)
    end)

    track.MouseEnter:Connect(function()
        tween(track, {Size = UDim2.new(0, 56, 0, 28), Position = UDim2.new(1, -70, 0.5, -14)}, 0.12)
    end)
    track.MouseLeave:Connect(function()
        tween(track, {Size = UDim2.new(0, 52, 0, 28), Position = UDim2.new(1, -68, 0.5, -14)}, 0.12)
    end)

    setState(defaultOn, true)
    return setState, function() return isOn end
end

