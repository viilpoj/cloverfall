    -- Detecta a picareta nas ferramentas equipadas ou nos slots da mochila,
    -- seguindo o mesmo padrão usado pelo Auto Fish para encontrar a vara.
    local function getMiningTool()
        local character = player.Character
        local backpack = player:FindFirstChildOfClass("Backpack")

        local function matches(tool)
            if not tool or not tool:IsA("Tool") then return false end
            local n = string.lower(tostring(tool.Name or ""))
            n = n:gsub("[_%-%.]+", " "):gsub("%s+", " ")
            return n:find("pickaxe", 1, true) ~= nil
                or n:find("pick axe", 1, true) ~= nil
                or n:find("pick", 1, true) ~= nil
                or n:find("mining tool", 1, true) ~= nil
                or n:find("drill", 1, true) ~= nil
        end

        if character then
            for _, item in ipairs(character:GetChildren()) do
                if matches(item) then return item, true end
            end
        end
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if matches(item) then return item, false end
            end
        end
        return nil, false
    end

    local function ensureMiningToolEquipped()
        local tool, equipped = getMiningTool()
        if not tool then return false end
        if equipped then return true end

        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return false end

        pcall(function() humanoid:EquipTool(tool) end)
        task.wait(0.15)
        local equippedTool, isEquipped = getMiningTool()
        return equippedTool ~= nil and isEquipped
    end

