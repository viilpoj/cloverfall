--// ==========================================
--// PERFORMANCE VFX — SIMPLIFICAÇÃO LOCAL DE EFEITOS
--// Observação: Roblox não expõe uma propriedade para reduzir a resolução
--// nativa de uma textura para 144p. Esta opção reduz densidade, tamanho e
--// duração de efeitos comuns, mantendo as texturas originais.
--// ==========================================
local setPerformanceVFX, getPerformanceVFX
local PerformanceVFXState = {
    Active = false,
    Token = 0,
    Connection = nil,
    Original = setmetatable({}, { __mode = "k" }),
}

local function scaleVFXNumberSequence(sequence, factor)
    local keypoints = sequence.Keypoints
    local scaled = table.create(#keypoints)
    for i, keypoint in ipairs(keypoints) do
        scaled[i] = NumberSequenceKeypoint.new(
            keypoint.Time,
            keypoint.Value * factor,
            keypoint.Envelope * factor
        )
    end
    return NumberSequence.new(scaled)
end

local function softenVFXTransparency(sequence, visibleFactor)
    local keypoints = sequence.Keypoints
    local softened = table.create(#keypoints)
    for i, keypoint in ipairs(keypoints) do
        local newValue = 1 - (1 - keypoint.Value) * visibleFactor
        softened[i] = NumberSequenceKeypoint.new(
            keypoint.Time,
            math.clamp(newValue, 0, 1),
            keypoint.Envelope * visibleFactor
        )
    end
    return NumberSequence.new(softened)
end

local function simplifyVFXObject(obj)
    if not PerformanceVFXState.Active or not obj or not obj.Parent then return end
    if PerformanceVFXState.Original[obj] then return end

    local ok, className = pcall(function() return obj.ClassName end)
    if not ok then return end

    local saved = { ClassName = className }
    local recognized = false

    if obj:IsA("ParticleEmitter") then
        saved.Rate = obj.Rate
        saved.Lifetime = obj.Lifetime
        saved.Size = obj.Size
        saved.LightEmission = obj.LightEmission
        recognized = true
    elseif obj:IsA("Beam") then
        saved.Width0 = obj.Width0
        saved.Width1 = obj.Width1
        saved.Transparency = obj.Transparency
        recognized = true
    elseif obj:IsA("Trail") then
        saved.Lifetime = obj.Lifetime
        saved.WidthScale = obj.WidthScale
        saved.Transparency = obj.Transparency
        recognized = true
    elseif obj:IsA("Fire") then
        saved.Size = obj.Size
        saved.Heat = obj.Heat
        recognized = true
    elseif obj:IsA("Smoke") then
        saved.Size = obj.Size
        saved.Opacity = obj.Opacity
        saved.RiseVelocity = obj.RiseVelocity
        recognized = true
    end

    if not recognized then return end
    PerformanceVFXState.Original[obj] = saved

    pcall(function()
        if obj:IsA("ParticleEmitter") then
            -- Reduz bastante a quantidade de partículas e encurta sua presença.
            if saved.Rate > 0 then
                obj.Rate = math.max(0.1, math.min(saved.Rate * 0.18, 10))
            end
            obj.Lifetime = NumberRange.new(
                math.max(0.05, saved.Lifetime.Min * 0.65),
                math.max(0.05, saved.Lifetime.Max * 0.65)
            )
            obj.Size = scaleVFXNumberSequence(saved.Size, 0.72)
            obj.LightEmission = saved.LightEmission * 0.55
        elseif obj:IsA("Beam") then
            obj.Width0 = saved.Width0 * 0.72
            obj.Width1 = saved.Width1 * 0.72
            obj.Transparency = softenVFXTransparency(saved.Transparency, 0.62)
        elseif obj:IsA("Trail") then
            obj.Lifetime = math.max(0.05, saved.Lifetime * 0.55)
            obj.WidthScale = scaleVFXNumberSequence(saved.WidthScale, 0.72)
            obj.Transparency = softenVFXTransparency(saved.Transparency, 0.62)
        elseif obj:IsA("Fire") then
            obj.Size = saved.Size * 0.7
            obj.Heat = saved.Heat * 0.7
        elseif obj:IsA("Smoke") then
            obj.Size = saved.Size * 0.7
            obj.Opacity = saved.Opacity * 0.7
            obj.RiseVelocity = saved.RiseVelocity * 0.7
        end
    end)
end

local function restorePerformanceVFX()
    PerformanceVFXState.Active = false
    PerformanceVFXState.Token = PerformanceVFXState.Token + 1
    if PerformanceVFXState.Connection then
        PerformanceVFXState.Connection:Disconnect()
        PerformanceVFXState.Connection = nil
    end

    for obj, saved in pairs(PerformanceVFXState.Original) do
        pcall(function()
            if obj and obj.Parent then
                if saved.ClassName == "ParticleEmitter" then
                    obj.Rate = saved.Rate
                    obj.Lifetime = saved.Lifetime
                    obj.Size = saved.Size
                    obj.LightEmission = saved.LightEmission
                elseif saved.ClassName == "Beam" then
                    obj.Width0 = saved.Width0
                    obj.Width1 = saved.Width1
                    obj.Transparency = saved.Transparency
                elseif saved.ClassName == "Trail" then
                    obj.Lifetime = saved.Lifetime
                    obj.WidthScale = saved.WidthScale
                    obj.Transparency = saved.Transparency
                elseif saved.ClassName == "Fire" then
                    obj.Size = saved.Size
                    obj.Heat = saved.Heat
                elseif saved.ClassName == "Smoke" then
                    obj.Size = saved.Size
                    obj.Opacity = saved.Opacity
                    obj.RiseVelocity = saved.RiseVelocity
                end
            end
        end)
        PerformanceVFXState.Original[obj] = nil
    end
end

local function setPerformanceVFXActive(state)
    if state then
        if PerformanceVFXState.Active then return end
        PerformanceVFXState.Active = true
        PerformanceVFXState.Token = PerformanceVFXState.Token + 1
        local token = PerformanceVFXState.Token

        PerformanceVFXState.Connection = workspace.DescendantAdded:Connect(function(obj)
            task.defer(function()
                if PerformanceVFXState.Active and PerformanceVFXState.Token == token
                    and obj and obj.Parent then
                    simplifyVFXObject(obj)
                end
            end)
        end)

        task.spawn(function()
            for index, obj in ipairs(workspace:GetDescendants()) do
                if not PerformanceVFXState.Active or PerformanceVFXState.Token ~= token then
                    break
                end
                simplifyVFXObject(obj)
                if index % 400 == 0 then task.wait() end
            end
        end)
    else
        restorePerformanceVFX()
    end
end

