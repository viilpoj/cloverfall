    local function knownOreTypeFromText(text)
        local s = normalizeName(text)
        for _, entry in ipairs(KNOWN_ORE_TYPES) do
            for _, alias in ipairs(entry.Names) do
                local a = normalizeName(alias)
                if s == a or s:find(" " .. a .. " ", 1, true)
                    or s:sub(1, #a + 1) == a .. " "
                    or s:sub(-#a - 1) == " " .. a then
                    return entry.Label
                end
            end
        end
        return nil
    end

    local function genericOreTypeFromText(text, fallback)
        local s = normalizeName(text)
        local cleaned = s
        for _, pattern in ipairs({
            "%f[%a]ores?%f[%A]", "crystals?", "cristais?", "%f[%a]gems?%f[%A]",
            "gemstone", "minerals?", "geodes?", "veins?", "deposits?", "nodes?",
            "fragments?", "shards?", "chunks?", "large", "small", "ancient", "rich",
        }) do
            cleaned = cleaned:gsub(pattern, " ")
        end
        cleaned = cleaned:gsub("%d+", " "):gsub("[%p_]+", " "):gsub("%s+", " ")
        cleaned = cleaned:match("^%s*(.-)%s*$") or ""
        if cleaned ~= "" then return titleCase(cleaned) end
        return fallback or "Other Ores"
    end

    local function attributesSuggestOre(inst)
        if not inst then return false end
        local ok, attrs = pcall(function() return inst:GetAttributes() end)
        if not ok or type(attrs) ~= "table" then return false end

        for key, value in pairs(attrs) do
            local k = normalizeName(key)
            local compactKey = k:gsub("%s+", "")
            local keyNamesOre = k:find("ore", 1, true)
                or k:find("mineral", 1, true)
                or k:find("crystal", 1, true)
                or k:find("gem", 1, true)

            if keyNamesOre then
                if value == true then return true end
                if type(value) == "string" and value ~= "" then
                    if knownOreTypeFromText(value)
                        or matchesAny(normalizeName(value), RESOURCE_CONTEXT_PATTERNS) then
                        return true
                    end
                end
            elseif (compactKey == "resourcetype" or compactKey == "nodetype"
                or compactKey == "materialtype") and type(value) == "string" then
                if knownOreTypeFromText(value)
                    or matchesAny(normalizeName(value), RESOURCE_CONTEXT_PATTERNS) then
                    return true
                end
            elseif (compactKey == "ismineable" or compactKey == "mineable")
                and value == true then
                local named = normalizeName(inst.Name)
                if matchesAny(named, RESOURCE_CONTEXT_PATTERNS)
                    or knownOreTypeFromText(named) then
                    return true
                end
            end
        end
        return false
    end

    local function nameKind(name)
        local cached = nameKindCache[name]
        if cached ~= nil then return cached end

        local s = normalizeName(name)
        local kind = false
        local isBlockedName = false
        for _, w in ipairs(BLOCKED_WORDS) do
            if s:find(w, 1, true) then
                isBlockedName = true
                break
            end
        end

        if not isBlockedName then
            local known = knownOreTypeFromText(s)
            local hasResourceContext = matchesAny(s, RESOURCE_CONTEXT_PATTERNS)
            local bareKnownType = known ~= nil and s == string.lower(known)
            local knownTypeWithResourceSuffix = known ~= nil and matchesAny(s, {
                "veins?", "deposits?", "nodes?", "fragments?", "shards?", "chunks?", "clusters?",
            })
            if matchesAny(s, ORE_PATTERNS) or hasResourceContext
                or bareKnownType or knownTypeWithResourceSuffix then
                kind = "ore"
            end
        end

        nameKindCache[name] = kind
        return kind
    end

    local function isOreItemName(name, allowBareType)
        local normalized = normalizeName(name)
        normalized = normalized:gsub("%s*[xX]%s*%d+%s*$", "")
            :gsub("%s*%(%d+%)%s*$", "")
            :gsub("^%d+%s*[xX]%s*", "")
            :match("^%s*(.-)%s*$") or normalized
        local known = knownOreTypeFromText(normalized)
        if known and normalized == string.lower(known) and not allowBareType then
            return false
        end
        return nameKind(normalized) ~= false
    end
    local CRYSTAL_MATERIALS = {
        [Enum.Material.Neon] = true,
        [Enum.Material.Glass] = true,
        [Enum.Material.Ice] = true,
    }

    local function looksLikeCrystal(part)
        if not CRYSTAL_MATERIALS[part.Material] then return false end
        local s = part.Size
        local m = math.max(s.X, s.Y, s.Z)
        if m < MINER_CFG.CrystalMinSize or m > MINER_CFG.CrystalMaxSize then return false end
        return part:IsA("MeshPart") or part:IsA("WedgePart") or part:IsA("CornerWedgePart")
            or part:FindFirstChildOfClass("SpecialMesh") ~= nil
    end

    local function isContainer(inst)
        if inst:IsA("Folder") then return true end
        if inst:IsA("Model") then
            for _, c in ipairs(inst:GetChildren()) do
                if c:IsA("Model") then return true end
            end
        end
        return false
    end

    local function getOreType(inst, kind)
        if not inst then return "Other Ores" end
        local names = {}
        local cur = inst
        local depth = 0
        while cur and cur ~= workspace and depth < 5 do
            table.insert(names, cur.Name)
            cur = cur.Parent
            depth = depth + 1
        end

        for _, name in ipairs(names) do
            local known = knownOreTypeFromText(name)
            if known then return known end
        end

        cur = inst
        depth = 0
        while cur and cur ~= workspace and depth < 4 do
            local ok, attrs = pcall(function() return cur:GetAttributes() end)
            if ok and type(attrs) == "table" then
                for key, value in pairs(attrs) do
                    local k = normalizeName(key)
                    local compactKey = k:gsub("%s+", "")
                    local relevant = k:find("ore", 1, true) or k:find("resource", 1, true)
                        or k:find("mineral", 1, true) or k:find("crystal", 1, true)
                        or k:find("mineable", 1, true) or k:find("mining", 1, true)
                        or compactKey == "resourcetype" or compactKey == "nodetype" or compactKey == "materialtype"
                    if relevant and type(value) == "string" and value ~= "" then
                        local known = knownOreTypeFromText(value)
                        if known then return known end
                        if matchesAny(normalizeName(value), RESOURCE_CONTEXT_PATTERNS) then
                            return genericOreTypeFromText(value, "Other Ores")
                        end
                        if relevant and (compactKey ~= "materialtype" or kind == "ore" or (kind and kind:find("ore", 1, true))) then
                            return titleCase(value)
                        end
                    end
                end
            end
            cur = cur.Parent
            depth = depth + 1
        end

        for _, name in ipairs(names) do
            local normalized = normalizeName(name)
            if matchesAny(normalized, ORE_PATTERNS) or matchesAny(normalized, RESOURCE_CONTEXT_PATTERNS) then
                return genericOreTypeFromText(name, (kind and kind:find("crystal", 1, true)) and "Other Crystals" or "Other Ores")
            end
        end
        if kind and kind:find("crystal", 1, true) then return "Other Crystals" end
        if kind == "aparencia" then return "Other Crystals" end
        return "Other Ores"
    end

    local function isPillarStructure(inst)
        local cur = inst
        local depth = 0
        while cur and cur ~= workspace and depth < 7 do
            local normalized = normalizeName(cur.Name)
            if matchesAny(normalized, PILLAR_PATTERNS) then
                return true
            end

            local ok, attrs = pcall(function() return cur:GetAttributes() end)
            if ok and type(attrs) == "table" then
                for key, value in pairs(attrs) do
                    local compactKey = normalizeName(key):gsub("%s+", "")
                    if value == true and (compactKey == "ispillar" or compactKey == "iscolumn"
                        or compactKey == "isstructuralpillar") then
                        return true
                    end
                    if type(value) == "string" and (compactKey == "structuretype"
                        or compactKey == "objecttype" or compactKey == "parttype" or compactKey == "type")
                        and matchesAny(normalizeName(value), PILLAR_PATTERNS) then
                        return true
                    end
                end
            end
            cur = cur.Parent
            depth = depth + 1
        end
        return false
    end

    local function classify(d)
        local isModel = d:IsA("Model")
        local isPart = (not isModel) and d:IsA("BasePart") and not d:IsA("Terrain")
        if not (isModel or isPart) then return nil end
        if isPillarStructure(d) then return nil end

        local normalizedName = normalizeName(d.Name)
        for _, blockedWord in ipairs(BLOCKED_WORDS) do
            if normalizedName:find(blockedWord, 1, true) then
                return nil
            end
        end

        local ancestor = d.Parent
        local ancestorDepth = 0
        while ancestor and ancestor ~= workspace and ancestorDepth < 6 do
            local ancestorName = normalizeName(ancestor.Name)
            for _, blockedWord in ipairs(BLOCKED_WORDS) do
                if ancestorName:find(blockedWord, 1, true) then
                    return nil
                end
            end
            if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
                return nil
            end
            ancestor = ancestor.Parent
            ancestorDepth = ancestorDepth + 1
        end

        local kind = nameKind(d.Name)
        if not kind and attributesSuggestOre(d) then kind = "ore" end

        if not kind then
            local parent = d.Parent
            if parent and parent ~= workspace then
                local pk = nameKind(parent.Name)
                if not pk and attributesSuggestOre(parent) then pk = "ore" end
                if pk == "ore" and isContainer(parent) then
                    kind = "pasta:ore"
                end
            end
        end

        if not kind then return nil end
        if isModel and isContainer(d) then return nil end
        if livingAncestor(d) then return nil end
        if d:FindFirstAncestorOfClass("Tool") then return nil end
        return kind
    end

    local function rebuildCandidateCache(token)
        local found, set = {}, {}
        local stack = { workspace }
        local visited = 0
        local yieldEvery = math.max(100, tonumber(MINER_CFG.CandidateScanYieldEvery) or 250)

        while #stack > 0 do
            if token and not isActive(token) then
                return false
            end

            local current = table.remove(stack)
            if current ~= workspace then
                local kind = classify(current)
                if kind then
                    table.insert(found, {
                        Inst = current,
                        Kind = kind,
                        OreType = getOreType(current, kind),
                    })
                    set[current] = true
                end
            end

            local okChildren, children = pcall(function()
                return current:GetChildren()
            end)
            if okChildren and children then
                for _, child in ipairs(children) do
                    table.insert(stack, child)
                end
            end

            visited = visited + 1
            if visited % yieldEvery == 0 then
                task.wait()
            end
        end

        local roots = {}
        for _, c in ipairs(found) do
            local nested = false
            local anc = c.Inst.Parent
            while anc and anc ~= workspace do
                if set[anc] then
                    nested = true
                    break
                end
                anc = anc.Parent
            end
            if not nested then
                table.insert(roots, c)
            end
        end

        candidateCache = roots
        candidateCacheAt = os.clock()
        return true
    end

    local function getCandidatePosition(inst)
        if not inst or not inst.Parent then return nil end
        local ok, pos = pcall(function()
            if inst:IsA("BasePart") then
                return inst.Position
            end
            return inst:GetBoundingBox().Position
        end)
        if ok and pos then return pos end
        ok, pos = pcall(function() return inst:GetPivot().Position end)
        if ok then return pos end
        return nil
    end

    local function collectCandidates(root, token)
        if not candidateCache or (os.clock() - candidateCacheAt) >= MINER_CFG.CandidateCacheSeconds then
            if not rebuildCandidateCache(token) then
                return {}
            end
        end

        local rp = root.Position
        local radius = MINER_CFG.SearchRadius
        local list = {}
        for _, cached in ipairs(candidateCache or {}) do
            local inst = cached.Inst
            if inst and inst.Parent then
                local okInWorkspace, inWorkspace = pcall(function()
                    return inst:IsDescendantOf(workspace)
                end)
                if okInWorkspace and inWorkspace then
                    local pivot = getCandidatePosition(inst)
                    if pivot then
                        local dist = (pivot - rp).Magnitude
                        if dist <= radius then
                            table.insert(list, {
                                Inst = inst,
                                Pos = pivot,
                                Dist = dist,
                                Kind = cached.Kind,
                                OreType = cached.OreType,
                            })
                        end
                    end
                end
            end
        end

        table.sort(list, function(a, b) return a.Dist < b.Dist end)
        return list
    end

    local function getBox(inst)
        if inst:IsA("BasePart") then
            return inst.CFrame, inst.Size
        end
        local ok, cf, size = pcall(function() return inst:GetBoundingBox() end)
        if ok and cf and size then
            return cf, size
        end
        return nil
    end

    local function collectParts(inst)
        if inst:IsA("BasePart") then
            return { inst }
        end
        local parts = {}
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("BasePart") then
                table.insert(parts, d)
                if #parts >= 60 then break end
            end
        end
        return parts
    end

    local function isNormallyOriented(inst, boxCf)
        if not MINER_CFG.RequireUprightOres then
            return true
        end
        if not inst or not inst.Parent then
            return false
        end

        if not boxCf then
            boxCf = select(1, getBox(inst))
        end
        if not boxCf then
            return false
        end

        local worldUp = Vector3.new(0, 1, 0)
        local upDot = boxCf.UpVector:Dot(worldUp)
        return upDot >= (tonumber(MINER_CFG.MinOreUpDot) or 0.75)
    end

    local function getVisualSignature(inst)
        if not inst or not inst.Parent then return nil end
        local _, boundsSize = getBox(inst)
        if not boundsSize then return nil end

        local parts = collectParts(inst)
        local visibleCount, volumeSum, linearSizeSum = 0, 0, 0
        for _, part in ipairs(parts) do
            if part.Parent and part.Transparency < 0.98 then
                visibleCount = visibleCount + 1
                local size = part.Size
                volumeSum = volumeSum + math.max(0.001, size.X * size.Y * size.Z)
                linearSizeSum = linearSizeSum + size.Magnitude
            end
        end

        return {
            BoundsSize = boundsSize,
            PartCount = #parts,
            VisibleCount = visibleCount,
            Volume = volumeSum,
            LinearSize = linearSizeSum,
        }
    end

    local function visualSizeDecreased(before, after)
        if not before or not after then return false end
        if after.PartCount < before.PartCount or after.VisibleCount < before.VisibleCount then
            return true
        end

        if before.Volume > 0 and after.Volume < before.Volume * 0.98 then
            return true
        end
        if before.LinearSize > 0
            and after.LinearSize < before.LinearSize - math.max(0.05, before.LinearSize * 0.02) then
            return true
        end

        local oldSize, newSize = before.BoundsSize, after.BoundsSize
        local axes = {
            { oldSize.X, newSize.X },
            { oldSize.Y, newSize.Y },
            { oldSize.Z, newSize.Z },
        }
        for _, pair in ipairs(axes) do
            local oldValue, newValue = pair[1], pair[2]
            if oldValue - newValue >= math.max(0.05, oldValue * 0.025) then
                return true
            end
        end
        return false
    end

    local function isHealthLikeKey(key)
        local compact = normalizeName(key):gsub("%s+", "")
        return compact:find("health", 1, true) ~= nil
            or compact == "hp" or compact:find("hitpoints", 1, true) ~= nil
            or compact:find("durability", 1, true) ~= nil
            or compact:find("integrity", 1, true) ~= nil
            or compact:find("hitsremaining", 1, true) ~= nil
            or compact:find("remaininghits", 1, true) ~= nil
    end

    local function getOreHealthSignature(inst)
        local values = {}
        if not inst then return values end
        local objects = { inst }
        local ok, descendants = pcall(function() return inst:GetDescendants() end)
        if ok and descendants then
            for index, descendant in ipairs(descendants) do
                if index > 120 then break end
                table.insert(objects, descendant)
            end
        end

        for _, obj in ipairs(objects) do
            local okAttrs, attrs = pcall(function() return obj:GetAttributes() end)
            if okAttrs and type(attrs) == "table" then
                for key, value in pairs(attrs) do
                    if isHealthLikeKey(key) and type(value) == "number" then
                        values[obj:GetFullName() .. "::attr::" .. normalizeName(key)] = value
                    end
                end
            end
            if (obj:IsA("IntValue") or obj:IsA("NumberValue")) and isHealthLikeKey(obj.Name) then
                values[obj:GetFullName() .. "::value"] = obj.Value
            end
        end
        return values
    end

    local function oreHealthDecreased(before, after)
        if type(before) ~= "table" or type(after) ~= "table" then return false end
        for key, oldValue in pairs(before) do
            local newValue = after[key]
            if type(newValue) == "number" and newValue < oldValue - 0.001 then
                return true
            end
        end
        return false
    end

    local function castRay(origin, direction, ignoreList)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        pcall(function() params.RespectCanCollide = true end)

        local ignore = {}
        for i, v in ipairs(ignoreList) do
            ignore[i] = v
        end

        for _ = 1, 5 do
            params.FilterDescendantsInstances = ignore
            local res = workspace:Raycast(origin, direction, params)
            if not res then return nil end
            local living = livingAncestor(res.Instance)
            if not living then return res end
            table.insert(ignore, living)
        end
        return nil
    end

    local function checkGround(inst, mn, mx, center)
        local ignore = { inst }
        local char = player.Character
        if char then table.insert(ignore, char) end

        local startY = mx.Y + 0.75
        local length = (mx.Y - mn.Y) + 400
        local dx = math.clamp((mx.X - mn.X) * 0.35, 0, 3)
        local dz = math.clamp((mx.Z - mn.Z) * 0.35, 0, 3)
        local offsets = {
            Vector3.new(0, 0, 0),
            Vector3.new(dx, 0, 0),
            Vector3.new(-dx, 0, 0),
            Vector3.new(0, 0, dz),
            Vector3.new(0, 0, -dz),
        }

        local okCount, centerOk, groundPos = 0, false, nil
        local supports = {}

        for i, o in ipairs(offsets) do
            local res = castRay(
                Vector3.new(center.X + o.X, startY, center.Z + o.Z),
                Vector3.new(0, -length, 0),
                ignore
            )
            if res then
                local gap = mn.Y - res.Position.Y
                local good = res.Normal.Y >= MINER_CFG.MinGroundNormalY
                    and res.Position.Y <= mx.Y + 0.1
                    and gap <= MINER_CFG.GroundGapMax
                if good then
                    okCount = okCount + 1
                    supports[res.Instance] = true
                end
                if i == 1 then
                    centerOk = good
                    groundPos = res.Position
                end
            end
        end

        if not (centerOk and okCount >= 3) then
            return false
        end
        return true, groundPos, supports
    end

    local function findGroundBelow(inst, center, ext, fromPosition)
        local char = player.Character
        local reference = fromPosition or center
        local startY = math.min(center.Y + 1, reference.Y + 6)
        local offset = math.clamp(math.max(ext.X, ext.Z) * 0.5 + 2, 2, 10)
        local offsets = {
            Vector3.new(0, 0, 0),
            Vector3.new(offset, 0, 0),
            Vector3.new(-offset, 0, 0),
            Vector3.new(0, 0, offset),
            Vector3.new(0, 0, -offset),
        }

        local bestPosition, bestScore = nil, math.huge
        for _, o in ipairs(offsets) do
            local ignore = { inst }
            if char then table.insert(ignore, char) end
            local origin = Vector3.new(center.X + o.X, startY, center.Z + o.Z)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = ignore
            params.IgnoreWater = true
            pcall(function() params.RespectCanCollide = true end)

            for _ = 1, 4 do
                params.FilterDescendantsInstances = ignore
                local okRay, hit = pcall(function()
                    return workspace:Raycast(origin, Vector3.new(0, -600, 0), params)
                end)
                if not okRay or not hit then break end

                if hit.Normal.Y >= 0.45 then
                    local pos = hit.Position
                    local score = (pos - reference).Magnitude + horizontal(pos, center) * 0.2
                    if score < bestScore then
                        bestScore, bestPosition = score, pos
                    end
                    break
                end

                if hit.Instance == workspace.Terrain then break end
                table.insert(ignore, hit.Instance)
            end
        end
        return bestPosition
    end

    local function evaluate(inst)
        local cf, size = getBox(inst)
        if not cf then return nil, "sem-caixa" end
        if not isNormallyOriented(inst, cf) then
            return nil, "ore-de-lado-ou-invertido"
        end

        local mn, mx = worldBounds(cf, size)
        local ext = mx - mn
        local biggest = math.max(ext.X, ext.Y, ext.Z)
        if biggest < 0.2 then return nil, "vazio" end
        if biggest > MINER_CFG.MaxOreSize then return nil, "grande-demais" end

        local center = (mn + mx) / 2
        local _, _, playerRoot = getChar()
        local reference = playerRoot and playerRoot.Position or center

        local good, groundPos = checkGround(inst, mn, mx, center)
        if not good then
            groundPos = findGroundBelow(inst, center, ext, reference)
        end
        if not groundPos then
            groundPos = Vector3.new(center.X, reference.Y, center.Z)
        end

        local parts = collectParts(inst)
        local visibleCount = 0
        local initialTransparency = {}
        for _, p in ipairs(parts) do
            initialTransparency[p] = p.Transparency
            if p.Transparency < 0.98 then
                visibleCount = visibleCount + 1
            end
        end

        return {
            Inst = inst,
            Name = inst.Name,
            OreType = getOreType(inst, nameKind(inst.Name)),
            Center = center,
            Top = mx.Y,
            Bottom = mn.Y,
            Radius = math.clamp(math.max(ext.X, ext.Z) / 2, 1, 8),
            InitialSize = ext,
            InitialPartCount = #parts,
            InitialVisibleCount = visibleCount,
            InitialTransparency = initialTransparency,
            GroundPos = groundPos,
            Parts = parts,
            WasVisible = visibleCount > 0,
            StandPoint = nil,
            Waypoints = nil,
        }
    end

    local function computeStandPoint(info, from, angle)
        local flat = Vector3.new(from.X - info.Center.X, 0, from.Z - info.Center.Z)
        local dir
        if angle ~= nil then
            dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
        else
            dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(1, 0, 0)
        end

        local offset = (info.Radius or 1) + MINER_CFG.MineDistance * 0.5
        local px = info.Center.X + dir.X * offset
        local pz = info.Center.Z + dir.Z * offset
        local groundY = info.GroundPos and info.GroundPos.Y or from.Y

        local ignore = { info.Inst }
        if player.Character then table.insert(ignore, player.Character) end
        local res = castRay(
            Vector3.new(px, groundY + 8, pz),
            Vector3.new(0, -80, 0),
            ignore
        )
        if res and res.Normal.Y >= 0.45 then
            return res.Position
        end

        return Vector3.new(px, groundY, pz)
    end

    local function computePath(fromPos, toPos)
        if not MINER_CFG.UsePathfinding then
            return true, nil
        end

        local profiles = {
            { AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 4 },
            { AgentRadius = 1, AgentHeight = 4, AgentCanJump = true, WaypointSpacing = 3 },
        }

        for _, profile in ipairs(profiles) do
            local okCreate, path = pcall(function()
                return PathfindingService:CreatePath(profile)
            end)
            if okCreate and path then
                local okCompute = pcall(function()
                    path:ComputeAsync(fromPos, toPos)
                end)
                if okCompute and path.Status == Enum.PathStatus.Success then
                    local okWaypoints, wps = pcall(function()
                        return path:GetWaypoints()
                    end)
                    if okWaypoints and wps and #wps > 0 then
                        return true, wps
                    end
                end
            end
        end

        return false, nil
    end

    local function checkReachable(info, root, forceAlternate)
        local dx = root.Position.X - info.Center.X
        local dz = root.Position.Z - info.Center.Z
        local baseAngle = (math.abs(dx) + math.abs(dz) > 0.1) and math.atan2(dz, dx) or 0
        local order = forceAlternate and { 1, 2, 3, 4, 5, 6, 7, 0 }
            or { 0, 1, 2, 3, 4, 5, 6, 7 }

        for _, offsetIndex in ipairs(order) do
            local angle = baseAngle + offsetIndex * (math.pi / 4)
            local stand = computeStandPoint(info, root.Position, angle)
            if stand then
                local ok, wps = computePath(root.Position, stand)
                if ok then
                    if wps then
                        local last = wps[#wps].Position
                        if horizontal(last, stand) > 8 or math.abs(last.Y - stand.Y) > 8 then
                            info.Waypoints = nil
                        else
                            info.StandPoint = stand
                            info.Waypoints = wps
                            return true
                        end
                    else
                        info.StandPoint = stand
                        info.Waypoints = nil
                        return true
                    end
                end
            end
        end

        info.Waypoints = nil
        return false
    end

    local function blockSpot(pos, secs)
        table.insert(blocked, { Pos = pos, Until = os.clock() + secs })
    end

    local function isBlocked(pos, now)
        for i = #blocked, 1, -1 do
            local b = blocked[i]
            if b.Until <= now then
                table.remove(blocked, i)
            elseif (b.Pos - pos).Magnitude <= MINER_CFG.BlockRadius then
                return true
            end
        end
        return false
    end

    local function pickTarget(root, token)
        local now = os.clock()
        local cands = collectCandidates(root, token)
        local stats = { Total = #cands, Ground = 0, Rejected = 0, Blocked = 0, PathTries = 0 }

        for _, c in ipairs(cands) do
            if not isActive(token) then return nil, stats end

            local inst = c.Inst
            local untilT = rejected[inst]
            if untilT and untilT > now then
                stats.Rejected = stats.Rejected + 1
            elseif isBlocked(c.Pos, now) then
                stats.Blocked = stats.Blocked + 1
            elseif inst.Parent then
                local info, reason = evaluate(inst)
                if not info then
                    local rejectFor = reason == "ore-de-lado-ou-invertido"
                        and MINER_CFG.OrientationIgnoreTime or MINER_CFG.RejectCacheTime
                    rejected[inst] = now + rejectFor
                    stats.Rejected = stats.Rejected + 1
                    dbg(inst:GetFullName(), "[" .. tostring(c.Kind) .. "] descartado:", reason)
                else
                    info.OreType = c.OreType or getOreType(inst, c.Kind)
                    stats.Ground = stats.Ground + 1
                    stats.PathTries = stats.PathTries + 1
                    if checkReachable(info, root) then
                        dbg(inst:GetFullName(), "[" .. tostring(c.Kind) .. "] alvo mais próximo aceito")
                        return info, stats
                    else
                        rejected[inst] = now + MINER_CFG.IgnoreTime
                        stats.Rejected = stats.Rejected + 1
                        dbg(inst:GetFullName(), "sem rota acessível; tentando outro ore")
                    end
                    if stats.PathTries >= MINER_CFG.MaxPathChecks then
                        break
                    end
                end
            end
        end

        return nil, stats
    end

    local function hasDepletedFlag(inst)
        if not inst then return false end
        local objects = { inst }
        for _, d in ipairs(inst:GetDescendants()) do
            table.insert(objects, d)
            if #objects >= 80 then break end
        end

        local depletedNames = {
            destroyed = true, isdestroyed = true, collected = true, iscollected = true,
            mined = true, ismined = true, depleted = true, isdepleted = true,
            broken = true, isbroken = true,
        }
        for _, obj in ipairs(objects) do
            local ok, attrs = pcall(function() return obj:GetAttributes() end)
            if ok and type(attrs) == "table" then
                for key, value in pairs(attrs) do
                    local compactKey = normalizeName(key):gsub("%s+", "")
                    if depletedNames[compactKey] and value == true then
                        return true
                    end
                    if (compactKey == "health" or compactKey == "hp" or compactKey == "hitpoints"
                        or compactKey == "durability") and type(value) == "number" and value <= 0 then
                        return true
                    end
                end
            end

            local compactName = normalizeName(obj.Name):gsub("%s+", "")
            if obj:IsA("BoolValue") and depletedNames[compactName] and obj.Value then
                return true
            end
            if (obj:IsA("IntValue") or obj:IsA("NumberValue"))
                and (compactName == "health" or compactName == "hp" or compactName == "hitpoints"
                    or compactName == "durability") and obj.Value <= 0 then
                return true
            end
        end
        return false
    end

    local function oreGone(info)
        local inst = info.Inst
        if not inst or not inst.Parent or not inst:IsDescendantOf(workspace) then
            return true, "sumiu"
        end

        if hasDepletedFlag(inst) then
            return true, "estado destruído confirmado"
        end

        local currentParts = collectParts(inst)
        local currentCount, visibleCount = 0, 0
        for _, part in ipairs(currentParts) do
            if part.Parent and (part == inst or part:IsDescendantOf(inst)) then
                currentCount = currentCount + 1
                if part.Transparency < 0.98 then
                    visibleCount = visibleCount + 1
                end
            end
        end

        local initialCount = info.InitialPartCount or #(info.Parts or {})
        local initialVisible = info.InitialVisibleCount or (info.WasVisible and 1 or 0)
        if initialCount > 0 and currentCount == 0 then
            return true, "partes do cristal removidas"
        end

        if info.WasVisible and visibleCount == 0 then
            local originalPartsRemaining = 0
            for _, part in ipairs(info.Parts or {}) do
                if part.Parent and (part == inst or part:IsDescendantOf(inst)) then
                    originalPartsRemaining = originalPartsRemaining + 1
                end
            end

            local substantialRemoval = initialCount > 0
                and originalPartsRemaining <= math.max(0, math.floor(initialCount * 0.25))
            local now = os.clock()
            info.HiddenSince = info.HiddenSince or now
            local hiddenFor = now - info.HiddenSince
            if substantialRemoval and hiddenFor >= 0.9 then
                return true, "maioria das partes removida"
            end

            local hitCount = tonumber(info.ClickAttempts) or 0
            if info.MiningStarted == true
                and hitCount >= MINER_CFG.HiddenDestroyMinClicks
                and hiddenFor >= MINER_CFG.HiddenDestroyConfirmTime then
                return true, "cristal permaneceu invisível após vários golpes"
            end
        else
            info.HiddenSince = nil
        end

        if initialCount >= 3 and currentCount <= math.max(1, math.floor(initialCount * 0.2))
            and visibleCount <= math.max(1, math.floor((initialVisible or 1) * 0.2)) then
            info.BrokenShapeSince = info.BrokenShapeSince or os.clock()
            if os.clock() - info.BrokenShapeSince >= 0.6 then
                return true, "estrutura do cristal desmontada"
            end
        else
            info.BrokenShapeSince = nil
        end

        return false
    end

    local function stackCount(name)
        local n = name:match("[xX]%s*(%d+)%s*$") or name:match("%((%d+)%)%s*$") or name:match("^(%d+)%s*[xX]")
        return tonumber(n) or 1
    end

    local function baseName(name)
        local s = name:gsub("%s*[xX]%s*%d+%s*$", ""):gsub("%s*%(%d+%)%s*$", ""):gsub("^%d+%s*[xX]%s*", "")
        return string.lower(s)
    end

    local function snapshotInventory()
        local total, byName = 0, {}

        local function add(key, n)
            byName[key] = (byName[key] or 0) + n
            total = total + n
        end

        local function scanTools(container)
            if not container then return end
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("Tool") and isOreItemName(c.Name, true) then
                    add(baseName(c.Name), stackCount(c.Name))
                end
            end
        end

        scanTools(player:FindFirstChildOfClass("Backpack"))
        scanTools(player.Character)

        for _, child in ipairs(player:GetChildren()) do
            if child.Name ~= "PlayerGui" and child.Name ~= "PlayerScripts" and not child:IsA("Backpack") then
                for _, d in ipairs(child:GetDescendants()) do
                    if (d:IsA("IntValue") or d:IsA("NumberValue")) and isOreItemName(d.Name, false) then
                        add("valor:" .. d:GetFullName(), d.Value)
                    end
                end
            end
        end

        return { Total = total, ByName = byName }
    end

    local function hasWholePhrase(text, phrase)
        local haystack = " " .. normalizeName(text) .. " "
        local needle = " " .. normalizeName(phrase) .. " "
        return phrase ~= nil and phrase ~= "" and haystack:find(needle, 1, true) ~= nil
    end

    local function inventoryKeyMatchesTarget(key, info)
        local text = tostring(key or "")
        text = text:gsub("^valor:", "")
        local normalized = normalizeName(text)
        local targetType = normalizeName(info.OreType or "")
        local genericTarget = targetType == "other ores" or targetType == "other crystals"
            or targetType == "other ore" or targetType == ""

        if not genericTarget then
            local itemType = knownOreTypeFromText(normalized)
            if itemType and normalizeName(itemType) == targetType then
                return true
            end
            if hasWholePhrase(normalized, targetType) then
                return true
            end
        end

        local targetName = normalizeName(info.Name or "")
        if #targetName >= 4 and hasWholePhrase(normalized, targetName) then
            return true
        end
        local nameType = knownOreTypeFromText(targetName)
        local itemType = knownOreTypeFromText(normalized)
        if nameType and itemType == nameType then
            return true
        end
        return false
    end

    local function inventoryIncreased(before, after, info)
        local changedKeys = {}
        for k, v in pairs(after.ByName) do
            if v > (before.ByName[k] or 0) then
                table.insert(changedKeys, k)
                if inventoryKeyMatchesTarget(k, info) then
                    return true
                end
            end
        end

        local targetType = normalizeName(info.OreType or "")
        local genericTarget = targetType == "other ores" or targetType == "other crystals"
            or targetType == "other ore" or targetType == ""
        if genericTarget and #changedKeys == 1 then
            local changed = normalizeName(changedKeys[1]:gsub("^valor:", ""))
            if changed:find("ore", 1, true) or changed:find("crystal", 1, true)
                or changed:find("mineral", 1, true) or changed:find("gem", 1, true) then
                return true
            end
        end
        return false
    end

    local function onRenderStep()
        local t = aimTarget
        if not t then return end
        local cam = workspace.CurrentCamera
        if not cam then return end

        local cf = cam.CFrame
        local dir = t - cf.Position
        if dir.Magnitude < 0.5 then return end
        local unitDir = dir.Unit
        if cf.LookVector:Dot(unitDir) > 0.9995 then return end
        local up = math.abs(unitDir.Y) > 0.98 and Vector3.new(0, 0, -1) or Vector3.new(0, 1, 0)
        cam.CFrame = CFrame.lookAt(cf.Position, t, up)
    end

    local function faceTo(root, pos)
        local toTarget = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
        if toTarget.Magnitude < 0.1 then return end

        local look = root.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0.01 and flatLook.Unit:Dot(toTarget.Unit) > 0.99 then
            return
        end

        root.CFrame = CFrame.lookAt(root.Position, Vector3.new(pos.X, root.Position.Y, pos.Z))
    end

    local lastMinerObstacleRecoveryAt = -math.huge

    local function minerObstacleIdentity(part)
        if not part then return nil end
        return part:FindFirstAncestorOfClass("Model") or part
    end

    local function minerOreOrLivingAncestor(part, targetOre)
        if not part then return false, nil end
        if targetOre and (part == targetOre or part:IsDescendantOf(targetOre)
            or targetOre:IsDescendantOf(part)) then
            return true, targetOre
        end

        local cur = part
        local oreRoot = nil
        while cur and cur ~= workspace do
            if cur:IsA("Model") and cur:FindFirstChildOfClass("Humanoid") then
                return true, cur
            end
            local ok, kind = pcall(classify, cur)
            if ok and kind then oreRoot = cur end
            cur = cur.Parent
        end
        return oreRoot ~= nil, oreRoot
    end

    local function raycastMinerObstacle(origin, direction, targetOre)
        local filters = {}
        if player.Character then table.insert(filters, player.Character) end
        if targetOre then table.insert(filters, targetOre) end

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = filters
        params.IgnoreWater = true
        pcall(function() params.RespectCanCollide = true end)

        for _ = 1, 16 do
            local hit = workspace:Raycast(origin, direction * MINER_CFG.ObstacleRayDistance, params)
            if not hit then return nil end
            local part = hit.Instance
            if part == workspace.Terrain then
                return hit
            elseif part and part:IsA("BasePart") then
                local shouldIgnore, ignoreRoot = minerOreOrLivingAncestor(part, targetOre)
                if shouldIgnore or not part.CanCollide then
                    -- Ignora o minério-alvo, personagens e peças decorativas não sólidas,
                    -- mas continua o raio para encontrar uma parede logo atrás deles.
                    table.insert(filters, ignoreRoot or part)
                    params.FilterDescendantsInstances = filters
                else
                    -- Não exige que a parede esteja a 1 stud de distância: obstáculos
                    -- pequenos ou muito próximos também devem acionar a recuperação.
                    return hit
                end
            else
                return hit
            end
        end
        return nil
    end

    local function getBlockingMinerObstacle(root, direction, targetOre)
        if not (MINER_CFG.ObstacleRecoveryEnabled and root and direction) then return nil end
        local flat = Vector3.new(direction.X, 0, direction.Z)
        if flat.Magnitude < 0.1 then return nil end
        flat = flat.Unit
        local side = Vector3.new(-flat.Z, 0, flat.X)
        local lateralOffsets = { -MINER_CFG.ObstacleRayWidth, 0, MINER_CFG.ObstacleRayWidth }
        local heights = { 0.10, 0.25, 0.45, 0.70, 1.00, 1.40, 1.90, 2.40 }
        local counts, centerIdentity = {}, nil
        local _, hum = getChar()
        local groundOffset = (hum and hum.HipHeight or 2) + (root.Size.Y * 0.5)
        local nearGroundY = root.Position.Y - groundOffset + 0.08

        for heightIndex, height in ipairs(heights) do
            for lateralIndex, lateralOffset in ipairs(lateralOffsets) do
                local origin = Vector3.new(root.Position.X, nearGroundY + height, root.Position.Z)
                    + side * lateralOffset
                local hit = raycastMinerObstacle(origin, flat, targetOre)
                if hit then
                    local identity = minerObstacleIdentity(hit.Instance)
                    if identity then
                        counts[identity] = (counts[identity] or 0) + 1
                        -- Qualquer acerto no raio central, inclusive junto ao chão,
                        -- basta para reagir a uma barreira estreita/baixa.
                        if lateralIndex == 2 then
                            centerIdentity = identity
                        end
                    end
                end
            end
        end

        local best, bestCount = nil, 0
        for identity, count in pairs(counts) do
            if count > bestCount then best, bestCount = identity, count end
        end
        if best and bestCount >= 2 then return best end
        return centerIdentity
    end

    local function minerForwardFlat(root, direction)
        local flat = direction and Vector3.new(direction.X, 0, direction.Z)
        if not flat or flat.Magnitude < 0.05 then
            local look = root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
            flat = Vector3.new(look.X, 0, look.Z)
        end
        if flat.Magnitude < 0.05 then return Vector3.new(0, 0, -1) end
        return flat.Unit
    end

    local function releaseMinerSpace()
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
    end

    local function retreatMinerTwoStuds(hum, root, token, forwardDirection)
        if not (isActive(token) and hum and root and hum.Parent and root.Parent) then
            return false
        end
        local startPos = root.Position
        local backward = -minerForwardFlat(root, forwardDirection)
        local destination = startPos + backward * MINER_CFG.ObstacleRetreatDistance
        local moveTarget = destination + backward * 0.95
        local reached = false
        local connection = hum.MoveToFinished:Connect(function(success)
            if success then reached = true end
        end)
        pcall(function() hum:MoveTo(moveTarget) end)
        local deadline = os.clock() + MINER_CFG.ObstacleRetreatTimeout
        while isActive(token) and hum.Parent and root.Parent do
            local delta = root.Position - destination
            if Vector3.new(delta.X, 0, delta.Z).Magnitude <= 0.25 or reached
                or os.clock() >= deadline then
                break
            end
            task.wait(0.025)
        end
        pcall(function() hum:MoveTo(root.Position) end)
        if connection then connection:Disconnect() end
        return isActive(token)
    end

    local function performMinerObstacleRecovery(hum, root, forwardDirection, token, force)
        if not isActive(token)
            or (not force and os.clock() - lastMinerObstacleRecoveryAt < MINER_CFG.ObstacleRecoveryCooldown) then
            return false
        end
        if force then
            dbg("personagem preso; recuando 2 studs e iniciando 3 cliques de pulo")
        else
            dbg("obstáculo à frente; iniciando recuperação")
        end
        setMoving(false)
        pcall(function() hum:MoveTo(root.Position) end)
        releaseMinerSpace()

        if not retreatMinerTwoStuds(hum, root, token, forwardDirection) then
            lastMinerObstacleRecoveryAt = os.clock()
            releaseMinerSpace()
            setMoving(false)
            return false
        end

        for index = 1, MINER_CFG.ObstacleJumpCount do
            if not isActive(token) then
                releaseMinerSpace()
                setMoving(false)
                return false
            end
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            end)
            task.wait(MINER_CFG.ObstacleJumpPressDuration)
            releaseMinerSpace()
            if index < MINER_CFG.ObstacleJumpCount then
                task.wait(MINER_CFG.ObstacleJumpGap)
            end
        end
        releaseMinerSpace()

        if isActive(token) then
            -- Volta ao movimento normal do Auto Miner; não simula W+Shift extra.
            setMoving(true)
        end
        lastMinerObstacleRecoveryAt = os.clock()
        return isActive(token)
    end

    local function walkTo(info, token)
        local waypoints = info.Waypoints
        local idx = 1

        local t0 = os.clock()
        local _, _, root0 = getChar()
        local startDist = root0 and horizontal(root0.Position, info.Center) or 0
        local limit = math.max(MINER_CFG.WalkTimeoutMin, startDist / 6)

        local lastCheck = t0
        local lastPos = root0 and root0.Position or nil
        local lastTargetDistance = nil
        local stuck = 0
        local recoveryAttempts = 0
        local lastTargetRefresh = t0
        local plannedCenter = info.Center
        local lastMoveTarget, lastMoveAt = nil, 0
        local lastWaypointJumpAt = 0
        local nextObstacleCheck = t0
        local result = "parou"

        local function releaseSpace()
            pcall(function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
            end)
        end

        local function attemptRecovery(hum, root)
            recoveryAttempts = recoveryAttempts + 1
            if recoveryAttempts > MINER_CFG.MaxRecoveryAttempts then
                return false
            end

            dbg("personagem preso; recuperação", recoveryAttempts, "de", MINER_CFG.MaxRecoveryAttempts)
            setMoving(false)
            pcall(function() hum:MoveTo(root.Position) end)
            task.wait(0.10)
            if not isActive(token) then
                releaseSpace()
                return false
            end

            local destination = info.StandPoint or info.GroundPos or info.Center
            local toward = Vector3.new(destination.X - root.Position.X, 0, destination.Z - root.Position.Z)
            if toward.Magnitude < 0.1 then
                local look = root.CFrame.LookVector
                toward = Vector3.new(look.X, 0, look.Z)
            end
            if toward.Magnitude < 0.1 then
                toward = Vector3.new(1, 0, 0)
            else
                toward = toward.Unit
            end

            -- O detector de travamento chama a recuperação forçada: ela não depende
            -- de outro Raycast e não é bloqueada pelo cooldown de obstáculo.
            local recovered = performMinerObstacleRecovery(hum, root, toward, token, true)
            releaseSpace()
            if not recovered or not isActive(token) then
                setMoving(false)
                return false
            end

            local _, currentHum, currentRoot = getChar()
            if not (currentHum and currentRoot) then
                setMoving(false)
                return false
            end

            destination = info.StandPoint or info.GroundPos or info.Center
            local okPath, newWps = computePath(currentRoot.Position, destination)
            if okPath and newWps and #newWps > 0 then
                local endpoint = newWps[#newWps].Position
                if horizontal(endpoint, destination) > 8
                    or math.abs(endpoint.Y - destination.Y) > 8 then
                    okPath, newWps = false, nil
                end
            end

            if not okPath then
                okPath = checkReachable(info, currentRoot, true)
                if okPath then
                    newWps = info.Waypoints
                end
            end

            if not okPath then
                dbg("rota alternativa não encontrada após recuo e pulos", recoveryAttempts)
                waypoints = nil
                idx = 1
                plannedCenter = info.Center
                lastMoveTarget, lastMoveAt = nil, 0
                lastTargetDistance = nil
                lastPos = currentRoot.Position
                lastCheck = os.clock()
                stuck = 0
                setMoving(true)
                pcall(function() currentHum:MoveTo(destination) end)
                return recoveryAttempts < MINER_CFG.MaxRecoveryAttempts
            end

            waypoints = newWps
            idx = 1
            plannedCenter = info.Center
            lastMoveTarget, lastMoveAt = nil, 0
            lastTargetDistance = nil
            lastPos = currentRoot.Position
            lastCheck = os.clock()
            stuck = 0
            setMoving(true)
            dbg("rota recalculada após recuo e pulos", recoveryAttempts)
            return true
        end

        while isActive(token) do
            local gone = oreGone(info)
            if gone then
                result = "sumiu"
                break
            end

            local _, hum, root = getChar()
            if not (info.Inst and info.Inst.Parent and info.Inst:IsDescendantOf(workspace)
                and classify(info.Inst)) then
                result = "sumiu"
                break
            end

            if not root then
                setMoving(false)
                lastPos, lastTargetDistance, stuck = nil, nil, 0
                task.wait(0.3)
            else
                local now = os.clock()
                local flat = horizontal(root.Position, info.Center)
                local stand = info.StandPoint or info.GroundPos or info.Center
                local standFlat = horizontal(root.Position, stand)
                local standVerticalError = math.abs(root.Position.Y - (stand.Y + 3))

                if standFlat <= MINER_CFG.WalkStopDistance
                    and standVerticalError <= MINER_CFG.ArrivalVerticalTolerance then
                    result = "arrived"
                    break
                end

                if now - lastTargetRefresh >= MINER_CFG.TargetPositionRefreshInterval then
                    lastTargetRefresh = now
                    local boxOk, boxCf, boxSize = pcall(function()
                        return getBox(info.Inst)
                    end)
                    if not boxOk or not boxCf or not boxSize then
                        result = "sumiu"
                        break
                    end
                    if not isNormallyOriented(info.Inst, boxCf) then
                        rejected[info.Inst] = os.clock() + MINER_CFG.OrientationIgnoreTime
                        result = "orientacao-invalida"
                        break
                    end

                    local mn, mx = worldBounds(boxCf, boxSize)
                    local newCenter = (mn + mx) / 2
                    local newExt = mx - mn
                    info.Center = newCenter
                    info.Top = mx.Y
                    info.Bottom = mn.Y
                    info.Radius = math.clamp(math.max(newExt.X, newExt.Z) / 2, 1, 8)

                    if (newCenter - plannedCenter).Magnitude >= MINER_CFG.TargetMoveRepathDistance then
                        local grounded, newGround = checkGround(info.Inst, mn, mx, newCenter)
                        if not grounded then
                            newGround = findGroundBelow(info.Inst, newCenter, newExt, root.Position)
                        end
                        info.GroundPos = newGround or Vector3.new(newCenter.X, root.Position.Y, newCenter.Z)
                        info.StandPoint, info.Waypoints = nil, nil

                        if not checkReachable(info, root, true) then
                            result = "inalcancavel"
                            break
                        end

                        waypoints = info.Waypoints
                        idx = 1
                        plannedCenter = info.Center
                        lastMoveTarget, lastMoveAt = nil, 0
                        lastTargetDistance = nil
                        stuck = 0
                        dbg("alvo se moveu; rota recalculada")
                    end
                end

                if now - t0 > limit then
                    result = "inalcancavel"
                    break
                end

                setMoving(true)

                local target = info.StandPoint or info.Center
                local wp = waypoints and waypoints[idx]
                if wp then
                    while idx < #waypoints
                        and horizontal(root.Position, wp.Position) < 3.5
                        and math.abs(root.Position.Y - wp.Position.Y) < 6 do
                        idx = idx + 1
                        wp = waypoints[idx]
                        lastTargetDistance = nil
                    end
                    target = wp.Position
                    if wp.Action == Enum.PathWaypointAction.Jump
                        and horizontal(root.Position, wp.Position) < 4.5
                        and now - lastWaypointJumpAt >= MINER_CFG.WaypointJumpCooldown then
                        hum.Jump = true
                        lastWaypointJumpAt = now
                    end
                    if idx >= #waypoints and horizontal(root.Position, wp.Position) < 3.5 then
                        target = info.StandPoint or info.Center
                    end
                end

                local recoveredObstacle = false
                if MINER_CFG.ObstacleRecoveryEnabled and now >= nextObstacleCheck
                    and horizontal(root.Position, target) > MINER_CFG.WalkStopDistance then
                    local pathDirection = target - root.Position
                    local obstacle = getBlockingMinerObstacle(root, pathDirection, info.Inst)
                    if obstacle and os.clock() - lastMinerObstacleRecoveryAt >= MINER_CFG.ObstacleRecoveryCooldown then
                        local recovered = performMinerObstacleRecovery(hum, root, pathDirection, token)
                        if recovered and isActive(token) then
                            local _, resumedHum, resumedRoot = getChar()
                            if resumedHum and resumedRoot then
                                local destination = info.StandPoint or info.GroundPos or info.Center
                                local pathOk, newWaypoints = computePath(resumedRoot.Position, destination)
                                if pathOk and newWaypoints and #newWaypoints > 0 then
                                    local endpoint = newWaypoints[#newWaypoints].Position
                                    if horizontal(endpoint, destination) <= 8
                                        and math.abs(endpoint.Y - destination.Y) <= 8 then
                                        waypoints = newWaypoints
                                    else
                                        pathOk = false
                                    end
                                end
                                if not pathOk then
                                    if checkReachable(info, resumedRoot, true) then
                                        waypoints = info.Waypoints
                                    else
                                        waypoints = nil
                                    end
                                end
                                idx = 1
                                plannedCenter = info.Center
                                lastMoveTarget, lastMoveAt = nil, 0
                                lastTargetDistance = nil
                                lastPos = resumedRoot.Position
                                lastCheck = os.clock()
                                stuck = 0
                                recoveredObstacle = true
                                dbg("rota retomada após recuperação de obstáculo")
                            end
                        end
                    end
                    nextObstacleCheck = os.clock() + MINER_CFG.ObstacleCheckInterval
                end

                if not recoveredObstacle then
                    local targetChanged = not lastMoveTarget
                        or (target - lastMoveTarget).Magnitude > 1.25
                    if targetChanged or (now - lastMoveAt) >= MINER_CFG.MoveToRefreshInterval then
                        hum:MoveTo(target)
                        lastMoveTarget = target
                        lastMoveAt = now
                        if targetChanged then
                            lastTargetDistance = nil
                            lastPos = root.Position
                            lastCheck = now
                            stuck = 0
                        end
                    end

                    if now - lastCheck >= MINER_CFG.StuckCheckInterval then
                        local movement = lastPos and (root.Position - lastPos).Magnitude or math.huge
                        local targetDistance = (root.Position - target).Magnitude
                        local movedTowardTarget = lastTargetDistance == nil
                            or targetDistance < lastTargetDistance - 0.2
                        local madeProgress = movement >= MINER_CFG.StuckPositionThreshold and movedTowardTarget
                        if madeProgress then
                            stuck = 0
                        else
                            stuck = stuck + (now - lastCheck)
                        end
                        lastPos = root.Position
                        lastTargetDistance = targetDistance
                        lastCheck = now
                    end

                    if stuck >= MINER_CFG.StuckTimeout then
                        stuck = 0
                        local recovered = attemptRecovery(hum, root)
                        if not recovered then
                            if recoveryAttempts >= MINER_CFG.MaxRecoveryAttempts then
                                result = "inalcancavel"
                                break
                            end
                            task.wait(0.15)
                        end
                    end
                end

                task.wait(MINER_CFG.TickRate)
            end
        end

        releaseSpace()
        return result
    end

    local function moveForwardTwoStudsAfterHit(info, token)
        local _, hum, root = getChar()
        if not (isActive(token) and hum and root and info and info.Center) then return false end
        local toward = Vector3.new(info.Center.X - root.Position.X, 0, info.Center.Z - root.Position.Z)
        if toward.Magnitude < 0.1 then return false end
        toward = toward.Unit

        local startPos = root.Position
        local destination = startPos + toward * MINER_CFG.FirstHitApproachDistance
        -- MoveTo para ligeiramente antes do destino; acrescentamos 0,95 stud para
        -- aproximar a distância final real de 2 studs.
        local moveTarget = destination + toward * 0.95
        pcall(function() hum:MoveTo(moveTarget) end)
        local deadline = os.clock() + 0.9
        while isActive(token) and root.Parent do
            local delta = root.Position - destination
            if Vector3.new(delta.X, 0, delta.Z).Magnitude <= 0.25
                or os.clock() >= deadline then
                break
            end
            task.wait(0.025)
        end
        pcall(function() hum:MoveTo(root.Position) end)
        return isActive(token)
    end

    local function mineLoop(info, token)
        setMoving(false)

        local reach = (info.Radius or 1) + MINER_CFG.MineDistance
        local t0 = os.clock()
        local invBefore = snapshotInventory()
        local minedNoticeBefore = minerMinedNoticeCount
        local lastInvCheck = 0
        local result, why = "parou", nil
        local clickAttempts = 0
        local pendingHit = nil
        local firstHitApproachDone = false
        local function advanceAfterFirstClickIfCollected()
            if clickAttempts == 1 and not firstHitApproachDone and info.Center then
                firstHitApproachDone = true
                moveForwardTwoStudsAfterHit(info, token)
            end
        end
        info.MiningStarted = true
        info.ClickAttempts = 0
        info.HiddenSince = nil

        local function confirmCollectionDuringGrace()
            local graceDeadline = os.clock() + MINER_CFG.MinedNoticeGraceTime
            local nextInventoryCheck = 0
            while isActive(token) and os.clock() < graceDeadline do
                if minerMinedNoticeCount > minedNoticeBefore then
                    return true, "notificação Mined/Collected"
                end
                local gone, goneWhy = oreGone(info)
                if gone then return true, goneWhy or "minério removido" end
                local now = os.clock()
                if now >= nextInventoryCheck then
                    nextInventoryCheck = now + 0.12
                    if inventoryIncreased(invBefore, snapshotInventory(), info) then
                        return true, "item adicionado ao inventário"
                    end
                end
                task.wait(0.05)
            end
            return false, nil
        end

        while isActive(token) do
            local _, hum, root = getChar()
            if not (hum and root) then
                result = "sem-personagem"
                break
            end

            local gone, goneWhy = oreGone(info)
            if gone then
                advanceAfterFirstClickIfCollected()
                result, why = "coletado", goneWhy
                break
            end

            if minerMinedNoticeCount > minedNoticeBefore then
                advanceAfterFirstClickIfCollected()
                result, why = "coletado", "notificação Mined/Collected"
                break
            end

            local currentBoxCf = select(1, getBox(info.Inst))
            if not isNormallyOriented(info.Inst, currentBoxCf) then
                rejected[info.Inst] = os.clock() + MINER_CFG.OrientationIgnoreTime
                result = "orientacao-invalida"
                break
            end

            local now = os.clock()
            if now - lastInvCheck >= 0.15 then
                lastInvCheck = now
                if inventoryIncreased(invBefore, snapshotInventory(), info) then
                    advanceAfterFirstClickIfCollected()
                    result, why = "coletado", "item no inventário"
                    break
                end
            end

            if pendingHit and now >= pendingHit.Deadline then
                local afterVisual = getVisualSignature(info.Inst)
                local afterHealth = getOreHealthSignature(info.Inst)
                local hitConfirmed = visualSizeDecreased(pendingHit.Visual, afterVisual)
                    or oreHealthDecreased(pendingHit.Health, afterHealth)

                if hitConfirmed then
                    dbg("golpe confirmado", pendingHit.ClickIndex, "em", info.Name)
                    if pendingHit.ClickIndex == 1 and not firstHitApproachDone then
                        firstHitApproachDone = true
                        -- Avança 2 studs quando o primeiro golpe foi confirmado, mesmo
                        -- que esse golpe já tenha feito o minério desaparecer.
                        moveForwardTwoStudsAfterHit(info, token)
                        if not isActive(token) then break end
                        local nowGone, nowGoneWhy = oreGone(info)
                        if nowGone then
                            result, why = "coletado", nowGoneWhy or "minério removido no primeiro golpe"
                            break
                        end
                        if minerMinedNoticeCount > minedNoticeBefore then
                            result, why = "coletado", "notificação Mined/Collected"
                            break
                        end
                    end
                else
                    dbg("golpe sem confirmação visual/vida", pendingHit.ClickIndex, "em", info.Name)
                end
                pendingHit = nil

                -- Após a terceira picaretada, só mantém o ore se o jogo confirmar a coleta.
                if clickAttempts >= MINER_CFG.MaxClicksPerOre then
                    local confirmed, confirmationWhy = confirmCollectionDuringGrace()
                    if confirmed then
                        result, why = "coletado", confirmationWhy
                    else
                        result = "sem-progresso-mineracao"
                        why = "sem confirmação Mined/Collected após 3 picaretadas"
                    end
                    break
                end
            end

            local horizontalDistance = horizontal(root.Position, info.Center)
            local verticalDistance = math.abs(root.Position.Y - info.Center.Y)
            if horizontalDistance > reach + MINER_CFG.ReachBuffer
                or verticalDistance > MINER_CFG.MaxVerticalReach then
                result = "inalcancavel"
                break
            end

            if now - t0 > MINER_CFG.MineTimeout then
                result = "timeout"
                break
            end

            hum:MoveTo(root.Position)
            faceTo(root, info.Center)
            aimTarget = info.Center

            if CombatCfg.SkillBusy then
                task.wait(0.03)
            elseif not pendingHit and clickAttempts < MINER_CFG.MaxClicksPerOre then
                local visualBefore = getVisualSignature(info.Inst)
                local healthBefore = getOreHealthSignature(info.Inst)
                local clickOk, clickSent = pcall(function()
                    return clickOnce(true)
                end)
                if clickOk and clickSent then
                    clickAttempts = clickAttempts + 1
                    info.ClickAttempts = clickAttempts
                    pendingHit = {
                        ClickIndex = clickAttempts,
                        Visual = visualBefore,
                        Health = healthBefore,
                        Deadline = os.clock() + MINER_CFG.HitVerifyDelay,
                    }
                end
                task.wait(MINER_CFG.ClickDelay)
            else
                task.wait(0.03)
            end
        end

        aimTarget = nil
        return result, why
    end

    local function mineTarget(info, token)
        local deadline = os.clock() + MINER_CFG.TargetMaxTime

        while isActive(token) and os.clock() < deadline do
            local walked, nextInfo = walkTo(info, token)
            if walked == "retarget" and nextInfo then
                info = nextInfo
                AutoMiner.Target = info.Inst
                setMoving(false)
            elseif walked ~= "arrived" then
                setMoving(false)
                return walked, nil, info
            else
                local result, why = mineLoop(info, token)
                return result, why, info
            end
        end

        setMoving(false)
        if isActive(token) then
            return "timeout", nil, info
        end
        return "parou", nil, info
    end

    local function step(token)
        if AutoMob.Enabled then
            setMoving(false)
            task.wait(0.5)
            return
        end

        if not ensureMiningToolEquipped() then
            setMoving(false)
            aimTarget = nil
            if os.clock() - lastPickaxeWarningAt >= 5 then
                lastPickaxeWarningAt = os.clock()
                warn("[RAMDOM HUB] Auto Miner: não encontrei uma picareta/ferramenta de mineração equipada ou na mochila.")
            end
            task.wait(0.75)
            return
        end

        local _, _, root = getChar()
        if not root then
            setMoving(false)
            aimTarget = nil
            AutoMiner.Target = nil
            task.wait(0.5)
            return
        end

        local info, stats = pickTarget(root, token)
        if not isActive(token) then return end

        if not info then
            setMoving(false)
            AutoMiner.Target = nil
            if stats.PathTries >= MINER_CFG.MaxPathChecks then
                task.wait(0.2)
            else
                task.wait(MINER_CFG.RescanDelay)
            end
            return
        end

        AutoMiner.Target = info.Inst
        local result, why, finalInfo = mineTarget(info, token)
        info = finalInfo or info
        AutoMiner.Target = nil
        aimTarget = nil

        if not isActive(token) then return end

        if result == "coletado" then
            AutoMiner.Collected = AutoMiner.Collected + 1
            blockSpot(info.Center, MINER_CFG.MinedSpotTime)
            rejected[info.Inst] = os.clock() + MINER_CFG.MinedSpotTime
        elseif result == "sumiu" then
            blockSpot(info.Center, 10)
        elseif result == "sem-progresso-mineracao" then
            rejected[info.Inst] = os.clock() + MINER_CFG.IgnoreTime
        elseif result == "orientacao-invalida" then
            rejected[info.Inst] = os.clock() + MINER_CFG.OrientationIgnoreTime
        elseif result == "inalcancavel" or result == "timeout" then
            rejected[info.Inst] = os.clock() + MINER_CFG.IgnoreTime
        elseif result == "sem-personagem" then
            task.wait(0.5)
        end
    end

    local function startAutoMiner()
        if AutoMiner.Enabled then return end
        AutoMiner.Enabled = true
        AutoMiner.Token = AutoMiner.Token + 1
        local token = AutoMiner.Token

        if AutoMiner.Thread then
            pcall(task.cancel, AutoMiner.Thread)
            AutoMiner.Thread = nil
        end

        blocked = {}
        candidateCache = nil
        candidateCacheAt = 0
        lastMinerObstacleRecoveryAt = -math.huge
        releaseMinerSpace()
        for k in pairs(rejected) do
            rejected[k] = nil
        end
        AutoMiner.Collected = 0
        aimTarget = nil

        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)
        RunService:BindToRenderStep(STEER_NAME, Enum.RenderPriority.Camera.Value + 1, onRenderStep)

        AutoMiner.Thread = task.spawn(function()
            while isActive(token) do
                local ok, err = pcall(step, token)
                if not ok then
                    warn("[RAMDOM HUB] Auto Miner erro: " .. tostring(err))
                    setMoving(false)
                    aimTarget = nil
                    AutoMiner.Target = nil
                    task.wait(2)
                end
                task.wait(0.05)
            end
        end)
    end

    local function stopAutoMiner()
        if not AutoMiner.Enabled then return end
        AutoMiner.Enabled = false
        AutoMiner.Token = AutoMiner.Token + 1

        if AutoMiner.Thread then
            pcall(task.cancel, AutoMiner.Thread)
            AutoMiner.Thread = nil
        end

        AutoMiner.Target = nil
        aimTarget = nil
        setMoving(false)
        releaseMinerSpace()
        releaseMouse()
        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)

        local _, hum, root = getChar()
        if hum and root then
            pcall(function() hum:MoveTo(root.Position) end)
        end
    end

    AutoMiner.Start = startAutoMiner
    AutoMiner.Stop = stopAutoMiner
end

--// ==========================================
--// AUTO WOOD — MOTOR
--// Procura somente alvos com nomes de árvore/wood, caminha até eles e clica.
--// ==========================================
do
    local PathfindingService = game:GetService("PathfindingService")
    local STEER_NAME = "RamdomHubAutoWoodAim"
    local ignored = setmetatable({}, { __mode = "k" })
    local aimTarget = nil
    local boostedHumanoid = nil
    local originalWalkSpeed = nil
    local forwardKeyDown = false
    local shiftKeyDown = false
    local spaceKeyDown = false
    local lastObstacleRecoveryAt = -math.huge

    local function isActive(token)
        return AutoWood.Enabled and AutoWood.Token == token
    end

    local function getChar()
        local char = player.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            return char, hum, root
        end
        return nil
    end

    local function sendWoodKey(keyCode, down)
        local ok = pcall(function()
            VirtualInputManager:SendKeyEvent(down, keyCode, false, game)
        end)
        if keyCode == Enum.KeyCode.W and ok then
            forwardKeyDown = down
        elseif keyCode == Enum.KeyCode.LeftShift and ok then
            shiftKeyDown = down
        elseif keyCode == Enum.KeyCode.Space and ok then
            spaceKeyDown = down
        end
    end

    local function releaseWoodKeys()
        -- Força a liberação mesmo se a rotina for cancelada durante uma espera.
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
        end)
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
        end)
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
        forwardKeyDown = false
        shiftKeyDown = false
        spaceKeyDown = false
    end

    local function releaseWoodMouse()
        local p = getClickPosition() or Vector2.new(0, 0)
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 0)
        end)
        pcall(function()
            local cam = workspace.CurrentCamera
            VirtualUser:Button1Up(p, cam and cam.CFrame or CFrame.new())
        end)
    end

    local function normalizeName(name)
        local s = tostring(name or "")
        s = s:gsub("(%l)(%u)", "%1 %2")
        s = s:gsub("[_%-%.]+", " ")
        s = s:gsub("%s+", " ")
        return string.lower(s):match("^%s*(.-)%s*$") or ""
    end

    -- Procura machado/hatchet entre as Tools equipadas e as Tools nos slots
    -- do Backpack, tal como o Auto Fish procura a vara de pesca.
    local function getWoodAxeTool()
        local character = player.Character
        local backpack = player:FindFirstChildOfClass("Backpack")

        local function matches(tool)
            if not tool or not tool:IsA("Tool") then return false end
            local n = normalizeName(tool.Name)
            if n:find("pickaxe", 1, true) or n:find("pick axe", 1, true) then
                return false
            end
            return n:find("axe", 1, true) ~= nil
                or n:find("hatchet", 1, true) ~= nil
                or n:find("woodcutter", 1, true) ~= nil
                or n:find("wood cutter", 1, true) ~= nil
                or n:find("lumberjack", 1, true) ~= nil
                or n:find("chopper", 1, true) ~= nil
        end

        if character then
            for _, item in ipairs(character:GetChildren()) do
                if matches(item) then return item, true end
            end
        end
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if matches(item) then return item, false end
            end
        end
        return nil, false
    end

    local function ensureWoodAxeEquipped()
        local tool, equipped = getWoodAxeTool()
        if not tool then return false end
        if equipped then return true end

        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return false end

        pcall(function() humanoid:EquipTool(tool) end)
        task.wait(0.15)
        local equippedTool, isEquipped = getWoodAxeTool()
        return equippedTool ~= nil and isEquipped
    end

    local lastAxeWarningAt = -math.huge

    -- Nomes de estruturas de madeira que não são árvores. Esses filtros são
    -- aplicados antes das palavras positivas para não selecionar baús/carruagens,
    -- tendas, móveis, paredes, caixas e outros props com madeira no nome.
    local WOOD_EXCLUDED_NAME_HINTS = {
        "chest", "coffer", "wagon", "cart", "carriage", "barrow", "vehicle",
        "tent", "shelter", "camp", "cabin", "house", "shack", "shed",
        "furniture", "chair", "table", "bench", "bed", "throne", "desk",
        "crate", "box", "barrel", "cask", "container", "storage", "supply",
        "treasure", "loot", "plank", "board", "wall", "fence", "gate", "door",
        "bridge", "platform", "building", "structure", "barricade", "tower",
        "boat", "ship", "raft", "pavilion", "altar", "coffin", "casket",
        "wheel", "wheels", "axle", "decoration", "decor", "showcase", "display", "shop", "merchant",
    }

    local function isExcludedWoodName(name)
        local s = normalizeName(name)
        for _, hint in ipairs(WOOD_EXCLUDED_NAME_HINTS) do
            if s:find("%f[%a]" .. hint .. "%f[%A]") then
                return true
            end
        end
        return false
    end

    local function isWoodName(name)
        local s = normalizeName(name)
        if isExcludedWoodName(s) then return false end
        if s:find("árvore", 1, true) or s:find("arvore", 1, true)
            or s:find("madeira", 1, true) then
            return true
        end
        local patterns = {
            "%f[%a]trees?%f[%A]",
            "%f[%a]wood%f[%A]",
            "%f[%a]logs?%f[%A]",
            "%f[%a]trunks?%f[%A]",
        }
        for _, pattern in ipairs(patterns) do
            if s:find(pattern) then return true end
        end
        return false
    end

    -- Detecta a notificação do próprio jogo mostrada como "< Collected Wood >".
    -- Funciona quando a mensagem é criada, seu texto muda ou a interface volta a ficar visível.
    local collectionNoticeCount = 0
    local collectionNoticeStates = setmetatable({}, { __mode = "k" })
    local watchedTextObjects = setmetatable({}, { __mode = "k" })
    local watchedVisibilityObjects = setmetatable({}, { __mode = "k" })
    local watchedGuiContainers = setmetatable({}, { __mode = "k" })

    local function isTextGuiObject(inst)
        return inst and (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox"))
    end

    local function isGuiTreeVisible(inst)
        local cur = inst
        while cur and cur ~= game do
            if cur:IsA("GuiObject") and not cur.Visible then
                return false
            end
            if cur:IsA("LayerCollector") and not cur.Enabled then
                return false
            end
            cur = cur.Parent
        end
        return true
    end

    local function isCollectedWoodMessage(value)
        local text = normalizeName(value)
        return text:find("collected%s+wood") ~= nil
            or text:find("wood%s+collected") ~= nil
            or text:find("madeira%s+coletada") ~= nil
            or text:find("madeira%s+coletado") ~= nil
    end

    local function updateCollectionNoticeState(label, eventKind)
        if not isTextGuiObject(label) then return end
        local text = tostring(label.Text or "")
        local visible = isGuiTreeVisible(label)
        local matches = isCollectedWoodMessage(text)
        local state = collectionNoticeStates[label]
        local now = os.clock()

        if not state then
            state = { Text = text, Visible = visible, LastCountAt = -math.huge }
            collectionNoticeStates[label] = state
            -- Existing toast at script startup is baseline, not a new collection.
            if eventKind == "added" and matches and visible then
                collectionNoticeCount = collectionNoticeCount + 1
                state.LastCountAt = now
            end
            return
        end

        local changed = text ~= state.Text or (visible and not state.Visible)
        if eventKind == "added" and matches and visible then
            changed = true
        end
        if matches and visible and changed and now - state.LastCountAt >= 0.25 then
            collectionNoticeCount = collectionNoticeCount + 1
            state.LastCountAt = now
        end
        state.Text = text
        state.Visible = visible
    end

    local function scanCollectionNotices(container, eventKind)
        if not container then return end
        if isTextGuiObject(container) then
            updateCollectionNoticeState(container, eventKind or "visibility")
        end
        local ok, descendants = pcall(function() return container:GetDescendants() end)
        if not ok or not descendants then return end
        for _, descendant in ipairs(descendants) do
            if isTextGuiObject(descendant) then
                updateCollectionNoticeState(descendant, eventKind or "visibility")
            end
        end
    end

    local function watchCollectionGuiObject(inst, eventKind)
        if not inst then return end
        if isTextGuiObject(inst) then
            if not watchedTextObjects[inst] then
                watchedTextObjects[inst] = true
                pcall(function()
                    inst:GetPropertyChangedSignal("Text"):Connect(function()
                        updateCollectionNoticeState(inst, "changed")
                    end)
                end)
            end
            updateCollectionNoticeState(inst, eventKind or "initial")
        end

        if (inst:IsA("GuiObject") or inst:IsA("LayerCollector"))
            and not watchedVisibilityObjects[inst] then
            watchedVisibilityObjects[inst] = true
            local propertyName = inst:IsA("LayerCollector") and "Enabled" or "Visible"
            pcall(function()
                inst:GetPropertyChangedSignal(propertyName):Connect(function()
                    scanCollectionNotices(inst, "visibility")
                end)
            end)
        end
    end

    local function watchCollectionGuiContainer(container)
        if not container or watchedGuiContainers[container] then return end
        watchedGuiContainers[container] = true
        watchCollectionGuiObject(container, "initial")
        local ok, descendants = pcall(function() return container:GetDescendants() end)
        if ok and descendants then
            for _, descendant in ipairs(descendants) do
                watchCollectionGuiObject(descendant, "initial")
            end
        end
        pcall(function()
            container.DescendantAdded:Connect(function(descendant)
                watchCollectionGuiObject(descendant, "added")
                local okChildren, children = pcall(function() return descendant:GetDescendants() end)
                if okChildren and children then
                    for _, child in ipairs(children) do
                        watchCollectionGuiObject(child, "added")
                    end
                end
            end)
        end)
    end

    -- A mensagem pode estar no PlayerGui ou em uma interface nativa do cliente.
    pcall(function() watchCollectionGuiContainer(CoreGui) end)
    local existingPlayerGui = player:FindFirstChildOfClass("PlayerGui")
    if existingPlayerGui then
        pcall(function() watchCollectionGuiContainer(existingPlayerGui) end)
    end
    player.ChildAdded:Connect(function(child)
        if child:IsA("PlayerGui") then
            pcall(function() watchCollectionGuiContainer(child) end)
        end
    end)

    local TREE_COMPONENT_HINTS = {
        "trunk", "branch", "branches", "leaf", "leaves", "foliage", "bark", "root",
        "galho", "galhos", "folha", "folhas", "copa", "ramo", "ramos",
    }

    local function isTreeComponentName(name)
        local s = normalizeName(name)
        for _, hint in ipairs(TREE_COMPONENT_HINTS) do
            if s == hint or s:find(hint, 1, true) then
                return true
            end
        end
        return false
    end

    local function hasNamedWoodModelChild(inst)
        if not inst:IsA("Model") then return false end
        for _, child in ipairs(inst:GetChildren()) do
            -- Um submodelo chamado Trunk/Leaves é uma peça da árvore, não outra árvore.
            if child:IsA("Model") and isWoodName(child.Name)
                and not isTreeComponentName(child.Name) then
                return true
            end
        end
        return false
    end

    local function hasWoodAncestor(inst)
        local cur = inst.Parent
        while cur and cur ~= workspace do
            -- Se o Model parece ser apenas um agrupador de várias árvores, deixa
            -- cada árvore filha virar um alvo separado.
            if (cur:IsA("Model") or cur:IsA("BasePart")) and isWoodName(cur.Name)
                and not hasNamedWoodModelChild(cur) then
                return true
            end
            cur = cur.Parent
        end
        return false
    end

    local function hasLivingAncestor(inst)
        local cur = inst
        while cur and cur ~= workspace do
            if cur:IsA("Model") and cur:FindFirstChildOfClass("Humanoid") then
                return true
            end
            cur = cur.Parent
        end
        return false
    end

    local function collectParts(inst)
        local parts = {}
        if inst:IsA("BasePart") then
            table.insert(parts, inst)
        end
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("BasePart") then
                table.insert(parts, d)
            end
        end
        return parts
    end

    local function visiblePartCount(inst)
        if not inst or not inst.Parent then return 0 end
        local count = 0
        for _, part in ipairs(collectParts(inst)) do
            if part.Parent and part.Transparency < 0.98 then
                count = count + 1
            end
        end
        return count
    end

    local function getTargetBox(inst)
        if not inst or not inst.Parent then return nil end
        if inst:IsA("BasePart") then
            return inst.CFrame, inst.Size
        end
        local ok, cf, size = pcall(function()
            return inst:GetBoundingBox()
        end)
        if ok and cf and size then
            return cf, size
        end

        -- Fallback para modelos sem uma caixa de limites disponível.
        local parts = collectParts(inst)
        if #parts == 0 then return nil end
        local minV = Vector3.new(math.huge, math.huge, math.huge)
        local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
        for _, part in ipairs(parts) do
            local half = part.Size / 2
            local p = part.Position
            minV = Vector3.new(
                math.min(minV.X, p.X - half.X),
                math.min(minV.Y, p.Y - half.Y),
                math.min(minV.Z, p.Z - half.Z)
            )
            maxV = Vector3.new(
                math.max(maxV.X, p.X + half.X),
                math.max(maxV.Y, p.Y + half.Y),
                math.max(maxV.Z, p.Z + half.Z)
            )
        end
        local center = (minV + maxV) / 2
        return CFrame.new(center), maxV - minV
    end

    local function findTrunkPart(inst, boxCf, boxSize)
        if not inst or not inst.Parent then return nil end
        if not (boxCf and boxSize) then
            boxCf, boxSize = getTargetBox(inst)
        end
        if not (boxCf and boxSize) then return nil end

        -- Uma árvore que é uma única peça/mesh não tem uma peça de tronco filha.
        -- A posição do alvo será deslocada para a parte inferior em getAimPosition.
        if inst:IsA("BasePart") then
            local horizontal = math.max(inst.Size.X, inst.Size.Z)
            if inst.Size.Y >= 2.5 and inst.Size.Y >= horizontal * 0.60 then
                return inst
            end
            return nil
        end

        local bottomY = boxCf.Position.Y - boxSize.Y / 2
        local horizontalBox = math.max(math.max(boxSize.X, boxSize.Z), 1)
        local heightBox = math.max(boxSize.Y, 0.01)
        local best, bestScore = nil, -math.huge

        for _, part in ipairs(collectParts(inst)) do
            if part.Parent and part.Transparency < 0.98 then
                local horizontal = math.max(part.Size.X, part.Size.Z)
                local vertical = part.Size.Y
                local partBottom = part.Position.Y - vertical / 2
                local relativeBottom = (partBottom - bottomY) / heightBox

                -- Aceita segmentos robustos de tronco próximos à base. O limite
                -- inferior por altura exclui a maior parte dos galhos horizontais.
                if vertical >= 2.0 and vertical >= horizontal * 0.68
                    and relativeBottom >= -0.08 and relativeBottom <= 0.55 then
                    local centerOffset = Vector3.new(
                        part.Position.X - boxCf.Position.X, 0,
                        part.Position.Z - boxCf.Position.Z
                    ).Magnitude
                    local radialOffset = math.clamp(centerOffset / horizontalBox, 0, 1.5)
                    local lowerScore = 1 - math.clamp(relativeBottom, 0, 1)
                    local verticalScore = math.min(vertical / math.max(horizontal, 0.1), 3)
                    local partName = normalizeName(part.Name)
                    local namedTrunkBonus = 0
                    if partName:find("trunk", 1, true)
                        or partName:find("stem", 1, true)
                        or partName:find("log", 1, true)
                        or partName:find("tronco", 1, true) then
                        namedTrunkBonus = 0.8
                    end

                    -- Prioridade principal: segmento mais baixo; depois, peça mais
                    -- central e vertical. Assim a mira não escolhe a ponta da copa.
                    local score = lowerScore * 4.0
                        + (1 - math.min(radialOffset, 1)) * 1.4
                        + verticalScore * 0.15
                        + namedTrunkBonus
                    if score > bestScore then
                        best, bestScore = part, score
                    end
                end
            end
        end
        return best
    end

    local function getAimPosition(inst)
        local cf, size = getTargetBox(inst)
        if not cf or not size then return nil end

        -- Mira no primeiro segmento de tronco próximo à base, não na ponta da copa.
        -- Recalcula o ponto a cada atualização para acompanhar a coleta.
        local trunk = findTrunkPart(inst, cf, size)
        if trunk and trunk.Parent then
            local isWholeTreeMesh = trunk == inst
                or (trunk.Size.Y >= size.Y * 0.85
                    and math.max(trunk.Size.X, trunk.Size.Z)
                        >= math.max(size.X, size.Z) * 0.75)
            local aimY
            if isWholeTreeMesh then
                -- Mesh única: mira no terço inferior, onde fica o tronco.
                aimY = trunk.Position.Y - math.clamp(trunk.Size.Y * 0.28, 1, 6)
            else
                -- Tronco dividido em segmentos: mira no centro inferior do primeiro.
                aimY = trunk.Position.Y - math.clamp(trunk.Size.Y * 0.10, 0.25, 1.0)
            end
            return Vector3.new(trunk.Position.X, aimY, trunk.Position.Z), cf, size, trunk
        end

        -- Fallback para modelos sem uma peça vertical identificável: mantém a
        -- mira no terço inferior da caixa, nunca no centro da copa.
        local y = cf.Position.Y
        if size.Y > 4 then
            y = cf.Position.Y - size.Y * 0.28
        end
        return Vector3.new(cf.Position.X, y, cf.Position.Z), cf, size, nil
    end

    local function getVisualSnapshot(inst)
        if not inst or not inst.Parent or not inst:IsDescendantOf(workspace) then
            return nil
        end

        local parts = collectParts(inst)
        local visibleCount, totalVolume = 0, 0
        local totalTransparency, totalR, totalG, totalB, samples = 0, 0, 0, 0, 0

        for _, part in ipairs(parts) do
            if part.Parent then
                local volume = math.max(0, part.Size.X) * math.max(0, part.Size.Y) * math.max(0, part.Size.Z)
                totalVolume = totalVolume + volume
                if part.Transparency < 0.98 then
                    visibleCount = visibleCount + 1
                    totalTransparency = totalTransparency + part.Transparency
                    totalR = totalR + part.Color.R
                    totalG = totalG + part.Color.G
                    totalB = totalB + part.Color.B
                    samples = samples + 1
                end
            end
        end

        local _, boxSize = getTargetBox(inst)
        if not boxSize then return nil end
        local divisor = math.max(samples, 1)
        return {
            VisibleCount = visibleCount,
            PartCount = #parts,
            Volume = totalVolume,
            Size = boxSize,
            Transparency = totalTransparency / divisor,
            R = totalR / divisor,
            G = totalG / divisor,
            B = totalB / divisor,
        }
    end

    -- A seleção de alvos usa somente os nomes dos objetos; não há fallback geométrico.

    local function hasVisualProgress(before, after)
        if not after or after.VisibleCount <= 0 then return true end
        if not before then return false end
        if after.VisibleCount < before.VisibleCount or after.PartCount < before.PartCount then
            return true
        end

        local tol = WOOD_CFG.ProgressSizeTolerance
        local rel = WOOD_CFG.ProgressRelativeTolerance
        local function shrank(beforeValue, afterValue)
            return beforeValue - afterValue >= math.max(tol, beforeValue * rel)
        end

        if shrank(before.Size.Y, after.Size.Y)
            or shrank(before.Size.X, after.Size.X)
            or shrank(before.Size.Z, after.Size.Z) then
            return true
        end
        if before.Volume - after.Volume >= math.max(0.35, before.Volume * rel) then
            return true
        end
        if after.Transparency - before.Transparency >= WOOD_CFG.ProgressTransparencyTolerance then
            return true
        end
        if math.abs(after.R - before.R) >= WOOD_CFG.ProgressColorTolerance
            or math.abs(after.G - before.G) >= WOOD_CFG.ProgressColorTolerance
            or math.abs(after.B - before.B) >= WOOD_CFG.ProgressColorTolerance then
            return true
        end
        return false
    end

    local function horizontalDistance(a, b)
        return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
    end

    local function setWalkSpeedBoost(enabled)
        local _, hum = getChar()
        if enabled then
            if not hum then return end
            if boostedHumanoid ~= hum then
                if boostedHumanoid and boostedHumanoid.Parent and originalWalkSpeed then
                    pcall(function() boostedHumanoid.WalkSpeed = originalWalkSpeed end)
                end
                boostedHumanoid = hum
                originalWalkSpeed = hum.WalkSpeed
            end
            if originalWalkSpeed then
                pcall(function() hum.WalkSpeed = originalWalkSpeed + WOOD_CFG.WalkSpeedBonus end)
            end
        else
            if boostedHumanoid and boostedHumanoid.Parent and originalWalkSpeed then
                pcall(function() boostedHumanoid.WalkSpeed = originalWalkSpeed end)
            end
            boostedHumanoid = nil
            originalWalkSpeed = nil
        end
    end

    local function getStandPoint(inst, hum, root)
        local aimPos, cf, size, trunk = getAimPosition(inst)
        if not (aimPos and cf and size) then return nil end

        -- Usa o tronco para calcular a aproximação; a copa larga não deve fazer
        -- o personagem parar vários metros antes de conseguir acertar com o machado.
        local center = (trunk and trunk.Parent) and trunk.Position or aimPos
        local toward = Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z)
        if toward.Magnitude < 0.1 then
            local look = root.CFrame.LookVector
            toward = Vector3.new(look.X, 0, look.Z)
        end
        if toward.Magnitude < 0.1 then
            toward = Vector3.new(1, 0, 0)
        else
            toward = toward.Unit
        end

        local radius
        if trunk and trunk.Parent then
            radius = math.clamp(math.max(trunk.Size.X, trunk.Size.Z) / 2, 1, 3.5)
        else
            radius = math.clamp(math.max(size.X, size.Z) / 2, 1, 5)
        end
        local offset = radius + 2.0
        local x = center.X + toward.X * offset
        local z = center.Z + toward.Z * offset
        local destination = Vector3.new(x, root.Position.Y, z)

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { inst, player.Character }
        params.RespectCanCollide = true
        local hit = workspace:Raycast(
            Vector3.new(x, math.max(root.Position.Y, cf.Position.Y) + 25, z),
            Vector3.new(0, -120, 0),
            params
        )
        if hit and hit.Normal.Y >= 0.45 then
            destination = Vector3.new(
                x,
                hit.Position.Y + math.max(2, hum.HipHeight + root.Size.Y / 2),
                z
            )
        end
        return destination, aimPos, radius
    end

    local function getObstacleIdentity(part, target)
        if not part then return nil end
        local model = part:FindFirstAncestorOfClass("Model")
        if model and model ~= target and not (target and model:IsDescendantOf(target)) then
            return model
        end
        return part
    end

    -- O Auto Wood pode ter selecionado o tronco como alvo, enquanto folhas,
    -- galhos ou outras partes da mesma árvore ficam fora da instância-alvo.
    -- Essas partes não devem iniciar a recuperação de obstáculos.
    local TREE_OBSTACLE_NAME_HINTS = {
        "tree", "trees", "arvore", "arvores", "árvore", "árvores",
        "trunk", "branch", "branches", "leaf", "leaves", "foliage", "bark",
        "galho", "galhos", "folha", "folhas", "copa", "ramo", "ramos",
    }

    local function isTreeRelatedName(name)
        local s = normalizeName(name)
        for _, hint in ipairs(TREE_OBSTACLE_NAME_HINTS) do
            if s == hint or s:find("%f[%a]" .. hint .. "%f[%A]") then
                return true
            end
        end
        return false
    end

    local function nearestModelAncestor(inst)
        local cur = inst
        while cur and cur ~= workspace do
            if cur:IsA("Model") then return cur end
            cur = cur.Parent
        end
        return nil
    end

    local function isTreePartForObstacleCheck(part, target)
        if not part then return false end

        -- Se o alvo ou um dos seus ancestrais/descendentes foi atingido, trata-se
        -- da árvore que o Auto Wood está tentando colher, não de uma parede.
        if target then
            if part == target or part:IsDescendantOf(target) or target:IsDescendantOf(part) then
                return true
            end

            -- Vários jogos guardam o tronco, as folhas e os galhos no mesmo Model.
            -- Ignora os outros componentes desse mesmo Model quando o tronco é o alvo.
            local hitModel = nearestModelAncestor(part)
            local targetModel = nearestModelAncestor(target)
            if hitModel and targetModel and hitModel == targetModel then
                return true
            end
        end

        -- Também ignora componentes reconhecíveis de árvores, mesmo quando estão
        -- fora do Model selecionado pelo Auto Wood.
        local cur = part
        while cur and cur ~= workspace do
            if isTreeRelatedName(cur.Name) then
                return true
            end
            cur = cur.Parent
        end
        return false
    end

    local function getBlockingObstacle(root, direction, target)
        if not (WOOD_CFG.ObstacleRecoveryEnabled and root and direction) then return nil end
        local flatDirection = Vector3.new(direction.X, 0, direction.Z)
        if flatDirection.Magnitude < 0.1 then return nil end
        flatDirection = flatDirection.Unit
        local side = Vector3.new(-flatDirection.Z, 0, flatDirection.X)

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filters = {}
        if player.Character then table.insert(filters, player.Character) end
        if target then table.insert(filters, target) end
        params.FilterDescendantsInstances = filters
        params.IgnoreWater = true
        pcall(function() params.RespectCanCollide = true end)

        local counts = {}
        local centerHitIdentity = nil
        local heights = {0.35, 1.25, 2.15}
        local lateralOffsets = {-WOOD_CFG.ObstacleRayWidth, 0, WOOD_CFG.ObstacleRayWidth}
        for heightIndex, height in ipairs(heights) do
            for lateralIndex, lateralOffset in ipairs(lateralOffsets) do
                local origin = root.Position + Vector3.new(0, height, 0) + side * lateralOffset
                local hit = workspace:Raycast(origin, flatDirection * WOOD_CFG.ObstacleRayDistance, params)
                if hit and hit.Instance and hit.Instance.CanCollide and hit.Distance >= 1.0 then
                    -- Não considerar o tronco/copa/galhos da árvore como obstáculo.
                    if not isTreePartForObstacleCheck(hit.Instance, target) then
                        local identity = getObstacleIdentity(hit.Instance, target)
                        if identity then
                            counts[identity] = (counts[identity] or 0) + 1
                            if heightIndex == 2 and lateralIndex == 2 then
                                centerHitIdentity = identity
                            end
                        end
                    end
                end
            end
        end

        local best, bestCount = nil, 0
        for identity, count in pairs(counts) do
            if count > bestCount then
                best, bestCount = identity, count
            end
        end
        -- Vários raios concordantes detectam paredes largas; o raio central
        -- também confirma obstáculos estreitos, como postes.
        if best and bestCount >= 2 then return best end
        if centerHitIdentity then return centerHitIdentity end
        return nil
    end

    local function getWoodForwardDirection(root, suggestedDirection)
        local flat = suggestedDirection and Vector3.new(suggestedDirection.X, 0, suggestedDirection.Z)
        if not flat or flat.Magnitude < 0.05 then
            local cam = workspace.CurrentCamera
            local look = cam and cam.CFrame.LookVector or root.CFrame.LookVector
            flat = Vector3.new(look.X, 0, look.Z)
        end
        if flat.Magnitude < 0.05 then
            local look = root.CFrame.LookVector
            flat = Vector3.new(look.X, 0, look.Z)
        end
        if flat.Magnitude < 0.05 then return Vector3.new(0, 0, -1) end
        return flat.Unit
    end

    local function retreatWoodTwoStuds(hum, root, token, forwardDirection)
        if not (isActive(token) and hum and root and hum.Parent and root.Parent) then
            return false
        end

        local startPosition = root.Position
        local backward = -getWoodForwardDirection(root, forwardDirection)
        local destination = startPosition + backward * WOOD_CFG.ObstacleRetreatDistance
        -- Compensa a tolerância de chegada do Humanoid:MoveTo para recuar
        -- aproximadamente 2 studs reais, em vez de parar antes do destino.
        local moveTarget = destination + backward * 0.95
        local reached = false
        local connection = hum.MoveToFinished:Connect(function(success)
            if success then reached = true end
        end)

        hum:MoveTo(moveTarget)
        local deadline = os.clock() + WOOD_CFG.ObstacleRetreatTimeout
        while isActive(token) and hum.Parent and root.Parent do
            local delta = root.Position - destination
            local dist = Vector3.new(delta.X, 0, delta.Z).Magnitude
            if dist <= 0.25 or reached or os.clock() >= deadline then break end
            task.wait(0.025)
        end

        pcall(function() hum:MoveTo(root.Position) end)
        if connection then connection:Disconnect() end
        return isActive(token)
    end

    local function performWoodObstacleRecovery(token, target, forwardDirection, resumePosition)
        if not isActive(token) then
            releaseWoodKeys()
            return false
        end
        if os.clock() - lastObstacleRecoveryAt < WOOD_CFG.ObstacleRecoveryCooldown then
            return false
        end

        local _, hum, root = getChar()
        if not (hum and root) then return false end

        -- Interrompe o avanço atual e libera todas as teclas antes do recuo.
        sendWoodKey(Enum.KeyCode.W, false)
        sendWoodKey(Enum.KeyCode.LeftShift, false)
        sendWoodKey(Enum.KeyCode.Space, false)
        pcall(function() hum:MoveTo(root.Position) end)
        setWalkSpeedBoost(true)

        if not retreatWoodTwoStuds(hum, root, token, forwardDirection) then
            releaseWoodKeys()
            return false
        end

        -- Seis cliques separados: Espaço é solto em cada repetição; não espera
        -- o personagem pousar e não mantém a tecla pressionada.
        for index = 1, WOOD_CFG.ObstacleJumpCount do
            if not isActive(token) then
                releaseWoodKeys()
                return false
            end
            sendWoodKey(Enum.KeyCode.Space, true)
            local pressedAt = os.clock()
            while isActive(token)
                and os.clock() - pressedAt < WOOD_CFG.ObstacleJumpPressDuration do
                task.wait(0.005)
            end
            sendWoodKey(Enum.KeyCode.Space, false)
            if not isActive(token) then
                releaseWoodKeys()
                return false
            end
            if index < WOOD_CFG.ObstacleJumpCount then
                local gapUntil = os.clock() + WOOD_CFG.ObstacleJumpGap
                while isActive(token) and os.clock() < gapUntil do
                    task.wait(0.005)
                end
            end
        end

        -- Depois do sexto clique, não simula W nem Shift esquerdo.
        -- O Auto Wood retoma pelo movimento normal de waypoint (Humanoid:MoveTo).
        sendWoodKey(Enum.KeyCode.Space, false)
        sendWoodKey(Enum.KeyCode.W, false)
        sendWoodKey(Enum.KeyCode.LeftShift, false)
        if resumePosition and isActive(token) then
            pcall(function() hum:MoveTo(resumePosition) end)
        end
        lastObstacleRecoveryAt = os.clock()
        return isActive(token)
    end

    local function walkForwardRecovery(target, token)
        local _, hum, root = getChar()
        if not (hum and root) or not isActive(token) then return false end

        setWalkSpeedBoost(true)
        sendWoodKey(Enum.KeyCode.W, true)
        sendWoodKey(Enum.KeyCode.LeftShift, true)
        local finishAt = os.clock() + WOOD_CFG.NoProgressForwardDuration
        local nextObstacleCheck = 0
        local lastProgressPos = root.Position

        while isActive(token) and os.clock() < finishAt do
            local _, humNow, rootNow = getChar()
            if not (humNow and rootNow) then break end
            local now = os.clock()
            if horizontalDistance(rootNow.Position, lastProgressPos) >= WOOD_CFG.StuckMovementThreshold then
                lastProgressPos = rootNow.Position
            end

            if now >= nextObstacleCheck then
                local cam = workspace.CurrentCamera
                local forward = cam and cam.CFrame.LookVector or rootNow.CFrame.LookVector
                local obstacle = getBlockingObstacle(rootNow, forward, target)
                if obstacle and now - lastObstacleRecoveryAt >= WOOD_CFG.ObstacleRecoveryCooldown then
                    if performWoodObstacleRecovery(token, target, forward, nil) then
                        local _, resumedHum, resumedRoot = getChar()
                        if resumedHum and resumedRoot then
                            lastProgressPos = resumedRoot.Position
                        end
                        -- Conta o período de avanço a partir do fim da recuperação.
                        finishAt = os.clock() + WOOD_CFG.NoProgressForwardDuration
                    end
                end
                nextObstacleCheck = os.clock() + WOOD_CFG.ObstacleCheckInterval
            end
            task.wait(0.05)
        end

        sendWoodKey(Enum.KeyCode.W, false)
        sendWoodKey(Enum.KeyCode.LeftShift, false)
        setWalkSpeedBoost(false)
        return isActive(token)
    end

    local function hasExcludedWoodAncestor(inst)
        local cur = inst.Parent
        while cur and cur ~= workspace do
            if isExcludedWoodName(cur.Name) then
                return true
            end
            cur = cur.Parent
        end
        return false
    end

    -- Confere a caixa de limites do alvo. Árvores precisam ter uma altura mínima,
    -- alguma largura real e proporção vertical compatível com uma árvore/tronco.
    -- A proporção deixa passar a árvore menor da referência, mas rejeita toras no
    -- chão e muitos objetos largos/baixos, como caixas e carroças de madeira.
    local function nameExplicitlySaysTree(name)
        local s = normalizeName(name)
        return s:find("%f[%a]trees?%f[%A]") ~= nil
            or s:find("arvore", 1, true) ~= nil
            or s:find("árvore", 1, true) ~= nil
    end

    local function hasExcludedWoodDescendant(inst)
        if not inst:IsA("Model") then return false end
        local ok, descendants = pcall(function() return inst:GetDescendants() end)
        if not ok or not descendants then return false end
        for _, descendant in ipairs(descendants) do
            if (descendant:IsA("Model") or descendant:IsA("BasePart"))
                and isExcludedWoodName(descendant.Name) then
                -- Evita que um agrupador chamado apenas "Wood" vire alvo quando
                -- na verdade ele contém um baú/carroça/tenda de decoração.
                return true
            end
        end
        return false
    end

    local function isTreeSizedTarget(inst)
        local cf, size = getTargetBox(inst)
        if not cf or not size then return false end
        local height = size.Y
        local width = math.max(size.X, size.Z)
        if height < WOOD_CFG.MinTreeHeight or width < WOOD_CFG.MinTreeWidth then
            return false
        end
        if height > WOOD_CFG.MaxTreeHeight or width > WOOD_CFG.MaxTreeWidth then
            return false
        end
        if height / math.max(width, 0.01) < WOOD_CFG.MinTreeHeightWidthRatio then
            return false
        end

        -- Objetos nomeados explicitamente como Tree/Árvore podem ser uma única
        -- malha. Para nomes genéricos como Wood/Log, exige também uma peça vertical
        -- na região central e inferior, reduzindo falsos positivos como carroças.
        if nameExplicitlySaysTree(inst.Name) then
            return true
        end
        local trunk = findTrunkPart(inst, cf, size)
        if not trunk or not trunk.Parent then return false end
        local centerOffset = Vector3.new(
            trunk.Position.X - cf.Position.X, 0,
            trunk.Position.Z - cf.Position.Z
        ).Magnitude
        return centerOffset <= math.max(width * 0.35, 1.25)
    end

    local function isValidWoodTarget(inst)
        if not inst or not inst.Parent or not inst:IsDescendantOf(workspace) then return false end
        if not (inst:IsA("Model") or inst:IsA("BasePart")) then return false end
        local namedTarget = isWoodName(inst.Name) and not isTreeComponentName(inst.Name)
        if not namedTarget then return false end
        if hasWoodAncestor(inst) or hasLivingAncestor(inst) then return false end
        if hasExcludedWoodAncestor(inst) or hasExcludedWoodDescendant(inst) then return false end
        if hasNamedWoodModelChild(inst) then return false end
        if inst:FindFirstAncestorOfClass("Tool") then return false end
        if player.Character and (inst == player.Character or inst:IsDescendantOf(player.Character)) then
            return false
        end
        if visiblePartCount(inst) <= 0 then return false end
        return isTreeSizedTarget(inst)
    end

    local function findTarget(root, token)
        local now = os.clock()
        local best, bestDist = nil, WOOD_CFG.SearchRadius
        local visited = 0
        for _, inst in ipairs(workspace:GetDescendants()) do
            if not isActive(token) then return nil end
            local candidateByName = (inst:IsA("Model") or inst:IsA("BasePart"))
                and isWoodName(inst.Name) and not isTreeComponentName(inst.Name)
            if candidateByName and isValidWoodTarget(inst) then
                local ignoredUntil = ignored[inst]
                if not ignoredUntil or ignoredUntil <= now then
                    local cf = getTargetBox(inst)
                    if cf then
                        local dist = horizontalDistance(root.Position, cf.Position)
                        if dist < bestDist then
                            best, bestDist = inst, dist
                        end
                    end
                end
            end
            visited = visited + 1
            if visited % 600 == 0 then task.wait() end
        end
        return best
    end

    local function onRenderStep()
        if not AutoWood.Enabled then return end
        local target = AutoWood.Target
        if target and target.Parent and target:IsDescendantOf(workspace) then
            -- Atualiza o ponto em cada frame para manter a mira presa ao tronco,
            -- mesmo quando a árvore muda de tamanho após um golpe.
            local updatedAim = getAimPosition(target)
            if updatedAim then aimTarget = updatedAim end
        end
        if not aimTarget then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local direction = aimTarget - cam.CFrame.Position
        if direction.Magnitude < 0.5 then return end
        if cam.CFrame.LookVector:Dot(direction.Unit) > 0.9997 then return end
        local up = math.abs(direction.Unit.Y) > 0.98 and Vector3.new(0, 0, -1) or Vector3.new(0, 1, 0)
        local desired = CFrame.lookAt(cam.CFrame.Position, aimTarget, up)
        -- Travamento forte e suave: mantém a árvore no centro sem oscilação brusca.
        cam.CFrame = cam.CFrame:Lerp(desired, 0.72)
    end

    local function walkTo(inst, token)
        local _, hum, root = getChar()
        if not (hum and root) then return false end
        local destination, aimPos = getStandPoint(inst, hum, root)
        if not destination then return false end

        local waypoints = nil
        local pathOk, path = pcall(function()
            local p = PathfindingService:CreatePath({
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = true,
                WaypointSpacing = 4,
            })
            p:ComputeAsync(root.Position, destination)
            return p
        end)
        if pathOk and path and path.Status == Enum.PathStatus.Success then
            local okWps, wps = pcall(function() return path:GetWaypoints() end)
            if okWps and wps and #wps > 0 then waypoints = wps end
        end
        if not waypoints then
            waypoints = { { Position = destination, Action = Enum.PathWaypointAction.Walk } }
        end

        setWalkSpeedBoost(true)
        local started = os.clock()
        local function finish(success)
            sendWoodKey(Enum.KeyCode.W, false)
            sendWoodKey(Enum.KeyCode.LeftShift, false)
            sendWoodKey(Enum.KeyCode.Space, false)
            setWalkSpeedBoost(false)
            return success
        end

        local nextObstacleCheck = 0
        for _, waypoint in ipairs(waypoints) do
            if not isActive(token) then return finish(false) end
            if not inst.Parent or not inst:IsDescendantOf(workspace) then return finish(false) end
            local _, currentHum, currentRoot = getChar()
            if not (currentHum and currentRoot) then return finish(false) end
            if waypoint.Action == Enum.PathWaypointAction.Jump then
                pcall(function() currentHum.Jump = true end)
            end
            currentHum:MoveTo(waypoint.Position)
            local lastPos = currentRoot.Position
            local lastProgressAt = os.clock()
            local reached = false

            while isActive(token) and os.clock() - started < WOOD_CFG.WalkTimeout do
                if not inst.Parent or not inst:IsDescendantOf(workspace) then
                    return finish(false)
                end
                local _, humNow, rootNow = getChar()
                if not (humNow and rootNow) then return finish(false) end
                local flatDist = horizontalDistance(rootNow.Position, waypoint.Position)
                if flatDist <= 3.5 and math.abs(rootNow.Position.Y - waypoint.Position.Y) <= 8 then
                    reached = true
                    break
                end
                local now = os.clock()
                if (rootNow.Position - lastPos).Magnitude >= WOOD_CFG.StuckMovementThreshold then
                    lastPos = rootNow.Position
                    lastProgressAt = now
                elseif now - lastProgressAt >= 4 then
                    break
                end

                -- Detecta obstáculos sólidos na direção do waypoint. A mesma parede
                -- pode disparar novamente após o cooldown, sem limite por trajeto.
                if now >= nextObstacleCheck then
                    local direction = waypoint.Position - rootNow.Position
                    local obstacle = getBlockingObstacle(rootNow, direction, inst)
                    if obstacle and now - lastObstacleRecoveryAt >= WOOD_CFG.ObstacleRecoveryCooldown then
                        if performWoodObstacleRecovery(token, inst, direction, waypoint.Position) then
                            local _, resumedHum, resumedRoot = getChar()
                            if resumedHum and resumedRoot then
                                pcall(function() resumedHum:MoveTo(waypoint.Position) end)
                                lastPos = resumedRoot.Position
                                lastProgressAt = os.clock()
                            end
                        end
                    end
                    nextObstacleCheck = os.clock() + WOOD_CFG.ObstacleCheckInterval
                end
                task.wait(0.1)
            end
            if not reached then return finish(false) end
        end

        local _, finalHum, finalRoot = getChar()
        local finalDest = nil
        if finalHum and finalRoot then
            finalDest = getStandPoint(inst, finalHum, finalRoot)
        end
        if finalRoot and finalDest and horizontalDistance(finalRoot.Position, finalDest) <= WOOD_CFG.ArrivalDistance then
            return finish(true)
        end
        -- O fim do caminho pode variar um pouco da posição de parada calculada.
        if finalRoot then
            local currentAim, targetCf, targetSize = getAimPosition(inst)
            if currentAim and targetCf and targetSize then
                local radius = math.clamp(math.max(targetSize.X, targetSize.Z) / 2, 1, 10)
                if horizontalDistance(finalRoot.Position, targetCf.Position) <= radius + WOOD_CFG.ArrivalDistance then
                    return finish(true)
                end
            end
        end
        return finish(false)
    end

    local function performWoodHit(inst, token)
        if not isActive(token) then return false, false end
        local before = getVisualSnapshot(inst)
        if not before then return true, true end

        local aimPos = getAimPosition(inst)
        if not aimPos then return true, true end
        aimTarget = aimPos
        local noticeBefore = collectionNoticeCount
        pcall(function() clickOnce(true) end)

        -- O aviso "Collected Wood" é a confirmação primária do jogo; também
        -- comparamos as propriedades do objeto para reconhecer progresso visual.
        local verifyDelay = math.max(WOOD_CFG.FirstHitVerifyDelay, WOOD_CFG.CollectionNoticeVerifyDelay)
        local verifyUntil = os.clock() + verifyDelay
        while isActive(token) and os.clock() < verifyUntil do
            if collectionNoticeCount > noticeBefore then
                return true, true
            end
            task.wait(0.05)
        end
        if not isActive(token) then return false, false end
        if collectionNoticeCount > noticeBefore then return true, true end

        local after = getVisualSnapshot(inst)
        if not after or after.VisibleCount <= 0 then
            return true, true
        end
        return hasVisualProgress(before, after), false
    end

    local function clickWood(inst, token)
        local attempts = 0
        local completed = false

        -- Primeiro golpe: guarda o estado visual antes de clicar e compara depois.
        local progressed, gone = performWoodHit(inst, token)
        attempts = attempts + 1
        if gone then
            completed = true
        elseif isActive(token) and not progressed then
            -- Uma única recuperação por árvore: avança por cerca de 2 segundos e
            -- verifica novamente o mesmo alvo. Não repete o avanço se já há progresso.
            if walkForwardRecovery(inst, token) and isActive(token) then
                local _, _, root = getChar()
                if root and inst.Parent and inst:IsDescendantOf(workspace) then
                    local aimPos = getAimPosition(inst)
                    if aimPos then aimTarget = aimPos end
                    local progressedAgain, goneAgain = performWoodHit(inst, token)
                    attempts = attempts + 1
                    if goneAgain then
                        completed = true
                    end
                else
                    completed = true
                end
            end
        end

        while isActive(token) and not completed and attempts < WOOD_CFG.MaxClickAttempts do
            if not inst.Parent or not inst:IsDescendantOf(workspace) or visiblePartCount(inst) <= 0 then
                completed = true
                break
            end

            local aimPos = getAimPosition(inst)
            local noticeBefore = collectionNoticeCount
            if aimPos then
                aimTarget = aimPos
                pcall(function() clickOnce(true) end)
            end
            attempts = attempts + 1
            local clickWaitUntil = os.clock() + WOOD_CFG.ClickDelay
            while isActive(token) and os.clock() < clickWaitUntil do
                if collectionNoticeCount > noticeBefore then
                    completed = true
                    break
                end
                task.wait(0.05)
            end
            if collectionNoticeCount > noticeBefore then completed = true end
        end

        aimTarget = nil
        if not isActive(token) then return end
        if completed then
            ignored[inst] = os.clock() + WOOD_CFG.CompletedIgnoreTime
        elseif inst and inst.Parent then
            ignored[inst] = os.clock() + WOOD_CFG.IgnoreTime
        end
    end

    local function step(token)
        if AutoMiner.Enabled or AutoMob.Enabled then
            task.wait(0.3)
            return
        end

        if not ensureWoodAxeEquipped() then
            AutoWood.Target = nil
            aimTarget = nil
            if os.clock() - lastAxeWarningAt >= 5 then
                lastAxeWarningAt = os.clock()
                warn("[RAMDOM HUB] Auto Wood: não encontrei um machado/hatchet equipado ou na mochila.")
            end
            task.wait(0.75)
            return
        end

        local _, _, root = getChar()
        if not root then
            AutoWood.Target = nil
            aimTarget = nil
            task.wait(0.5)
            return
        end

        local target = findTarget(root, token)
        if not target or not isActive(token) then
            task.wait(WOOD_CFG.ScanDelay)
            return
        end

        AutoWood.Target = target
        local arrived = walkTo(target, token)
        if arrived and isActive(token) and target.Parent and target:IsDescendantOf(workspace) then
            clickWood(target, token)
        elseif target and target.Parent then
            ignored[target] = os.clock() + WOOD_CFG.IgnoreTime
        end
        aimTarget = nil
        AutoWood.Target = nil
        task.wait(0.15)
    end

    local function startAutoWood()
        if AutoWood.Enabled then return end
        AutoWood.Enabled = true
        AutoWood.Token = AutoWood.Token + 1
        local token = AutoWood.Token
        for target in pairs(ignored) do ignored[target] = nil end
        aimTarget = nil
        lastObstacleRecoveryAt = -math.huge
        releaseWoodKeys()
        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)
        RunService:BindToRenderStep(STEER_NAME, Enum.RenderPriority.Camera.Value + 1, onRenderStep)

        AutoWood.Thread = task.spawn(function()
            while isActive(token) do
                local ok, err = pcall(step, token)
                if not ok then
                    warn("[RAMDOM HUB] Auto Wood erro: " .. tostring(err))
                    aimTarget = nil
                    AutoWood.Target = nil
                    releaseWoodKeys()
                    releaseWoodMouse()
                    setWalkSpeedBoost(false)
                    task.wait(1.5)
                end
                task.wait(0.05)
            end
        end)
    end

    local function stopAutoWood()
        if not AutoWood.Enabled then return end
        AutoWood.Enabled = false
        AutoWood.Token = AutoWood.Token + 1
        -- Libera imediatamente os inputs antes de cancelar qualquer rotina suspensa.
        releaseWoodKeys()
        releaseWoodMouse()
        if AutoWood.Thread then
            pcall(task.cancel, AutoWood.Thread)
            AutoWood.Thread = nil
        end
        AutoWood.Target = nil
        aimTarget = nil
        setWalkSpeedBoost(false)
        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)
        local _, hum, root = getChar()
        if hum and root then
            pcall(function() hum:MoveTo(root.Position) end)
        end
    end

    AutoWood.Start = startAutoWood
    AutoWood.Stop = stopAutoWood
end

--// ==========================================
--// AUTO FISH — LANÇAMENTO + CONTROLE DO MINIJOGO
--// Cache de candidatos para reduzir varreduras; controle por mouse segurado.
--// ==========================================
local FISH_CFG = {
    -- Loop e varredura mais lentos; posições dos elementos cacheados atualizam automaticamente.
    -- Loop leve; o marcador já cacheado é atualizado a cada TickRate sem rescanner toda a UI.
    TickRate = 0.08,
    HubScanInterval = 0.75,
    HubRescanInterval = 2.0,
    CastRetryDelay = 6.0,
    -- Aguarda a UI da captura fechar antes de preparar outro lançamento.
    PostCatchCastDelay = 2.5,
    PostCatchQuietTime = 2.0,
    HubLossGraceInterval = 0.40,
    NoRodRetryDelay = 1.5,
    NoWaterRetryDelay = 3.0,
    CastSettleDelay = 0.22,
    CenterTolerancePx = 4,
    WaterRayLength = 1200,
    -- A mecânica do minijogo usa clique mantido para elevar o marcador amarelo.
    YellowMarkerNameHints = {"yellow", "cursor", "indicator", "needle", "marker", "playerbar", "player_bar"},
    BlueTargetNameHints = {"blue", "fish", "target", "zone", "safe", "fishbar", "fish_bar"},
}

local AutoFishing = {
    Enabled = false,
    Token = 0,
    Thread = nil,
    Status = "desligado",
    Start = nil,
    Stop = nil,
}

do
    local mouseHeld = false
    local mouseBackend = nil
    local mousePosition = nil
    local lastCastAt = -math.huge
    local postCatchQuietUntil = 0
    local statusLastWarn = ""
    local nextGuiTrackingCheck = 0
    -- GUI objects são cacheados por eventos: evita chamar GetDescendants() repetidamente.
    local candidateGuiObjects = setmetatable({}, {__mode = "k"})
    local trackedRoots = setmetatable({}, {__mode = "k"})
    local trackingConnections = {}

    local function isActive(token)
        return AutoFishing.Enabled and AutoFishing.Token == token
    end

    local function containsAny(value, hints)
        value = string.lower(tostring(value or ""))
        for _, hint in ipairs(hints) do
            if value:find(hint, 1, true) then return true end
        end
        return false
    end

    local function isOurGui(inst)
        if not inst then return false end
        if ScreenGui then
            local ok, result = pcall(function()
                return inst == ScreenGui or inst:IsDescendantOf(ScreenGui)
            end)
            if ok and result then return true end
        end
        local current = inst
        while current and current ~= game do
            if current.Name == "FlyUI" or current.Name == "FlyToggle" then return true end
            current = current.Parent
        end
        return false
    end

    local function isVisibleGuiObject(obj)
        if not obj or not obj:IsA("GuiObject") or isOurGui(obj) then return false end
        local current = obj
        while current and current ~= game do
            if current:IsA("GuiObject") and not current.Visible then return false end
            if current:IsA("ScreenGui") and not current.Enabled then return false end
            current = current.Parent
        end
        return true
    end

    local function getObjectText(obj)
        local chunks = {tostring(obj.Name or "")}
        pcall(function()
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                table.insert(chunks, obj.Text)
            end
        end)
        return string.lower(table.concat(chunks, " "))
    end

    local function colorIsYellow(c)
        return c and c.R >= 0.62 and c.G >= 0.38 and c.B <= 0.42
            and c.R >= c.B * 1.45
    end

    local function colorIsBlueOrPurple(c)
        if not c then return false end
        local blue = c.B >= 0.26 and c.B >= c.R * 1.12 and c.B >= c.G * 1.07
        local purple = c.R >= 0.22 and c.B >= 0.25 and c.B >= c.G * 1.20 and c.R >= c.G * 1.18
        return blue or purple
    end

    local function getGuiColor(obj)
        local bg, img
        pcall(function()
            if obj.BackgroundTransparency < 0.85 then bg = obj.BackgroundColor3 end
        end)
        pcall(function()
            if (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) and obj.ImageTransparency < 0.8 then
                img = obj.ImageColor3
            end
        end)
        if bg and (colorIsYellow(bg) or colorIsBlueOrPurple(bg)) then return bg end
        if img and (colorIsYellow(img) or colorIsBlueOrPurple(img)) then return img end
        return bg or img
    end

    local function isYellowMarker(obj)
        local size = obj.AbsoluteSize
        if size.X < 10 or size.Y < 3 or size.X < size.Y * 1.25 then return false end
        local text = getObjectText(obj)
        local c = getGuiColor(obj)
        return colorIsYellow(c) or containsAny(text, FISH_CFG.YellowMarkerNameHints)
    end

    local function isBlueTarget(obj)
        local size = obj.AbsoluteSize
        if size.X < 7 or size.Y < 9 or size.X > 210 or size.Y > 210 then return false end
        local text = getObjectText(obj)
        local c = getGuiColor(obj)
        local shapeFits = size.Y >= size.X * 0.58 or containsAny(text, FISH_CFG.BlueTargetNameHints)
        return shapeFits and (colorIsBlueOrPurple(c) or containsAny(text, FISH_CFG.BlueTargetNameHints))
    end

    -- Mantém somente elementos com formato, cor ou nomes plausíveis para o minijogo.
    -- Isso evita reavaliar centenas/milhares de elementos de UI em cada varredura.
    local function isPotentialFishingGui(obj)
        if not obj or not obj:IsA("GuiObject") or isOurGui(obj) then return false end
        local size = obj.AbsoluteSize
        local text = getObjectText(obj)
        if containsAny(text, {
            "yellow", "marker", "needle", "cursor", "indicator", "playerbar", "player_bar",
            "blue", "fish", "target", "zone", "safe", "fishbar", "fish_bar",
            "fishing", "minigame", "reel"
        }) then
            return true
        end

        local c = getGuiColor(obj)
        local yellow = colorIsYellow(c)
        local blue = colorIsBlueOrPurple(c)
        local horizontalMarker = size.X >= 10 and size.X <= 320
            and size.Y >= 3 and size.Y <= 55 and size.X >= size.Y * 1.25
        local verticalTarget = size.X >= 8 and size.X <= 190
            and size.Y >= 14 and size.Y <= 190 and size.Y >= size.X * 0.55
        if yellow and horizontalMarker then return true end
        if blue and verticalTarget then return true end
        -- Inclui barras horizontais sem cor exposta; o pareamento exige que estejam no trilho do alvo.
        if horizontalMarker and (obj:IsA("Frame") or obj:IsA("ImageLabel") or obj:IsA("ImageButton")) then
            return true
        end

        -- Alguns minijogos usam ImageLabel/Frame com tintura branca ou transparente.
        if verticalTarget and (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) then
            local hasImage = false
            pcall(function() hasImage = obj.Image ~= "" end)
            if hasImage then return true end
        end
        if verticalTarget and obj:IsA("Frame") then
            local visibleBackground = false
            pcall(function() visibleBackground = obj.BackgroundTransparency < 0.85 end)
            if visibleBackground then return true end
        end
        return false
    end

    local function registerGuiObject(obj)
        if not obj or not obj:IsA("GuiObject") then return end
        if isPotentialFishingGui(obj) then
            candidateGuiObjects[obj] = true
        else
            -- Só agenda uma rechecagem se o layout ainda não calculou o tamanho.
            local size = obj.AbsoluteSize
            if size.X <= 0 or size.Y <= 0 then
                task.defer(function()
                    if obj.Parent and isPotentialFishingGui(obj) then
                        candidateGuiObjects[obj] = true
                    end
                end)
            end
        end
    end

    local function getLaneAncestor(marker, target)
        local current = marker.Parent
        while current and current ~= game do
            if current:IsA("GuiObject") and target:IsDescendantOf(current) then
                local size = current.AbsoluteSize
                if size.Y >= 140 and size.Y >= size.X * 1.35
                    and size.X >= 20 and size.X <= 300 then
                    return current
                end
            end
            if current:IsA("ScreenGui") then break end
            current = current.Parent
        end
        return nil
    end

    local function trackGuiRoot(root)
        if not root or trackedRoots[root] then return end
        trackedRoots[root] = true
        -- Conecta antes da leitura inicial para não perder elementos criados durante a ativação.
        pcall(function()
            table.insert(trackingConnections, root.DescendantAdded:Connect(function(obj)
                if obj:IsA("GuiObject") then registerGuiObject(obj) end
            end))
            table.insert(trackingConnections, root.DescendantRemoving:Connect(function(obj)
                if obj:IsA("GuiObject") then
                    candidateGuiObjects[obj] = nil
                end
            end))
            -- Indexa em lotes num thread separado para não congelar a ativação do toggle.
            task.spawn(function()
                local ok, descendants = pcall(function() return root:GetDescendants() end)
                if not ok or not descendants then return end
                for index, obj in ipairs(descendants) do
                    if obj and obj.Parent and obj:IsA("GuiObject") then
                        registerGuiObject(obj)
                    end
                    if index % 180 == 0 then task.wait() end
                end
            end)
        end)
    end

    local function ensureGuiTracking()
        -- Checa novas raízes no máximo uma vez a cada 3 s; não percorre CoreGui a cada scan.
        local now = os.clock()
        if now < nextGuiTrackingCheck then return end
        nextGuiTrackingCheck = now + 3.0
        local playerGui = player:FindFirstChildOfClass("PlayerGui")
        if playerGui then trackGuiRoot(playerGui) end
        -- Só acompanha ScreenGuis do CoreGui com nome diretamente relacionado à pesca.
        pcall(function()
            for _, child in ipairs(CoreGui:GetChildren()) do
                if child:IsA("ScreenGui") and not isOurGui(child)
                    and containsAny(child.Name, {"fish", "fishing", "reel"}) then
                    trackGuiRoot(child)
                end
            end
        end)
    end

    local function collectGuiObjects()
        ensureGuiTracking()
        local objects = {}
        local namedHub = false
        local screenHints = {"fishing", "fishminigame", "fishingminigame", "reelgame", "fishinghud"}
        local textHints = {"fishing minigame", "fishingminigame", "cast your line", "reel in", "keep reeling", "fish caught"}
        -- ScreenGui costuma ser filho direto do CoreGui/PlayerGui; não varre a árvore toda aqui.
        local roots = {CoreGui}
        local playerGui = player:FindFirstChildOfClass("PlayerGui")
        if playerGui then table.insert(roots, playerGui) end
        for _, root in ipairs(roots) do
            pcall(function()
                for _, inst in ipairs(root:GetChildren()) do
                    if inst:IsA("ScreenGui") and inst.Enabled and not isOurGui(inst)
                        and containsAny(inst.Name, screenHints) then
                        namedHub = true
                    end
                end
            end)
        end
        for obj in pairs(candidateGuiObjects) do
            if obj and obj.Parent and obj:IsA("GuiObject") and isVisibleGuiObject(obj) then
                table.insert(objects, obj)
                if not namedHub and containsAny(getObjectText(obj), textHints) then
                    namedHub = true
                end
            elseif not (obj and obj.Parent) then
                candidateGuiObjects[obj] = nil
            end
        end
        return objects, namedHub
    end

    local function looksLikeUncoloredTarget(obj)
        if not (obj:IsA("ImageLabel") or obj:IsA("ImageButton") or obj:IsA("Frame")) then return false end
        local size = obj.AbsoluteSize
        if size.X < 8 or size.Y < 14 or size.Y > 190 or size.Y < size.X * 0.55 then return false end
        local text = getObjectText(obj)
        if containsAny(text, {"tick", "arrow", "border", "background", "outline", "progress", "rail", "needle", "marker", "line", "textlabel", "namelabel", "healthlabel"}) then
            return false
        end
        local c = getGuiColor(obj)
        if colorIsYellow(c) then return false end
        if containsAny(text, FISH_CFG.BlueTargetNameHints) then return true end
        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            local hasImage = false
            pcall(function() hasImage = obj.Image ~= "" end)
            if hasImage then return true end
        end
        -- Fallback for a colored Frame whose asset color is not exposed by ImageColor3.
        local backgroundVisible = false
        pcall(function() backgroundVisible = obj.BackgroundTransparency < 0.85 end)
        return backgroundVisible
    end

    local function looksLikeUncoloredMarker(obj, target)
        if not (obj:IsA("ImageLabel") or obj:IsA("ImageButton") or obj:IsA("Frame")) then return false end
        local size = obj.AbsoluteSize
        if size.X < 12 or size.X > 320 or size.Y < 3 or size.Y > 45
            or size.X < size.Y * 1.25 then return false end
        local text = getObjectText(obj)
        if containsAny(text, {"background", "outline", "border", "rail", "track", "container", "textlabel", "namelabel", "tick", "arrow", "progress", "fill"}) then
            return false
        end
        local c = getGuiColor(obj)
        if colorIsBlueOrPurple(c) and not colorIsYellow(c) then return false end
        local lane = getLaneAncestor(obj, target)
        if not lane then return false end
        if size.X < lane.AbsoluteSize.X * 0.40 or size.X > lane.AbsoluteSize.X * 1.25 then return false end
        return true, lane
    end

    local function scanFishingHub()
        local objects, namedHub = collectGuiObjects()
        local explicitMarkers, fallbackMarkers = {}, {}
        local explicitBlue, fallbackBlue = {}, {}
        local MAX_FALLBACK_CANDIDATES = 20

        -- Passagem leve: prioriza somente cor/nome explícitos; evita calcular fallbacks para tudo.
        for _, obj in ipairs(objects) do
            local size = obj.AbsoluteSize
            if isYellowMarker(obj) then
                table.insert(explicitMarkers, obj)
            elseif (obj:IsA("Frame") or obj:IsA("ImageLabel") or obj:IsA("ImageButton"))
                and size.X >= 12 and size.X <= 320 and size.Y >= 3 and size.Y <= 45
                and size.X >= size.Y * 1.25 and #fallbackMarkers < MAX_FALLBACK_CANDIDATES then
                table.insert(fallbackMarkers, obj)
            end

            if isBlueTarget(obj) then
                table.insert(explicitBlue, obj)
            end
        end

        -- Só faz a análise geométrica mais cara se a cor/nome não encontrou alvo azul.
        if #explicitBlue == 0 then
            for _, obj in ipairs(objects) do
                if looksLikeUncoloredTarget(obj) then
                    table.insert(fallbackBlue, obj)
                    if #fallbackBlue >= MAX_FALLBACK_CANDIDATES then break end
                end
            end
        end

        local possibleMarkers = #explicitMarkers > 0 and explicitMarkers or fallbackMarkers
        local blue = #explicitBlue > 0 and explicitBlue or fallbackBlue
        local explicitMarkerSet, explicitBlueSet = {}, {}
        for _, obj in ipairs(explicitMarkers) do explicitMarkerSet[obj] = true end
        for _, obj in ipairs(explicitBlue) do explicitBlueSet[obj] = true end

        local bestPair, bestScore = nil, math.huge
        for _, marker in ipairs(possibleMarkers) do
            for _, target in ipairs(blue) do
                if marker ~= target then
                    local markerIsYellow = explicitMarkerSet[marker] == true
                    local inferredLane = nil
                    if not markerIsYellow then
                        markerIsYellow, inferredLane = looksLikeUncoloredMarker(marker, target)
                    end
                    if markerIsYellow then
                        local mx = marker.AbsolutePosition.X + marker.AbsoluteSize.X * 0.5
                        local tx = target.AbsolutePosition.X + target.AbsoluteSize.X * 0.5
                        local lane = inferredLane or getLaneAncestor(marker, target)
                        if lane then
                            local laneCenterX = lane.AbsolutePosition.X + lane.AbsoluteSize.X * 0.5
                            local horizontalGap = math.abs(mx - tx)
                            local withinLane = math.abs(mx - laneCenterX) <= lane.AbsoluteSize.X * 0.75
                                and math.abs(tx - laneCenterX) <= lane.AbsoluteSize.X * 0.75
                            if withinLane and horizontalGap <= math.max(95, lane.AbsoluteSize.X * 0.85) then
                                local score = lane.AbsoluteSize.Y + horizontalGap * 1.5
                                if not explicitMarkerSet[marker] then score = score + 180 end
                                if not explicitBlueSet[target] then score = score + 120 end
                                if score < bestScore then
                                    bestScore = score
                                    bestPair = {Marker = marker, Target = target, Lane = lane}
                                end
                            end
                        end
                    end
                end
            end
        end

        return bestPair, namedHub or bestPair ~= nil
    end

    local function isPairUsable(pair)
        if not pair or not pair.Marker or not pair.Target or not pair.Lane then return false end
        local ok, visible = pcall(function()
            return pair.Marker.Parent ~= nil and pair.Target.Parent ~= nil and pair.Lane.Parent ~= nil
                and isVisibleGuiObject(pair.Marker) and isVisibleGuiObject(pair.Target)
                and isVisibleGuiObject(pair.Lane)
        end)
        return ok and visible
    end

    local function pointInsideOurPanel(pos)
        if not pos or not (ScreenGui and Main and ScreenGui.Enabled) then return false end
        local ok, inside = pcall(function()
            local p, z = Main.AbsolutePosition, Main.AbsoluteSize
            return pos.X >= p.X and pos.X <= p.X + z.X
                and pos.Y >= p.Y and pos.Y <= p.Y + z.Y
        end)
        return ok and inside
    end

    local function isWaterHit(hit)
        if not hit then return false end
        if hit.Material == Enum.Material.Water then return true end
        local inst = hit.Instance
        if not inst then return false end
        local nameBits = {inst.Name}
        local parent = inst.Parent
        for _ = 1, 2 do
            if not parent then break end
            table.insert(nameBits, parent.Name)
            parent = parent.Parent
        end
        return containsAny(table.concat(nameBits, " "), {
            "water", "ocean", "sea", "river", "lake", "pond", "water_surface", "water surface"
        })
    end

    -- Procura pixels cuja linha de visão termina na água visível. Só é executado quando for lançar.
    local function findWaterScreenPosition()
        local cam = workspace.CurrentCamera
        if not cam then return nil end
        local vp = cam.ViewportSize
        if vp.X < 10 or vp.Y < 10 then return nil end
        local character = player.Character
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = character and {character} or {}
        params.IgnoreWater = false

        -- Grade menor de raycasts por lançamento para evitar picos de CPU depois da captura.
        local xFractions = {0.22, 0.36, 0.50, 0.64, 0.78, 0.92}
        local yFractions = {0.56, 0.69, 0.82, 0.91}
        local bestPos, bestScore = nil, math.huge
        for _, yf in ipairs(yFractions) do
            for _, xf in ipairs(xFractions) do
                local pos = Vector2.new(vp.X * xf, vp.Y * yf)
                if not pointInsideOurPanel(pos) then
                    local ok, ray, hit = pcall(function()
                        local r = cam:ViewportPointToRay(pos.X, pos.Y)
                        return r, workspace:Raycast(r.Origin, r.Direction * FISH_CFG.WaterRayLength, params)
                    end)
                    if ok and hit and isWaterHit(hit) then
                        -- Preferência por água visível perto do centro inferior da visão, sem mirar o HUD.
                        local score = math.abs(xf - 0.52) * 1.0
                            + math.abs(yf - 0.70) * 0.75
                            + math.min(hit.Distance / FISH_CFG.WaterRayLength, 1) * 0.12
                        if score < bestScore then
                            bestScore, bestPos = score, pos
                        end
                    end
                end
            end
        end
        return bestPos
    end

    local function clickFishingAt(pos)
        if not pos then return false end
        local x, y = math.floor(pos.X), math.floor(pos.Y)
        local clicked = false
        if CombatCfg.ClickVIM then
            local downOk = pcall(function()
                VirtualInputManager:SendMouseMoveEvent(x, y, game)
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
            end)
            if downOk then
                task.wait(0.035)
                pcall(function() VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0) end)
                clicked = true
            else
                -- Libera mesmo se a chamada de clique falhar parcialmente.
                pcall(function() VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0) end)
            end
        end
        if not clicked and CombatCfg.ClickVirtualUser then
            local cam = workspace.CurrentCamera
            local cf = cam and cam.CFrame or CFrame.new()
            local ok = pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:Button1Down(pos, cf)
                task.wait(0.035)
                VirtualUser:Button1Up(pos, cf)
            end)
            clicked = ok
            if not ok then pcall(function() VirtualUser:Button1Up(pos, cf) end) end
        end
        return clicked
    end

    local function sendMouseHeld(state, preferredPosition)
        if state == mouseHeld then return end
        if state then
            local pos = preferredPosition or getClickPosition()
            if not pos then
                local cam = workspace.CurrentCamera
                local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
                pos = Vector2.new(vp.X * 0.80, vp.Y * 0.50)
            end
            local x, y = math.floor(pos.X), math.floor(pos.Y)
            local backend = nil
            if CombatCfg.ClickVIM then
                local ok = pcall(function()
                    VirtualInputManager:SendMouseMoveEvent(x, y, game)
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
                end)
                if ok then backend = "VIM" end
            end
            if not backend and CombatCfg.ClickVirtualUser then
                local ok = pcall(function()
                    local cam = workspace.CurrentCamera
                    VirtualUser:CaptureController()
                    VirtualUser:Button1Down(pos, cam and cam.CFrame or CFrame.new())
                end)
                if ok then backend = "VirtualUser" end
            end
            if backend then
                mouseHeld = true
                mouseBackend = backend
                mousePosition = pos
            else
                -- Não marca como pressionado se nenhum backend aceitou o comando.
                mouseHeld = false
                mouseBackend = nil
                mousePosition = nil
            end
        else
            local pos = mousePosition or preferredPosition or getClickPosition()
            if pos and mouseBackend == "VIM" then
                pcall(function() VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0) end)
            elseif pos and mouseBackend == "VirtualUser" then
                pcall(function()
                    local cam = workspace.CurrentCamera
                    VirtualUser:Button1Up(pos, cam and cam.CFrame or CFrame.new())
                end)
            end
            if pos then
                pcall(function() VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0) end)
            end
            mouseHeld = false
            mouseBackend = nil
            mousePosition = nil
        end
    end

    local function getFishingRod()
        local character = player.Character
        local backpack = player:FindFirstChildOfClass("Backpack")
        local function matches(tool)
            if not tool or not tool:IsA("Tool") then return false end
            local n = string.lower(tool.Name)
            return n:find("rod", 1, true) ~= nil
                or n:find("fishing", 1, true) ~= nil
                or n:find("fishingpole", 1, true) ~= nil
                or n:find("fish pole", 1, true) ~= nil
                or n:find("pole", 1, true) ~= nil
        end
        if character then
            for _, item in ipairs(character:GetChildren()) do
                if matches(item) then return item, true end
            end
        end
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if matches(item) then return item, false end
            end
        end
        return nil, false
    end

    local function ensureRodEquipped()
        local tool, equipped = getFishingRod()
        if not tool then return false end
        if equipped then return true end
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function() humanoid:EquipTool(tool) end)
            task.wait(0.25)
            local equippedTool, isEquipped = getFishingRod()
            return equippedTool ~= nil and isEquipped
        end
        return false
    end

    local function startAutoFishing()
        if AutoFishing.Enabled then return end
        AutoFishing.Enabled = true
        AutoFishing.Token = AutoFishing.Token + 1
        local token = AutoFishing.Token
        lastCastAt = -math.huge
        postCatchQuietUntil = 0
        statusLastWarn = ""
        ensureGuiTracking()
        AutoFishing.Status = "procurando vara, água e hub de pesca"
        AutoFishing.Thread = task.spawn(function()
            local cachedPair, cachedHubVisible = nil, false
            local nextHubScanAt = 0
            local hubMissingSince = nil
            while isActive(token) do
                local now = os.clock()
                local inPostCatchQuiet = now < postCatchQuietUntil
                -- A posição muda sem trocar a instância: reutiliza o par e só rescaneia ocasionalmente.
                if not inPostCatchQuiet and cachedPair and not isPairUsable(cachedPair) then
                    -- Não force uma varredura cara no mesmo frame em que o hub fecha.
                    -- Mantém a transição por uma pequena janela para liberar o mouse sem recastar já.
                    cachedPair = nil
                    nextHubScanAt = now + FISH_CFG.HubLossGraceInterval
                end
                if not inPostCatchQuiet and now >= nextHubScanAt then
                    local previouslyVisible = cachedHubVisible
                    local ok, pair, hubVisible = pcall(scanFishingHub)
                    if ok then
                        if pair and isPairUsable(pair) then
                            cachedPair = pair
                        elseif not isPairUsable(cachedPair) then
                            cachedPair = nil
                        end
                        cachedHubVisible = (cachedPair ~= nil) or hubVisible
                    elseif not isPairUsable(cachedPair) then
                        cachedPair, cachedHubVisible = nil, false
                    end
                    local pairStillValid = isPairUsable(cachedPair)
                    nextHubScanAt = now + (pairStillValid and FISH_CFG.HubRescanInterval or FISH_CFG.HubScanInterval)
                    if cachedHubVisible then
                        hubMissingSince = nil
                    elseif previouslyVisible then
                        hubMissingSince = now
                    end
                    if not cachedHubVisible and hubMissingSince and now - hubMissingSince >= 0.60 then
                        -- Confirma que a captura terminou, mas espera antes de relançar.
                        -- Antes, -math.huge provocava raycasts + clique imediatamente após sumir o hub.
                        lastCastAt = now - FISH_CFG.CastRetryDelay + FISH_CFG.PostCatchCastDelay
                        postCatchQuietUntil = now + FISH_CFG.PostCatchQuietTime
                        hubMissingSince = nil
                    end
                end
                local pair, hubVisible = cachedPair, cachedHubVisible

                if hubVisible then
                    if pair and pair.Marker and pair.Target
                        and pair.Marker.Parent and pair.Target.Parent then
                        local marker = pair.Marker
                        local target = pair.Target
                        local markerY = marker.AbsolutePosition.Y + marker.AbsoluteSize.Y * 0.5
                        local targetY = target.AbsolutePosition.Y + target.AbsoluteSize.Y * 0.5
                        local delta = markerY - targetY
                        local tolerance = math.max(FISH_CFG.CenterTolerancePx, target.AbsoluteSize.Y * 0.10)
                        local lane = pair.Lane
                        local laneCenter = Vector2.new(
                            lane.AbsolutePosition.X + lane.AbsoluteSize.X * 0.5,
                            lane.AbsolutePosition.Y + lane.AbsoluteSize.Y * 0.5
                        )
                        -- O evento de mouse é enviado no trilho do minijogo, não numa posição genérica.
                        -- Marcador abaixo da bola azul: manter pressionado para subir; acima: soltar.
                        if delta > tolerance then
                            sendMouseHeld(true, laneCenter)
                            AutoFishing.Status = "minijogo: segurando para elevar a linha amarela"
                        elseif delta < -tolerance then
                            sendMouseHeld(false, laneCenter)
                            AutoFishing.Status = "minijogo: soltando para baixar a linha amarela"
                        else
                            -- Dentro da tolerância, sempre solta: evita ficar segurando após alinhar.
                            sendMouseHeld(false, laneCenter)
                            AutoFishing.Status = "minijogo detectado; marcador alinhado ao alvo"
                        end
                    else
                        sendMouseHeld(false)
                        AutoFishing.Status = "hub detectado; procurando linha amarela/faixa azul"
                    end
                else
                    sendMouseHeld(false)
                    AutoFishing.Status = "aguardando hub de pesca"
                    if os.clock() - lastCastAt >= FISH_CFG.CastRetryDelay then
                        if ensureRodEquipped() then
                            -- Procura água visível e lança clicando na coordenada de tela correspondente.
                            local waterPos = findWaterScreenPosition()
                            if waterPos then
                                AutoFishing.Status = "água detectada; lançando a vara"
                                if clickFishingAt(waterPos) then
                                    lastCastAt = os.clock()
                                    task.wait(FISH_CFG.CastSettleDelay)
                                else
                                    lastCastAt = os.clock()
                                    AutoFishing.Status = "falha ao clicar na água; tentando novamente"
                                end
                            else
                                -- Não clica em posição aleatória: espera e volta a procurar água.
                                lastCastAt = os.clock() - FISH_CFG.CastRetryDelay + FISH_CFG.NoWaterRetryDelay
                                AutoFishing.Status = "água não visível; ajuste a câmera para a água"
                            end
                        else
                            -- Só tenta de novo com intervalo: evita clicar na tela sem uma vara equipada.
                            lastCastAt = os.clock() - FISH_CFG.CastRetryDelay + FISH_CFG.NoRodRetryDelay
                            if statusLastWarn ~= "rod" then
                                statusLastWarn = "rod"
                                warn("[RAMDOM HUB] Auto Fish: equipe uma vara de pesca para iniciar.")
                            end
                        end
                    end
                end
                task.wait(FISH_CFG.TickRate)
            end
            sendMouseHeld(false)
            AutoFishing.Status = "desligado"
            AutoFishing.Thread = nil
        end)
    end

    local function stopAutoFishing()
        if not AutoFishing.Enabled then
            sendMouseHeld(false)
            return
        end
        AutoFishing.Enabled = false
        AutoFishing.Token = AutoFishing.Token + 1
        sendMouseHeld(false)
        if AutoFishing.Thread then
            pcall(task.cancel, AutoFishing.Thread)
            AutoFishing.Thread = nil
        end
        AutoFishing.Status = "desligado"
    end

    AutoFishing.Start = startAutoFishing
    AutoFishing.Stop = stopAutoFishing
end

--// AUTO RAID — VOO ESTÁVEL (SEM ASSISTÊNCIA DE MIRA INTEGRADA)
--// ==========================================
do
    local STEER_NAME = "RamdomHubAutoRaidPoseLock"
    local activeRoot, activeHumanoid = nil, nil
    local bodyPosition, bodyGyro = nil, nil
    local orientationLockConnection = nil
    local savedPlatformStand, savedAutoRotate = nil, nil
    local hoverAnchor = nil
    local targetGroundY = nil
    local groundBaseY = nil
    local appliedHoverHeight = nil
    local currentHoverY = nil
    local lastGroundScan = 0

    local function isActive(token)
        return AutoRaid.Enabled and AutoRaid.Token == token
    end

    local function getCharacter()
        local char = player.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            return char, hum, root
        end
        return nil
    end

    -- Mantém o personagem deitado e voltado para baixo sem depender do alvo de mira.
    local function getProneFacingCFrame(root)
        if not (root and root.Parent) then return CFrame.new() end
        local forward = root.CFrame.LookVector
        local headDirection = Vector3.new(forward.X, 0, forward.Z)
        if headDirection.Magnitude < 0.05 then
            headDirection = Vector3.new(0, 0, -1)
        end
        local faceDown = root.Position + Vector3.new(0, -1, 0)
        return CFrame.lookAt(root.Position, faceDown, headDirection.Unit)
    end

    local function findGroundY(char, root)
        if not (char and root) then return nil end
        local filters = {char}
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = false
        params.RespectCanCollide = true
        local origin = root.Position + Vector3.new(0, 3, 0)
        for _ = 1, 6 do
            params.FilterDescendantsInstances = filters
            local result = workspace:Raycast(origin, Vector3.new(0, -1500, 0), params)
            if not result then return nil end
            local hitModel = result.Instance and result.Instance:FindFirstAncestorOfClass("Model")
            local hitHumanoid = hitModel and hitModel:FindFirstChildOfClass("Humanoid")
            if hitHumanoid then
                table.insert(filters, hitModel)
            else
                return result.Position.Y
            end
        end
        return nil
    end

    local function removeHoverForces()
        if bodyPosition then pcall(function() bodyPosition:Destroy() end) end
        if bodyGyro then pcall(function() bodyGyro:Destroy() end) end
        bodyPosition, bodyGyro = nil, nil

        if activeHumanoid and activeHumanoid.Parent then
            pcall(function()
                if savedPlatformStand ~= nil then activeHumanoid.PlatformStand = savedPlatformStand end
                if savedAutoRotate ~= nil then activeHumanoid.AutoRotate = savedAutoRotate end
                if not activeHumanoid.PlatformStand then
                    activeHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end)
        end
        activeRoot, activeHumanoid = nil, nil
        savedPlatformStand, savedAutoRotate = nil, nil
        hoverAnchor, targetGroundY, currentHoverY = nil, nil, nil
        groundBaseY, appliedHoverHeight = nil, nil
        lastGroundScan = 0
    end

    local function attachHover(char, hum, root)
        removeHoverForces()
        activeRoot, activeHumanoid = root, hum
        savedPlatformStand = hum.PlatformStand
        savedAutoRotate = hum.AutoRotate
        local groundY = findGroundY(char, root)
        groundBaseY = groundY or root.Position.Y
        appliedHoverHeight = AutoRaid.HoverHeight
        targetGroundY = groundBaseY + AutoRaid.HoverHeight

        -- Teleporta para a altura selecionada, mantendo a posição horizontal.
        local yOffset = targetGroundY - root.Position.Y
        root.CFrame = root.CFrame + Vector3.new(0, yOffset, 0)
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)

        hoverAnchor = Vector3.new(root.Position.X, root.Position.Y, root.Position.Z)
        currentHoverY = targetGroundY
        lastGroundScan = os.clock()

        local bp = Instance.new("BodyPosition")
        bp.Name = "RamdomHubAutoRaidPosition"
        bp.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        bp.P = 30000
        bp.D = 1800
        bp.Position = Vector3.new(hoverAnchor.X, currentHoverY, hoverAnchor.Z)
        bp.Parent = root
        bodyPosition = bp

        local bg = Instance.new("BodyGyro")
        bg.Name = "RamdomHubAutoRaidGyro"
        bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        bg.P = 18000
        bg.D = 1200
        bg.CFrame = getProneFacingCFrame(root)
        bg.Parent = root
        bodyGyro = bg

        pcall(function()
            hum.AutoRotate = false
            hum.PlatformStand = true
            hum:ChangeState(Enum.HumanoidStateType.Physics)
        end)
    end

    local function enforceProneOrientation()
        if not AutoRaid.Enabled or not (activeRoot and activeRoot.Parent) then return end
        local lockedCFrame = getProneFacingCFrame(activeRoot)
        if bodyGyro and bodyGyro.Parent == activeRoot then
            bodyGyro.CFrame = lockedCFrame
        end
        pcall(function()
            activeRoot.CFrame = lockedCFrame
            activeRoot.AssemblyAngularVelocity = Vector3.zero
            if activeHumanoid and activeHumanoid.Parent then
                activeHumanoid.AutoRotate = false
                activeHumanoid.PlatformStand = true
            end
        end)
    end

    local function onRenderStep()
        if AutoRaid.Enabled then
            enforceProneOrientation()
        end
    end

    local function startAutoRaid()
        if AutoRaid.Enabled then return end
        AutoRaid.Enabled = true
        AutoRaid.Token = AutoRaid.Token + 1
        local token = AutoRaid.Token
        AutoRaid.Target = nil
        AutoRaid.AimPosition = nil
        removeHoverForces()

        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)
        RunService:BindToRenderStep(STEER_NAME, Enum.RenderPriority.Camera.Value + 2, onRenderStep)
        if orientationLockConnection then
            pcall(function() orientationLockConnection:Disconnect() end)
            orientationLockConnection = nil
        end
        orientationLockConnection = RunService.PreSimulation:Connect(enforceProneOrientation)

        AutoRaid.Thread = task.spawn(function()
            while isActive(token) do
                local char, hum, root = getCharacter()
                if not (char and hum and root) then
                    task.wait(0.25)
                else
                    if activeRoot ~= root or not (bodyPosition and bodyPosition.Parent == root) then
                        attachHover(char, hum, root)
                    end

                    -- Recalcula o solo periodicamente para acompanhar o terreno e aplica
                    -- alterações do controle Distância sem afetar a assistência de mira.
                    local now = os.clock()
                    if bodyPosition and hoverAnchor and targetGroundY then
                        if appliedHoverHeight ~= AutoRaid.HoverHeight then
                            local refreshedGroundY = findGroundY(char, root)
                            if refreshedGroundY then groundBaseY = refreshedGroundY end
                            appliedHoverHeight = AutoRaid.HoverHeight
                            targetGroundY = (groundBaseY or (root.Position.Y - AutoRaid.HoverHeight))
                                + AutoRaid.HoverHeight
                        elseif now - lastGroundScan >= 1.5 then
                            local refreshedGroundY = findGroundY(char, root)
                            if refreshedGroundY then
                                groundBaseY = refreshedGroundY
                                targetGroundY = groundBaseY + AutoRaid.HoverHeight
                            end
                            lastGroundScan = now
                        end
                        currentHoverY = targetGroundY
                        bodyPosition.Position = Vector3.new(hoverAnchor.X, targetGroundY, hoverAnchor.Z)
                    end
                    task.wait(0.05)
                end
            end
            AutoRaid.Thread = nil
        end)
    end

    local function stopAutoRaid()
        if not AutoRaid.Enabled and not bodyPosition and not bodyGyro then return end
        AutoRaid.Enabled = false
        AutoRaid.Token = AutoRaid.Token + 1
        AutoRaid.Target = nil
        AutoRaid.AimPosition = nil
        if AutoRaid.Thread then
            pcall(task.cancel, AutoRaid.Thread)
            AutoRaid.Thread = nil
        end
        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)
        if orientationLockConnection then
            pcall(function() orientationLockConnection:Disconnect() end)
            orientationLockConnection = nil
        end
        removeHoverForces()
    end

    AutoRaid.Start = startAutoRaid
    AutoRaid.Stop = stopAutoRaid
end

--// ==========================================
--// AUTO RAID — ASSISTÊNCIA DE MIRA INDEPENDENTE (SOMENTE MOBS)
--// ==========================================
local AutoRaidAssist = {
    Enabled = false,
    Token = 0,
    Thread = nil,
    Target = nil,
    Start = nil,
    Stop = nil,
}

do
    local STEER_NAME = "RamdomHubAutoRaidAssistAim"
    local lastMouseMove = 0

    local function getCharacterRoot()
        local char = player.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then return root end
        return nil
    end

    local function getModelRoot(model)
        if not (model and model.Parent) then return nil end
        return model:FindFirstChild("HumanoidRootPart")
            or model.PrimaryPart
            or model:FindFirstChild("UpperTorso")
            or model:FindFirstChild("Torso")
            or model:FindFirstChild("Head")
            or model:FindFirstChildWhichIsA("BasePart", true)
    end

    local function isValidAimMob(model)
        if not (model and model:IsA("Model") and model.Parent and model:IsDescendantOf(workspace)) then
            return false
        end
        if model == player.Character or Players:GetPlayerFromCharacter(model) then return false end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not (hum and hum.Health > 0 and getModelRoot(model)) then return false end
        return AutoMob.IsValidMob ~= nil and AutoMob.IsValidMob(model) == true
    end

    local function getAimPosition(model)
        if not isValidAimMob(model) then return nil end
        local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
        if torso and torso:IsA("BasePart") then return torso.Position end
        local root = getModelRoot(model)
        if not root then return nil end
        local ok, _, size = pcall(function()
            local cf, bounds = model:GetBoundingBox()
            return cf, bounds
        end)
        if ok and typeof(size) == "Vector3" then
            return Vector3.new(root.Position.X, root.Position.Y + math.clamp(size.Y * 0.12, 1, 3), root.Position.Z)
        end
        return root.Position + Vector3.new(0, 1.5, 0)
    end

    local function findNearestMob(origin)
        local best, bestDistance = nil, math.huge
        for _, item in ipairs(workspace:GetDescendants()) do
            if item:IsA("Humanoid") and item.Health > 0 then
                local model = item.Parent
                if isValidAimMob(model) then
                    local root = getModelRoot(model)
                    if root then
                        local distance = (root.Position - origin).Magnitude
                        if distance < bestDistance then
                            best, bestDistance = model, distance
                        end
                    end
                end
            end
        end
        return best, bestDistance
    end

    local function onRenderStep(dt)
        if not AutoRaidAssist.Enabled then return end
        local aimPosition = getAimPosition(AutoRaidAssist.Target)
        if not aimPosition then return end
        local cam = workspace.CurrentCamera
        if not cam then return end

        -- Assistência de mira separada: só acompanha mobs válidos e não controla o voo.
        local current = cam.CFrame
        local desired = CFrame.lookAt(current.Position, aimPosition)
        local alpha = math.clamp((dt or 1 / 60) * 16, 0, 1)
        cam.CFrame = current:Lerp(desired, alpha)

        local now = os.clock()
        if now - lastMouseMove >= 0.08 then
            local screenPoint, onScreen = cam:WorldToViewportPoint(aimPosition)
            if onScreen and screenPoint.Z > 0 then
                pcall(function()
                    VirtualInputManager:SendMouseMoveEvent(
                        math.floor(screenPoint.X), math.floor(screenPoint.Y), game
                    )
                end)
                lastMouseMove = now
            end
        end
    end

    local function startAssist()
        if AutoRaidAssist.Enabled then return end
        AutoRaidAssist.Enabled = true
        AutoRaidAssist.Token = AutoRaidAssist.Token + 1
        local token = AutoRaidAssist.Token
        AutoRaidAssist.Target = nil
        lastMouseMove = 0
        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)
        RunService:BindToRenderStep(STEER_NAME, Enum.RenderPriority.Camera.Value + 3, onRenderStep)

        AutoRaidAssist.Thread = task.spawn(function()
            while AutoRaidAssist.Enabled and AutoRaidAssist.Token == token do
                local root = getCharacterRoot()
                if root then
                    local candidate, candidateDistance = findNearestMob(root.Position)
                    local current = AutoRaidAssist.Target
                    local currentRoot = getModelRoot(current)
                    local currentDistance = currentRoot and (currentRoot.Position - root.Position).Magnitude or math.huge
                    -- Evita troca nervosa quando dois mobs estão praticamente à mesma distância.
                    if candidate and (not isValidAimMob(current) or candidate == current
                        or candidateDistance + 3 < currentDistance) then
                        AutoRaidAssist.Target = candidate
                    elseif not isValidAimMob(current) then
                        AutoRaidAssist.Target = candidate
                    end
                else
                    AutoRaidAssist.Target = nil
                end
                task.wait(0.65)
            end
            AutoRaidAssist.Thread = nil
        end)
    end

    local function stopAssist()
        if not AutoRaidAssist.Enabled then return end
        AutoRaidAssist.Enabled = false
        AutoRaidAssist.Token = AutoRaidAssist.Token + 1
        AutoRaidAssist.Target = nil
        if AutoRaidAssist.Thread then
            pcall(task.cancel, AutoRaidAssist.Thread)
            AutoRaidAssist.Thread = nil
        end
        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)
    end

    AutoRaidAssist.Start = startAssist
    AutoRaidAssist.Stop = stopAssist
end

--// ==========================================
--// COMBAT — MOTOR
--// ==========================================
do
    local function pressKey(keyCode)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end)
    end

    local function pressSlotKey(slot)
        local keyMap = {
            [1] = Enum.KeyCode.One,
            [2] = Enum.KeyCode.Two,
            [3] = Enum.KeyCode.Three,
            [4] = Enum.KeyCode.Four,
            [5] = Enum.KeyCode.Five,
            [6] = Enum.KeyCode.Six,
            [7] = Enum.KeyCode.Seven,
            [8] = Enum.KeyCode.Eight,
            [9] = Enum.KeyCode.Nine,
            [10] = Enum.KeyCode.Zero,
        }
        local key = keyMap[slot]
        if key then
            pressKey(key)
        end
    end

    local function startEquipLoop(slot)
        if CombatCfg.EquipThread then
            task.cancel(CombatCfg.EquipThread)
            CombatCfg.EquipThread = nil
        end
        CombatCfg.EquipThread = task.spawn(function()
            while CombatCfg.SelectedSlot == slot and CombatCfg.AutoEquipEnabled do
                task.wait(1)
                local char = player.Character
                if char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
                    local currentTool = char:FindFirstChildOfClass("Tool")
                    if not currentTool or (CombatCfg.LastEquippedTool and currentTool ~= CombatCfg.LastEquippedTool) then
                        pressSlotKey(slot)
                        task.wait(0.2)
                        CombatCfg.LastEquippedTool = char:FindFirstChildOfClass("Tool")
                    end
                end
            end
            CombatCfg.EquipThread = nil
        end)
    end

    local function equipSlot(slot)
        if CombatCfg.EquipThread then
            task.cancel(CombatCfg.EquipThread)
            CombatCfg.EquipThread = nil
        end

        if slot == 0 or slot == nil or CombatCfg.SelectedSlot == slot then
            CombatCfg.SelectedSlot = nil
            CombatCfg.LastEquippedTool = nil
            return
        end

        CombatCfg.SelectedSlot = slot

        if CombatCfg.AutoEquipEnabled then
            pressSlotKey(slot)
            task.delay(0.3, function()
                local char = player.Character
                if char then
                    CombatCfg.LastEquippedTool = char:FindFirstChildOfClass("Tool")
                end
            end)
            startEquipLoop(slot)
        end
    end

    local function setAutoEquip(state)
        CombatCfg.AutoEquipEnabled = state
        if state then
            if CombatCfg.SelectedSlot and CombatCfg.SelectedSlot > 0 then
                pressSlotKey(CombatCfg.SelectedSlot)
                task.delay(0.3, function()
                    local char = player.Character
                    if char then
                        CombatCfg.LastEquippedTool = char:FindFirstChildOfClass("Tool")
                    end
                end)
                startEquipLoop(CombatCfg.SelectedSlot)
            end
        else
            if CombatCfg.EquipThread then
                task.cancel(CombatCfg.EquipThread)
                CombatCfg.EquipThread = nil
            end
        end
    end

    local AttackThread = nil
    local function toggleAutoAttack(state)
        CombatCfg.AutoAttackEnabled = state
        if not state then return end
        if AttackThread then return end

        AttackThread = task.spawn(function()
            local lastScan = 0
            local mobNear = false

            while CombatCfg.AutoAttackEnabled do
                if CombatCfg.SkillBusy then
                    task.wait(0.03)
                else
                    local now = os.clock()
                    if now - lastScan >= CombatCfg.AttackScanInterval then
                        lastScan = now
                        local ok, result = pcall(AutoMob.IsMobNear, CombatCfg.AttackRange)
                        if ok then
                            mobNear = result
                        else
                            mobNear = false
                            warn("[RAMDOM HUB] Auto Attack erro: " .. tostring(result))
                        end
                    end

                    if mobNear then
                        pcall(autoAttackClickOffscreen)
                        task.wait(CombatCfg.AttackDelay)
                    else
                        task.wait(0.05)
                    end
                end
            end
            AttackThread = nil
        end)
    end

    local function toggleAutoSkill(state)
        CombatCfg.AutoSkillEnabled = state
        if not state then
            CombatCfg.SkillBusy = false
            return
        end
        if CombatCfg.SkillThread then return end

        CombatCfg.SkillThread = task.spawn(function()
            while CombatCfg.AutoSkillEnabled do
                local cycleStart = os.clock()

                for _, data in ipairs(SKILL_KEYS) do
                    if not CombatCfg.AutoSkillEnabled then break end
                    if CombatCfg.SelectedSkills[data.Key] then
                        CombatCfg.SkillBusy = true
                        pressKey(data.Key)
                        task.wait(CombatCfg.SkillKeyGap)
                    end
                end

                CombatCfg.SkillBusy = false

                local remaining = CombatCfg.SkillInterval - (os.clock() - cycleStart)
                task.wait(math.max(remaining, 0.05))
