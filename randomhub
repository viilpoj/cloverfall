    local function normalizeName(name)
        local s = tostring(name or "")
        s = s:gsub("(%l)(%u)", "%1 %2")
        s = s:gsub("[_.%-]+", " ")
        s = s:gsub("%s+", " ")
        return string.lower(s)
    end

    local function matchesAny(s, patterns)
        for _, p in ipairs(patterns) do
            if s:find(p) then return true end
        end
        return false
    end

    local function titleCase(s)
        s = tostring(s or ""):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
        return (s:gsub("%S+", function(word)
            return word:sub(1, 1):upper() .. word:sub(2)
        end))
    end

    -- Detecta notificações visuais de coleta, por exemplo:
    -- "Mined Copper Ore x1 (Common)" ou "Collected Copper Ore".
    -- O contador só avança quando surge/muda uma notificação visível.
    local minerMinedNoticeCount = 0
    local minerMinedNoticeStates = setmetatable({}, { __mode = "k" })
    local minerMinedTextConnections = setmetatable({}, { __mode = "k" })
    local minerMinedVisibilityConnections = setmetatable({}, { __mode = "k" })
    local minerMinedGuiContainers = setmetatable({}, { __mode = "k" })

    local function isMinerTextObject(inst)
        return inst and (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox"))
    end

    local function isMinerGuiVisible(inst)
        local cur = inst
        while cur and cur ~= game do
            if cur:IsA("GuiObject") and not cur.Visible then return false end
            if cur:IsA("LayerCollector") and not cur.Enabled then return false end
            cur = cur.Parent
        end
        return true
    end

    local function isMinedNoticeLabel(label)
        if not isMinerTextObject(label) then return false end
        local labelText = normalizeName(tostring(label.Text or ""))
        local labelName = normalizeName(tostring(label.Name or ""))
        if labelText:find("mined", 1, true)
            or labelText:find("collected", 1, true)
            or labelText:find("colleted", 1, true) then
            return true
        end
        -- Alguns jogos mantêm o nome do TextLabel como "Mined" ou "Collected"
        -- e só alteram o texto exibido.
        return (labelName:find("mined", 1, true) ~= nil
            or labelName:find("collected", 1, true) ~= nil
            or labelName:find("colleted", 1, true) ~= nil)
            and tostring(label.Text or "") ~= ""
    end

    local function updateMinerMinedNotice(label, eventKind)
        if not isMinerTextObject(label) then return end
        local currentText = tostring(label.Text or "")
        local visible = isMinerGuiVisible(label)
        local matches = isMinedNoticeLabel(label)
        local state = minerMinedNoticeStates[label]
        local now = os.clock()

        if not state then
            state = { Text = currentText, Visible = visible, LastCountAt = -math.huge }
            minerMinedNoticeStates[label] = state
            if eventKind == "added" and matches and visible then
                minerMinedNoticeCount = minerMinedNoticeCount + 1
                state.LastCountAt = now
            end
            return
        end

        local changed = currentText ~= state.Text or (visible and not state.Visible)
        if eventKind == "added" and matches and visible then changed = true end
        if matches and visible and changed and now - state.LastCountAt >= 0.25 then
            minerMinedNoticeCount = minerMinedNoticeCount + 1
            state.LastCountAt = now
        end
        state.Text = currentText
        state.Visible = visible
    end

    local function watchMinerMinedObject(inst, eventKind)
        if not inst then return end
        if isMinerTextObject(inst) then
            if not minerMinedTextConnections[inst] then
                minerMinedTextConnections[inst] = true
                pcall(function()
                    inst:GetPropertyChangedSignal("Text"):Connect(function()
                        updateMinerMinedNotice(inst, "changed")
                    end)
                end)
            end
            updateMinerMinedNotice(inst, eventKind or "initial")
        end

        if (inst:IsA("GuiObject") or inst:IsA("LayerCollector"))
            and not minerMinedVisibilityConnections[inst] then
            minerMinedVisibilityConnections[inst] = true
            local prop = inst:IsA("LayerCollector") and "Enabled" or "Visible"
            pcall(function()
                inst:GetPropertyChangedSignal(prop):Connect(function()
                    local ok, descendants = pcall(function() return inst:GetDescendants() end)
                    if ok and descendants then
                        for _, descendant in ipairs(descendants) do
                            if isMinerTextObject(descendant) then
                                updateMinerMinedNotice(descendant, "visibility")
                            end
                        end
                    end
                    if isMinerTextObject(inst) then updateMinerMinedNotice(inst, "visibility") end
                end)
            end)
        end
    end

    local function watchMinerMinedContainer(container)
        if not container or minerMinedGuiContainers[container] then return end
        minerMinedGuiContainers[container] = true
        watchMinerMinedObject(container, "initial")
        local ok, descendants = pcall(function() return container:GetDescendants() end)
        if ok and descendants then
            for _, descendant in ipairs(descendants) do
                watchMinerMinedObject(descendant, "initial")
            end
        end
        pcall(function()
            container.DescendantAdded:Connect(function(descendant)
                watchMinerMinedObject(descendant, "added")
                local okChildren, children = pcall(function() return descendant:GetDescendants() end)
                if okChildren and children then
                    for _, child in ipairs(children) do
                        watchMinerMinedObject(child, "added")
                    end
                end
            end)
        end)
    end

