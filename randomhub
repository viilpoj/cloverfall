local NoclipEnabled = false
local NoclipConnection = nil

local function startNoclip()
    NoclipEnabled = true
    if NoclipConnection then return end
    NoclipConnection = RunService.Stepped:Connect(function()
        if NoclipEnabled and player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function stopNoclip()
    NoclipEnabled = false
    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end
    if player.Character then
        for _, part in ipairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

--// ==========================================
--// AUTO MOB — MOTOR
--// ==========================================
do
    local STEER_NAME = "RamdomHubAutoMobSteer"
    local ignored = setmetatable({}, { __mode = "k" })

    local function isActive(token)
        return AutoMob.Enabled and AutoMob.Token == token
    end

    local function getChar()
        local char = player.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            return char, hum, root
        end
        return nil
    end

    local function isPlayerModel(model)
        return Players:GetPlayerFromCharacter(model) ~= nil
    end

    local function modelRoot(model)
        if not model then return nil end
        return model:FindFirstChild("HumanoidRootPart")
            or model.PrimaryPart
            or model:FindFirstChildWhichIsA("BasePart", true)
    end

    local function mobAlive(mob)
        if not mob or not mob.Parent or not mob:IsDescendantOf(workspace) then
            return false
        end
        local h = mob:FindFirstChildOfClass("Humanoid")
        return h ~= nil and h.Health > 0
    end

    local function getMobLevel(model)
        local lvl = model.Name:match("%[Lv%.?%s*(%d+)%]") or model.Name:match("[Ll]v%.?%s*(%d+)")
        if lvl then return tonumber(lvl) end

        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("TextLabel") then
                local text = d.Text
                local lvlStr = text:match("[Ll]v%.?%s*(%d+)") or text:match("[Ll]evel%s*(%d+)")
                if lvlStr then
                    return tonumber(lvlStr)
                end
            end
        end
        return nil
    end

    local function isValidMob(model)
        if not model or not model:IsA("Model") then return false end
        if model == player.Character then return false end
        if isPlayerModel(model) then return false end
        
        local lowerName = string.lower(model.Name)
        if string.find(lowerName, "quest") or string.find(lowerName, "npc") then 
            return false 
        end

        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then 
                return false 
            end
        end
        return true
    end

    local function mobKey(name)
        local raw = string.lower(tostring(name or ""))
        local s = raw:gsub("%b[]", " ")
        s = s:gsub("%b()", " ")
        s = s:gsub("[%d%p]+", " ")
        s = s:gsub("%s+", " ")
        s = s:match("^%s*(.-)%s*$")
        if s == nil or s == "" then
            return raw
        end
        return s
    end
    AutoMob.MakeKey = mobKey

    local function typeId(key, level)
        return key .. "|" .. tostring(level or 0)
    end

    local function getMobType(model)
        local key = mobKey(model.Name)
        local level = getMobLevel(model)
        return key, level, typeId(key, level)
    end

    local function hasSelection()
        return next(AutoMob.SelectedTypes) ~= nil
    end

    local function matchesSelection(model)
        local key = mobKey(model.Name)
        local keyOk = false
        for _, t in pairs(AutoMob.SelectedTypes) do
            if t.Key == key then
                keyOk = true
                break
            end
        end
        if not keyOk then return false end

        return AutoMob.SelectedTypes[typeId(key, getMobLevel(model))] ~= nil
    end

    AutoMob.HasSelection = hasSelection

    AutoMob.IsSelected = function(id)
        return AutoMob.SelectedTypes[id] ~= nil
    end

    AutoMob.ToggleType = function(info)
        if not info or not info.Id then return end
        if AutoMob.SelectedTypes[info.Id] then
            AutoMob.SelectedTypes[info.Id] = nil
        else
            AutoMob.SelectedTypes[info.Id] = {
                Id = info.Id,
                Key = info.Key,
                Level = info.HasLevel and info.Level or nil,
                Name = info.Name,
            }
        end
        AutoMob.SelectionVersion = AutoMob.SelectionVersion + 1
    end

    AutoMob.ClearSelection = function()
        AutoMob.SelectedTypes = {}
        AutoMob.SelectionVersion = AutoMob.SelectionVersion + 1
    end

    local lastStatus, lastStatusTime = "", 0
    local function setStatus(text, force)
        if text == lastStatus then return end
        local now = os.clock()
        if not force and now - lastStatusTime < 0.25 then return end
        lastStatus, lastStatusTime = text, now
        AutoMob.Status = text
        if AutoMob.OnStatus then
            pcall(AutoMob.OnStatus, text)
        end
    end

    local moving = false
    local keysDown = false
    local steerPart = nil

    local function sendKeys(down)
        if not MOB_CFG.HoldShiftWhileMoving then return end
        pcall(function()
            VirtualInputManager:SendKeyEvent(down, Enum.KeyCode.LeftShift, false, game)
        end)
    end

    local function setMoving(state)
        if state then
            moving = true
            if not keysDown then
                keysDown = true
                sendKeys(true)
            end
        else
            moving = false
            if keysDown then
                keysDown = false
                sendKeys(false)
            end
        end
    end

    local function onRenderStep()
        local part = steerPart
        if not (part and part.Parent) then return end

        local _, _, root = getChar()
        if not root then return end

        local cam = workspace.CurrentCamera
        if not cam then return end

        local target = part.Position
        local flat = Vector3.new(target.X - root.Position.X, 0, target.Z - root.Position.Z)
        if flat.Magnitude > 0.5 then
            local dir = flat.Unit
            local cf = cam.CFrame
            local pitch = math.clamp(cf.LookVector.Y, -0.5, 0.5)
            local h = math.sqrt(1 - pitch * pitch)
            local look = Vector3.new(dir.X * h, pitch, dir.Z * h)
            cam.CFrame = CFrame.lookAt(cf.Position, cf.Position + look)
        end
    end

    AutoMob.ScanMobs = function()
        local mobs, byId = {}, {}
        local _, _, root = getChar()

        if root then
            for _, d in ipairs(workspace:GetDescendants()) do
                if d:IsA("Humanoid") then
                    local model = d.Parent
                    if model and model:IsA("Model") then
                        local mr = modelRoot(model)
                        if mr and (mr.Position - root.Position).Magnitude <= MOB_CFG.SearchRadius and isValidMob(model) then
                            local key, level, id = getMobType(model)
                            local item = byId[id]
                            if not item then
                                item = {
                                    Id = id,
                                    Name = model.Name,
                                    Key = key,
                                    Level = level or 1,
                                    HasLevel = level ~= nil,
                                    Model = model,
                                }
                                byId[id] = item
                                table.insert(mobs, item)
                            elseif model.Name < item.Name then
                                item.Name = model.Name
                                item.Model = model
                            end
                        end
                    end
                end
            end
        end

        for id, t in pairs(AutoMob.SelectedTypes) do
            if not byId[id] then
                local item = {
                    Id = id,
                    Name = t.Name,
                    Key = t.Key,
                    Level = t.Level or 1,
                    HasLevel = t.Level ~= nil,
                }
                byId[id] = item
                table.insert(mobs, item)
            end
        end

        table.sort(mobs, function(a, b)
            if a.Level ~= b.Level then return a.Level < b.Level end
            if a.Key ~= b.Key then return a.Key < b.Key end
            return a.Name < b.Name
        end)
        return mobs
    end

    AutoMob.IsMobNear = function(range)
        local _, _, root = getChar()
        if not root then return false end

        local onlySelected = MOB_CFG.AttackOnlySelected and AutoMob.Enabled and hasSelection()

        if onlySelected then
            local target = AutoMob.Target
            if target and mobAlive(target) then
                local tr = modelRoot(target)
                if tr and (tr.Position - root.Position).Magnitude <= range then
                    return true
                end
            end
        end

        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Humanoid") then
                local model = d.Parent
                if model and model:IsA("Model") then
                    local mr = modelRoot(model)
                    if mr and (mr.Position - root.Position).Magnitude <= range and isValidMob(model)
                        and (not onlySelected or matchesSelection(model)) then
                        return true
                    end
                end
            end
        end
        return false
    end

    local function isIgnored(model, now)
        local untilTime = ignored[model]
        if not untilTime then return false end
        if untilTime <= now then
            ignored[model] = nil
            return false
        end
        return true
    end

    local function findMob(root)
        local selected = hasSelection()
        if not selected and not MOB_CFG.AnyWhenNoSelection then
            return nil
        end

        local now = os.clock()
        local best, bestDist = nil, selected and MOB_CFG.SelectedSearchRadius or MOB_CFG.SearchRadius

        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Humanoid") and d.Health > 0 then
                local model = d.Parent
                if model and model:IsA("Model") and not isIgnored(model, now) then
                    local mr = modelRoot(model)
                    if mr then
                        local dist = (mr.Position - root.Position).Magnitude
                        if dist < bestDist and isValidMob(model) and (not selected or matchesSelection(model)) then
                            best, bestDist = model, dist
                        end
                    end
                end
            end
        end

        return best
    end

    local function getMobRadius(model, mr)
        local radius = 1
        local ok, size = pcall(function() return model:GetExtentsSize() end)
        if ok and size then
            radius = math.max(size.X, size.Z) / 2
        elseif mr then
            radius = math.max(mr.Size.X, mr.Size.Z) / 2
        end
        return math.clamp(radius, 1, 15)
    end

    local function faceTo(root, pos)
        local toTarget = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
        if toTarget.Magnitude < 0.1 then return end

        local look = root.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0.01 and flatLook.Unit:Dot(toTarget.Unit) > 0.99 then
            return 
        end

        root.CFrame = CFrame.lookAt(root.Position, Vector3.new(pos.X, root.Position.Y, pos.Z))
    end

    local function chase(mob, token)
        local mr0 = modelRoot(mob)
        local reach = MOB_CFG.StopDistance + getMobRadius(mob, mr0)

        local t0 = os.clock()
        local _, _, root0 = getChar()
        local startDist = (root0 and mr0) and (root0.Position - mr0.Position).Magnitude or 0
        local nearLimit = math.max(MOB_CFG.MobTimeout, startDist / 8)

        local lastNear = t0            
        local progressAt = t0          
        local bestDist = math.huge
        local engaged = false          
        local lastCheck, lastPos, stuck = t0, nil, 0
        local selVersion = AutoMob.SelectionVersion
        local reason = "fim"

        while isActive(token) do
            if not mobAlive(mob) then
                reason = "morto"
                break
            end

            if selVersion ~= AutoMob.SelectionVersion then
                selVersion = AutoMob.SelectionVersion
                local allowed
                if hasSelection() then
                    allowed = matchesSelection(mob)
                else
                    allowed = MOB_CFG.AnyWhenNoSelection
                end
                if not allowed then
                    reason = "desmarcado"
                    break
                end
            end

            local _, hum, root = getChar()
            local mr = modelRoot(mob)

            if not mr then
                reason = "sem-raiz"
                break
            end

            if not (hum and root) then
                setMoving(false)
                steerPart = nil
                local now = os.clock()
                lastNear, progressAt, bestDist = now, now, math.huge
                engaged, lastPos, stuck = false, nil, 0
                setStatus("aguardando seu personagem...")
                task.wait(0.3)
            else
                local now = os.clock()
                local dist = (root.Position - mr.Position).Magnitude
                steerPart = mr

                if engaged then
                    if dist > reach + MOB_CFG.StopBuffer then
                        engaged = false
                        bestDist, progressAt = dist, now
                    end
                elseif dist <= reach then
                    engaged = true
                end

                if engaged then
                    setMoving(false)
                    setStatus(string.format("perto de %s (%d studs)", mob.Name, math.floor(dist)))
                    hum:MoveTo(root.Position)
                    faceTo(root, mr.Position)
                    stuck, lastPos = 0, nil
                    lastNear, progressAt, bestDist = now, now, dist
                else
                    setMoving(true)
                    setStatus(string.format("indo até %s (%d studs)", mob.Name, math.floor(dist)))
                    hum:MoveTo(mr.Position)

                    if dist < bestDist - 1.5 then
                        bestDist, progressAt = dist, now
                    end
                    if dist <= reach + 4 then
                        lastNear, progressAt = now, now
                    end

                    if now - lastCheck >= 0.5 then
                        if lastPos and (root.Position - lastPos).Magnitude < 1 then
                            stuck = stuck + (now - lastCheck)
                        else
                            stuck = 0
                        end
                        lastPos, lastCheck = root.Position, now
                    end
                    if stuck > 1 then
                        hum.Jump = true
                    end

                    if now - progressAt > MOB_CFG.GiveUpTime or now - lastNear > nearLimit then
                        reason = "inalcancavel"
                        break
                    end
                end

                task.wait(MOB_CFG.TickRate)
            end
        end

        steerPart = nil
        return reason
    end

    local function step(token)
        local _, _, root = getChar()
        if not root then
            setMoving(false)
            steerPart = nil
            AutoMob.Target = nil
            setStatus("sem personagem")
            task.wait(0.5)
            return
        end

        local selected = hasSelection()
        if not selected and not MOB_CFG.AnyWhenNoSelection then
            setMoving(false)
            steerPart = nil
            AutoMob.Target = nil
            setStatus("marque um tipo de mob na lista")
            task.wait(0.5)
            return
        end

        local mob = findMob(root)
        if not mob then
            setMoving(false)
            steerPart = nil
            AutoMob.Target = nil
            if selected then
                setStatus("nenhum mob dos tipos marcados (esperando)")
            else
                setStatus("nenhum mob por perto")
            end
            task.wait(0.5)
            return
        end

        AutoMob.Target = mob
        local reason = chase(mob, token)
        AutoMob.Target = nil

        if reason == "inalcancavel" or reason == "sem-raiz" then
            ignored[mob] = os.clock() + MOB_CFG.IgnoreTime
            setStatus("não deu pra chegar em " .. tostring(mob.Name) .. ", indo pro próximo")
        end
    end

    local function startAutoMob()
        if AutoMob.Enabled then return end
        AutoMob.Enabled = true
        AutoMob.Token = AutoMob.Token + 1
        local token = AutoMob.Token

        if AutoMob.Thread then
            pcall(task.cancel, AutoMob.Thread)
            AutoMob.Thread = nil
        end

        setStatus("procurando mob...", true)

        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)
        RunService:BindToRenderStep(STEER_NAME, Enum.RenderPriority.Camera.Value + 1, onRenderStep)

        AutoMob.Thread = task.spawn(function()
            while isActive(token) do
                local ok, err = pcall(step, token)
                if not ok then
                    warn("[RAMDOM HUB] Auto Mob erro: " .. tostring(err))
                    setMoving(false)
                    steerPart = nil
                    AutoMob.Target = nil
                    setStatus("erro: " .. tostring(err), true)
                    task.wait(2)
                end
                task.wait(0.05)
            end
        end)
    end

    local function stopAutoMob()
        if not AutoMob.Enabled then return end
        AutoMob.Enabled = false
        AutoMob.Token = AutoMob.Token + 1

        if AutoMob.Thread then
            pcall(task.cancel, AutoMob.Thread)
            AutoMob.Thread = nil
        end

        AutoMob.Target = nil
        steerPart = nil
        setMoving(false)
        setStatus("desligado", true)
        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)

        local _, hum, root = getChar()
        if hum and root then
            pcall(function() hum:MoveTo(root.Position) end)
        end
    end

    AutoMob.Start = startAutoMob
    AutoMob.Stop = stopAutoMob
end

--// ==========================================
--// AUTO MINER — MOTOR
--// ==========================================
do
    local PathfindingService = game:GetService("PathfindingService")
    local STEER_NAME = "RamdomHubAutoMinerSteer"

    local rejected = setmetatable({}, { __mode = "k" })  
    local blocked = {}                                    
    local nameKindCache = {}

    local aimTarget = nil
    local moving, keysDown = false, false

    local function dbg(...)
        if MINER_CFG.Debug then
            print("[RAMDOM HUB][Miner]", ...)
        end
    end

    local function isActive(token)
        return AutoMiner.Enabled and AutoMiner.Token == token
    end

    local function getChar()
        local char = player.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            return char, hum, root
        end
        return nil
    end

    local lastStatus, lastStatusTime = "", 0
    local function setStatus(text, force)
        if text == lastStatus then return end
        local now = os.clock()
        if not force and now - lastStatusTime < 0.25 then return end
        lastStatus, lastStatusTime = text, now
        AutoMiner.Status = text
        if AutoMiner.OnStatus then
            pcall(AutoMiner.OnStatus, text)
        end
    end

    local function sendKeys(down)
        if not MINER_CFG.HoldShiftWhileMoving then return end
        pcall(function()
            VirtualInputManager:SendKeyEvent(down, Enum.KeyCode.LeftShift, false, game)
        end)
    end

    local function setMoving(state)
        if state then
            moving = true
            if not keysDown then
                keysDown = true
                sendKeys(true)
            end
        else
            moving = false
            if keysDown then
                keysDown = false
                sendKeys(false)
            end
        end
    end

    local function releaseMouse()
        local p = getClickPosition() or Vector2.new(0, 0)
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 0)
        end)
        pcall(function()
            local cam = workspace.CurrentCamera
            VirtualUser:Button1Up(p, cam and cam.CFrame or CFrame.new())
        end)
    end

    local function horizontal(a, b)
        return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
    end

    local function worldBounds(cf, size)
        local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
        local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
        local ex = math.abs(r00) * hx + math.abs(r01) * hy + math.abs(r02) * hz
        local ey = math.abs(r10) * hx + math.abs(r11) * hy + math.abs(r12) * hz
        local ez = math.abs(r20) * hx + math.abs(r21) * hy + math.abs(r22) * hz
        return Vector3.new(x - ex, y - ey, z - ez), Vector3.new(x + ex, y + ey, z + ez)
    end

    local function livingAncestor(inst)
        local cur = inst
        while cur and cur ~= workspace do
            if cur:IsA("Model") and cur:FindFirstChildOfClass("Humanoid") then
                return cur
            end
            cur = cur.Parent
        end
        return nil
    end

    local ORE_PATTERNS = { "%f[%a]ores?%f[%A]" }
    local CRYSTAL_PATTERNS = { "crystal", "cristal", "%f[%a]gems?", "gemstone", "mineral", "geode" }
    local BLOCKED_WORDS = {
        "shop", "store", "sell", "npc", "quest", "vendor", "merchant",
        "forge", "furnace", "smelt", "chest", "crate", "cart", "portal", "sign",
    }

    local function normalizeName(name)
        local s = tostring(name or "")
        s = s:gsub("(%l)(%u)", "%1 %2")   
        s = s:gsub("[_%-%.]+", " ")
        return string.lower(s)
    end

    local function matchesAny(s, patterns)
        for _, p in ipairs(patterns) do
            if s:find(p) then return true end
        end
        return false
    end

    local function nameKind(name)
        local cached = nameKindCache[name]
        if cached ~= nil then return cached end

        local s = normalizeName(name)
        local kind = false

        local isBlockedName = false
        for _, w in ipairs(BLOCKED_WORDS) do
            if s:find(w, 1, true) then
                isBlockedName = true
                break
            end
        end

        if not isBlockedName then
            if matchesAny(s, ORE_PATTERNS) then
                kind = "ore"
            elseif matchesAny(s, CRYSTAL_PATTERNS) then
                kind = "crystal"
            else
                for _, h in ipairs(MINER_CFG.ExtraNameHints) do
                    if h ~= "" and s:find(string.lower(h), 1, true) then
                        kind = "extra"
                        break
                    end
                end
            end
        end

        nameKindCache[name] = kind
        return kind
    end

    local function isOreItemName(name)
        local s = normalizeName(name)
        if matchesAny(s, ORE_PATTERNS) then return true end
        for _, h in ipairs(MINER_CFG.ExtraNameHints) do
            if h ~= "" and s:find(string.lower(h), 1, true) then return true end
        end
        return false
    end

    local CRYSTAL_MATERIALS = {
        [Enum.Material.Neon] = true,
        [Enum.Material.Glass] = true,
        [Enum.Material.Ice] = true,
    }

    local function looksLikeCrystal(part)
        if not CRYSTAL_MATERIALS[part.Material] then return false end
        local s = part.Size
        local m = math.max(s.X, s.Y, s.Z)
        if m < MINER_CFG.CrystalMinSize or m > MINER_CFG.CrystalMaxSize then return false end
        return part:IsA("MeshPart") or part:IsA("WedgePart") or part:IsA("CornerWedgePart")
            or part:FindFirstChildOfClass("SpecialMesh") ~= nil
    end

    local function isContainer(inst)
        if inst:IsA("Folder") then return true end
        if inst:IsA("Model") then
            for _, c in ipairs(inst:GetChildren()) do
                if c:IsA("Model") then return true end
            end
        end
        return false
    end

    local function classify(d)
        local isModel = d:IsA("Model")
        local isPart = (not isModel) and d:IsA("BasePart") and not d:IsA("Terrain")
        if not (isModel or isPart) then return nil end

        local kind = nameKind(d.Name)

        if not kind then
            local parent = d.Parent
            if parent and parent ~= workspace then
                local pk = nameKind(parent.Name)
                if pk and isContainer(parent) then
                    kind = "pasta:" .. pk
                end
            end
        end

        if not kind and isPart and MINER_CFG.UseAppearance and looksLikeCrystal(d) then
            kind = "aparencia"
        end

        if not kind then return nil end
        if isModel and isContainer(d) then return nil end
        if livingAncestor(d) then return nil end
        if d:FindFirstAncestorOfClass("Tool") then return nil end
        return kind
    end

    local function partLooksOre(p)
        if nameKind(p.Name) then return true end
        local par = p.Parent
        if par and par ~= workspace and nameKind(par.Name) then return true end
        return looksLikeCrystal(p)
    end

    local function collectCandidates(root)
        local rp = root.Position
        local radius = MINER_CFG.SearchRadius
        local found, set = {}, {}

        for _, d in ipairs(workspace:GetDescendants()) do
            local kind = classify(d)
            if kind then
                local okPivot, pivot = pcall(function() return d:GetPivot().Position end)
                if okPivot and pivot then
                    local dist = (pivot - rp).Magnitude
                    if dist <= radius then
                        table.insert(found, { Inst = d, Pos = pivot, Dist = dist, Kind = kind })
                        set[d] = true
                    end
                end
            end
        end

        local list = {}
        for _, c in ipairs(found) do
            local nested = false
            local anc = c.Inst.Parent
            while anc and anc ~= workspace do
                if set[anc] then
                    nested = true
                    break
                end
                anc = anc.Parent
            end
            if not nested then
                table.insert(list, c)
            end
        end

        table.sort(list, function(a, b) return a.Dist < b.Dist end)
        return list
    end

    local function getBox(inst)
        if inst:IsA("BasePart") then
            return inst.CFrame, inst.Size
        end
        local ok, cf, size = pcall(function() return inst:GetBoundingBox() end)
        if ok and cf and size then
            return cf, size
        end
        return nil
    end

    local function collectParts(inst)
        if inst:IsA("BasePart") then
            return { inst }
        end
        local parts = {}
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("BasePart") then
                table.insert(parts, d)
                if #parts >= 60 then break end
            end
        end
        return parts
    end

    local function castRay(origin, direction, ignoreList)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        pcall(function() params.RespectCanCollide = true end)

        local ignore = {}
        for i, v in ipairs(ignoreList) do
            ignore[i] = v
        end

        for _ = 1, 5 do
            params.FilterDescendantsInstances = ignore
            local res = workspace:Raycast(origin, direction, params)
            if not res then return nil end
            local living = livingAncestor(res.Instance)
            if not living then return res end
            table.insert(ignore, living)
        end
        return nil
    end

    local function checkGround(inst, mn, mx, center)
        local ignore = { inst }
        local char = player.Character
        if char then table.insert(ignore, char) end

        local startY = mx.Y + 0.75
        local length = (mx.Y - mn.Y) + 400
        local dx = math.clamp((mx.X - mn.X) * 0.35, 0, 3)
        local dz = math.clamp((mx.Z - mn.Z) * 0.35, 0, 3)
        local offsets = {
            Vector3.new(0, 0, 0),
            Vector3.new(dx, 0, 0),
            Vector3.new(-dx, 0, 0),
            Vector3.new(0, 0, dz),
            Vector3.new(0, 0, -dz),
        }

        local okCount, centerOk, groundPos = 0, false, nil
        local supports = {}

        for i, o in ipairs(offsets) do
            local res = castRay(
                Vector3.new(center.X + o.X, startY, center.Z + o.Z),
                Vector3.new(0, -length, 0),
                ignore
            )
            if res then
                local gap = mn.Y - res.Position.Y
                local good = res.Normal.Y >= MINER_CFG.MinGroundNormalY
                    and res.Position.Y <= mx.Y + 0.1
                    and gap <= MINER_CFG.GroundGapMax
                if good then
                    okCount = okCount + 1
                    supports[res.Instance] = true
                end
                if i == 1 then
                    centerOk = good
                    groundPos = res.Position
                end
            end
        end

        if not (centerOk and okCount >= 3) then
            return false
        end
        return true, groundPos, supports
    end

    local function isEmbedded(inst, center, mn, mx, supports)
        local ext = mx - mn
        local size = Vector3.new(
            math.max(ext.X * 0.5, 0.4),
            math.max(ext.Y * 0.5, 0.4),
            math.max(ext.Z * 0.5, 0.4)
        )

        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local ignore = { inst }
        if player.Character then table.insert(ignore, player.Character) end
        params.FilterDescendantsInstances = ignore
        pcall(function() params.RespectCanCollide = true end)

        local okQ, parts = pcall(function()
            return workspace:GetPartBoundsInBox(CFrame.new(center), size, params)
        end)
        if not okQ or not parts then return false end

        local limitY = center.Y + (ext.Y / 2) * MINER_CFG.EmbedTopFactor
        for _, p in ipairs(parts) do
            if not p:IsA("Terrain") and not supports[p] and not livingAncestor(p) and not partLooksOre(p) then
                local _, pmx = worldBounds(p.CFrame, p.Size)
                if pmx.Y > limitY then
                    return true
                end
            end
        end
        return false
    end

    local function evaluate(inst)
        local cf, size = getBox(inst)
        if not cf then return nil, "sem-caixa" end

        local mn, mx = worldBounds(cf, size)
        local ext = mx - mn
        local biggest = math.max(ext.X, ext.Y, ext.Z)
        if biggest < 0.2 then return nil, "vazio" end
        if biggest > MINER_CFG.MaxOreSize then return nil, "grande-demais" end

        local center = (mn + mx) / 2

        local good, groundPos, supports = checkGround(inst, mn, mx, center)
        if not good then return nil, "sem-apoio-no-chao (parede/alto)" end

        if isEmbedded(inst, center, mn, mx, supports) then
            return nil, "embutido-em-parede/plataforma"
        end

        local parts = collectParts(inst)
        local visible = false
        for _, p in ipairs(parts) do
            if p.Transparency < 0.95 then
                visible = true
                break
            end
        end

        return {
            Inst = inst,
            Name = inst.Name,
            Center = center,
            Top = mx.Y,
            Bottom = mn.Y,
            Radius = math.clamp(math.max(ext.X, ext.Z) / 2, 1, 8),
            GroundPos = groundPos,
            Parts = parts,
            WasVisible = visible,
            StandPoint = nil,
            Waypoints = nil,
        }
    end

    local function computeStandPoint(info, from)
        local flat = Vector3.new(from.X - info.Center.X, 0, from.Z - info.Center.Z)
        local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(1, 0, 0)
        local offset = info.Radius + MINER_CFG.MineDistance * 0.5
        local px = info.Center.X + dir.X * offset
        local pz = info.Center.Z + dir.Z * offset

        local ignore = { info.Inst }
        if player.Character then table.insert(ignore, player.Character) end

        local res = castRay(Vector3.new(px, info.GroundPos.Y + 6, pz), Vector3.new(0, -20, 0), ignore)
        if res and res.Normal.Y >= MINER_CFG.MinGroundNormalY and math.abs(res.Position.Y - info.GroundPos.Y) <= 6 then
            return res.Position
        end
        return info.GroundPos
    end

    local function computePath(fromPos, toPos)
        if not MINER_CFG.UsePathfinding then
            return true, nil
        end

        local okCreate, path = pcall(function()
            return PathfindingService:CreatePath({
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = true,
                WaypointSpacing = 4,
            })
        end)
        if not okCreate or not path then
            return true, nil
        end

        local okCompute = pcall(function()
            path:ComputeAsync(fromPos, toPos)
        end)
        if not okCompute then
            return true, nil
        end

        if path.Status ~= Enum.PathStatus.Success then
            return false, nil
        end

        local wps = path:GetWaypoints()
        if #wps == 0 then
            return false, nil
        end
        return true, wps
    end

    local function checkReachable(info, root)
        local stand = computeStandPoint(info, root.Position)
        info.StandPoint = stand

        local ok, wps = computePath(root.Position, stand)
        if not ok then return false end

        if wps then
            local last = wps[#wps].Position
            if horizontal(last, stand) > 8 or math.abs(last.Y - stand.Y) > 8 then
                return false
            end
        end

        info.Waypoints = wps
        return true
    end

    local function blockSpot(pos, secs)
        table.insert(blocked, { Pos = pos, Until = os.clock() + secs })
    end

    local function isBlocked(pos, now)
        for i = #blocked, 1, -1 do
            local b = blocked[i]
            if b.Until <= now then
                table.remove(blocked, i)
            elseif horizontal(b.Pos, pos) <= MINER_CFG.BlockRadius then
                return true
            end
        end
        return false
    end

    local function pickTarget(root, token)
        local now = os.clock()
        local cands = collectCandidates(root)
        local stats = { Total = #cands, Ground = 0, Rejected = 0, Blocked = 0, PathTries = 0 }

        for _, c in ipairs(cands) do
            if not isActive(token) then return nil, stats end

            local inst = c.Inst
            local untilT = rejected[inst]

            if untilT and untilT > now then
                stats.Rejected = stats.Rejected + 1
            elseif isBlocked(c.Pos, now) then
                stats.Blocked = stats.Blocked + 1
            elseif inst.Parent then
                local info, reason = evaluate(inst)
                if not info then
                    rejected[inst] = now + MINER_CFG.RejectCacheTime
                    stats.Rejected = stats.Rejected + 1
                    dbg(inst:GetFullName(), "[" .. tostring(c.Kind) .. "] descartado:", reason)
                else
                    stats.Ground = stats.Ground + 1
                    if stats.PathTries < MINER_CFG.MaxPathChecks then
                        stats.PathTries = stats.PathTries + 1
                        if checkReachable(info, root) then
                            dbg(inst:GetFullName(), "[" .. tostring(c.Kind) .. "] aceito")
                            return info, stats
                        end
                        rejected[inst] = os.clock() + MINER_CFG.IgnoreTime
                        stats.Rejected = stats.Rejected + 1
                        dbg(inst:GetFullName(), "[" .. tostring(c.Kind) .. "] descartado: sem caminho a pé")
                    else
                        break
                    end
                end
            end
        end

        return nil, stats
    end

    local function oreGone(info)
        local inst = info.Inst
        if not inst or not inst.Parent or not inst:IsDescendantOf(workspace) then
            return true, "sumiu"
        end

        if info.WasVisible then
            local anyVisible = false
            for _, p in ipairs(info.Parts) do
                if p.Parent and p.Transparency < 0.95 then
                    anyVisible = true
                    break
                end
            end
            if not anyVisible then
                return true, "oculto"
            end
        end

        return false
    end

    local function stackCount(name)
        local n = name:match("[xX]%s*(%d+)%s*$") or name:match("%((%d+)%)%s*$") or name:match("^(%d+)%s*[xX]")
        return tonumber(n) or 1
    end

    local function baseName(name)
        local s = name:gsub("%s*[xX]%s*%d+%s*$", ""):gsub("%s*%(%d+%)%s*$", ""):gsub("^%d+%s*[xX]%s*", "")
        return string.lower(s)
    end

    local function snapshotInventory()
        local total, byName = 0, {}

        local function add(key, n)
            byName[key] = (byName[key] or 0) + n
            total = total + n
        end

        local function scanTools(container)
            if not container then return end
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("Tool") and isOreItemName(c.Name) then
                    add(baseName(c.Name), stackCount(c.Name))
                end
            end
        end

        scanTools(player:FindFirstChildOfClass("Backpack"))
        scanTools(player.Character)

        for _, child in ipairs(player:GetChildren()) do
            if child.Name ~= "PlayerGui" and child.Name ~= "PlayerScripts" and not child:IsA("Backpack") then
                for _, d in ipairs(child:GetDescendants()) do
                    if (d:IsA("IntValue") or d:IsA("NumberValue")) and isOreItemName(d.Name) then
                        add("valor:" .. d:GetFullName(), d.Value)
                    end
                end
            end
        end

        return { Total = total, ByName = byName }
    end

    local function inventoryIncreased(before, after)
        if after.Total > before.Total then return true end
        for k, v in pairs(after.ByName) do
            if v > (before.ByName[k] or 0) then
                return true
            end
        end
        return false
    end

    local function onRenderStep()
        local t = aimTarget
        if not t then return end
        local cam = workspace.CurrentCamera
        if not cam then return end

        local cf = cam.CFrame
        local dir = t - cf.Position
        if dir.Magnitude < 0.5 then return end
        if math.abs(dir.Unit.Y) > 0.98 then return end
        cam.CFrame = CFrame.lookAt(cf.Position, t)
    end

    local function faceTo(root, pos)
        local toTarget = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
        if toTarget.Magnitude < 0.1 then return end

        local look = root.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0.01 and flatLook.Unit:Dot(toTarget.Unit) > 0.99 then
            return
        end

        root.CFrame = CFrame.lookAt(root.Position, Vector3.new(pos.X, root.Position.Y, pos.Z))
    end

    local function walkTo(info, token)
        local reach = info.Radius + MINER_CFG.MineDistance
        local waypoints = info.Waypoints
        local idx = 1

        local t0 = os.clock()
        local _, _, root0 = getChar()
        local startDist = root0 and horizontal(root0.Position, info.Center) or 0
        local limit = math.max(MINER_CFG.WalkTimeoutMin, startDist / 6)

        local lastCheck, lastPos, stuck = t0, nil, 0
        local recomputes = 0
        local result = "parou"

        while isActive(token) do
            local gone = oreGone(info)
            if gone then
                result = "sumiu"
                break
            end

            local _, hum, root = getChar()
            if not (hum and root) then
                setMoving(false)
                setStatus("aguardando seu personagem...")
                lastPos, stuck = nil, 0
                task.wait(0.3)
            else
                local now = os.clock()
                local flat = horizontal(root.Position, info.Center)
                local vert = math.abs(root.Position.Y - info.Center.Y)

                if flat <= reach and vert <= MINER_CFG.MaxVerticalReach then
                    result = "arrived"
                    break
                end

                if now - t0 > limit then
                    result = "inalcancavel"
                    break
                end

                setMoving(true)
                setStatus(string.format("indo até %s (%d studs)", tostring(info.Name), math.floor(flat)))

                local target = info.StandPoint or info.Center
                local wp = waypoints and waypoints[idx]
                if wp then
                    while idx < #waypoints
                        and horizontal(root.Position, wp.Position) < 3.5
                        and math.abs(root.Position.Y - wp.Position.Y) < 6 do
                        idx = idx + 1
                        wp = waypoints[idx]
                    end
                    target = wp.Position
                    if wp.Action == Enum.PathWaypointAction.Jump and horizontal(root.Position, wp.Position) < 5 then
                        hum.Jump = true
                    end
                    if idx >= #waypoints and horizontal(root.Position, wp.Position) < 3.5 then
                        target = info.Center
                    end
                end
                hum:MoveTo(target)

                if now - lastCheck >= 0.5 then
                    if lastPos and (root.Position - lastPos).Magnitude < 1 then
                        stuck = stuck + (now - lastCheck)
                    else
                        stuck = 0
                    end
                    lastPos, lastCheck = root.Position, now
                end

                if stuck > 1 then
                    hum.Jump = true
                end

                if stuck > 2.5 then
                    stuck = 0
                    recomputes = recomputes + 1
                    if recomputes > 3 then
                        result = "inalcancavel"
                        break
                    end
                    local okPath, newWps = computePath(root.Position, info.StandPoint or info.Center)
                    if not okPath then
                        result = "inalcancavel"
                        break
                    end
                    waypoints, idx = newWps, 1
                end

                task.wait(MINER_CFG.TickRate)
            end
        end

        return result
    end

    local function mineLoop(info, token)
        setMoving(false)

        local reach = info.Radius + MINER_CFG.MineDistance
        local t0 = os.clock()
        local invBefore = snapshotInventory()
        local lastInvCheck = 0
        local result, why = "parou", nil

        while isActive(token) do
            local _, hum, root = getChar()
            if not (hum and root) then
                result = "sem-personagem"
                break
            end

            local gone, goneWhy = oreGone(info)
            if gone then
                result, why = "coletado", goneWhy
                break
            end

            local now = os.clock()
            if now - lastInvCheck >= 0.3 then
                lastInvCheck = now
                if inventoryIncreased(invBefore, snapshotInventory()) then
                    result, why = "coletado", "item no inventário"
                    break
                end
            end

            if horizontal(root.Position, info.Center) > reach + MINER_CFG.ReachBuffer then
                result = "longe"
                break
            end

            if now - t0 > MINER_CFG.MineTimeout then
                result = "timeout"
                break
            end

            setStatus(string.format("minerando %s (coletados: %d)", tostring(info.Name), AutoMiner.Collected))
            hum:MoveTo(root.Position)
            faceTo(root, info.Center)
            aimTarget = info.Center

            if CombatCfg.SkillBusy then
                task.wait(0.03)
            else
                pcall(clickOnce)
                task.wait(MINER_CFG.ClickDelay)
            end
        end

        aimTarget = nil
        return result, why
    end

    local function mineTarget(info, token)
        local deadline = os.clock() + MINER_CFG.TargetMaxTime

        while isActive(token) and os.clock() < deadline do
            local walked = walkTo(info, token)
            if walked ~= "arrived" then
                setMoving(false)
                return walked
            end

            local result, why = mineLoop(info, token)
            if result ~= "longe" then
                return result, why
            end
        end

        setMoving(false)
        if isActive(token) then
            return "timeout"
        end
        return "parou"
    end

    local function step(token)
        if AutoMob.Enabled then
            setMoving(false)
            setStatus("pausado: desligue o Auto Mob para minerar")
            task.wait(0.5)
            return
        end

        local _, _, root = getChar()
        if not root then
            setMoving(false)
            aimTarget = nil
            AutoMiner.Target = nil
            setStatus("sem personagem")
            task.wait(0.5)
            return
        end

        setStatus("procurando ore no chão...")
        local info, stats = pickTarget(root, token)
        if not isActive(token) then return end

        if not info then
            setMoving(false)
            AutoMiner.Target = nil
            setStatus(string.format(
                "nenhum ore válido no chão (cristais: %d | no chão: %d | descartados: %d)",
                stats.Total, stats.Ground, stats.Rejected + stats.Blocked
            ))
            if stats.PathTries >= MINER_CFG.MaxPathChecks then
                task.wait(0.2)
            else
                task.wait(MINER_CFG.RescanDelay)
            end
            return
        end

        AutoMiner.Target = info.Inst
        local result, why = mineTarget(info, token)
        AutoMiner.Target = nil
        aimTarget = nil

        if not isActive(token) then return end

        if result == "coletado" then
            AutoMiner.Collected = AutoMiner.Collected + 1
            blockSpot(info.Center, MINER_CFG.MinedSpotTime)
            rejected[info.Inst] = os.clock() + MINER_CFG.MinedSpotTime
            setStatus(string.format("coletado (%s) | total: %d | procurando o próximo", tostring(why), AutoMiner.Collected), true)
        elseif result == "sumiu" then
            blockSpot(info.Center, 10)
            setStatus("o ore sumiu antes de minerar, procurando o próximo", true)
        elseif result == "inalcancavel" or result == "timeout" then
            rejected[info.Inst] = os.clock() + MINER_CFG.IgnoreTime
            if result == "timeout" then
                setStatus("sem confirmação de coleta em " .. tostring(info.Name) .. ", indo pro próximo", true)
            else
                setStatus("não deu pra chegar em " .. tostring(info.Name) .. ", indo pro próximo", true)
            end
        elseif result == "sem-personagem" then
            task.wait(0.5)
        end
    end

    local function startAutoMiner()
        if AutoMiner.Enabled then return end
        AutoMiner.Enabled = true
        AutoMiner.Token = AutoMiner.Token + 1
        local token = AutoMiner.Token

        if AutoMiner.Thread then
            pcall(task.cancel, AutoMiner.Thread)
            AutoMiner.Thread = nil
        end

        blocked = {}
        for k in pairs(rejected) do
            rejected[k] = nil
        end
        AutoMiner.Collected = 0
        aimTarget = nil

        setStatus("procurando ore no chão...", true)

        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)
        RunService:BindToRenderStep(STEER_NAME, Enum.RenderPriority.Camera.Value + 1, onRenderStep)

        AutoMiner.Thread = task.spawn(function()
            while isActive(token) do
                local ok, err = pcall(step, token)
                if not ok then
                    warn("[RAMDOM HUB] Auto Miner erro: " .. tostring(err))
                    setMoving(false)
                    aimTarget = nil
                    AutoMiner.Target = nil
                    setStatus("erro: " .. tostring(err), true)
                    task.wait(2)
                end
                task.wait(0.05)
            end
        end)
    end

    local function stopAutoMiner()
        if not AutoMiner.Enabled then return end
        AutoMiner.Enabled = false
        AutoMiner.Token = AutoMiner.Token + 1

        if AutoMiner.Thread then
            pcall(task.cancel, AutoMiner.Thread)
            AutoMiner.Thread = nil
        end

        AutoMiner.Target = nil
        aimTarget = nil
        setMoving(false)
        releaseMouse()
        setStatus("desligado", true)
        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)

        local _, hum, root = getChar()
        if hum and root then
            pcall(function() hum:MoveTo(root.Position) end)
        end
    end

    AutoMiner.Start = startAutoMiner
    AutoMiner.Stop = stopAutoMiner
end

