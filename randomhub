local function setTab(id)
    if currentTab == id then return end
    currentTab = id
    for name, data in pairs(Tabs) do
        local active = (name == id)
        data.indicator.Visible = active
        if active then
            data.btn.BackgroundTransparency = 0
            data.btn.BackgroundColor3 = Theme.Card
            data.textLabel.TextTransparency = 0
        else
            data.btn.BackgroundTransparency = 1
            data.textLabel.TextTransparency = 0.2
        end
    end
    for name, page in pairs(Pages) do
        page.Visible = (name == id)
    end
end

