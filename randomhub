SmallGui.Name = "FlyToggle"
SmallGui.ResetOnSpawn = false
SmallGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
SmallGui.IgnoreGuiInset = true
SmallGui.Parent = CoreGui

local FloatingBtn = Instance.new("TextButton")
FloatingBtn.Name = "FloatingBtn"
FloatingBtn.Size = UDim2.new(0, 60, 0, 60)
FloatingBtn.Position = UDim2.new(0, 20, 0.5, -30)
FloatingBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
FloatingBtn.BorderSizePixel = 0
FloatingBtn.Text = "🎲"
FloatingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
FloatingBtn.Font = Enum.Font.GothamBold
FloatingBtn.TextSize = 30
FloatingBtn.AutoButtonColor = false
FloatingBtn.Active = true
FloatingBtn.Parent = SmallGui
addCorner(FloatingBtn, 30)
addStroke(FloatingBtn, Color3.fromRGB(255, 255, 255), 2, 0.7)
addGradient(FloatingBtn, Theme.Accent1, Theme.Accent2, 45)

local uiOpen = true

local function openUI()
    if uiOpen then return end
    uiOpen = true
    ScreenGui.Enabled = true
    Main.Size = UDim2.new(0, 0, 0, 0)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    tween(Main, {Size = CONFIG.UISize, Position = CONFIG.UIOffset}, 0.3, Enum.EasingStyle.Back)
end

local function closeUI()
    if not uiOpen then return end
    uiOpen = false
    tween(Main, {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
    }, 0.2)
    task.wait(0.2)
    ScreenGui.Enabled = false
end

local function toggleUI()
    if uiOpen then closeUI() else openUI() end
end

local function destroyScript()
    pcall(AutoMob.Stop)
    pcall(AutoMiner.Stop)
    if _G.CombatToggleAttack then _G.CombatToggleAttack(false) end
    if _G.CombatToggleSkill then _G.CombatToggleSkill(false) end
    if _G.CombatToggleEquip then _G.CombatToggleEquip(false) end
    if _G.CombatEquipSlot then _G.CombatEquipSlot(0) end
    pcall(function() if ScreenGui then ScreenGui:Destroy() end end)
    pcall(function() if SmallGui then SmallGui:Destroy() end end)
    optimizationLoading = false
    restoreStructures()
    restoreAllShadows()
    stopAntiAFK()
    pcall(function()
        settings().Rendering.QualityLevel = OriginalGraphics
    end)
end

_G.__RamdomHubStop = destroyScript

FloatingBtn.MouseEnter:Connect(function()
    tween(FloatingBtn, {Size = UDim2.new(0, 66, 0, 66)}, 0.15)
end)
FloatingBtn.MouseLeave:Connect(function()
    tween(FloatingBtn, {Size = UDim2.new(0, 60, 0, 60)}, 0.15)
end)

local fDrag, fStart, fPos
FloatingBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        fDrag = true
        fStart = input.Position
        fPos = FloatingBtn.Position
    end
end)
FloatingBtn.InputChanged:Connect(function(input)
    if fDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - fStart
        FloatingBtn.Position = UDim2.new(fPos.X.Scale, fPos.X.Offset + delta.X, fPos.Y.Scale, fPos.Y.Offset + delta.Y)
    end
end)
FloatingBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local delta = (input.Position - fStart).Magnitude
        if delta < 5 then toggleUI() end
        fDrag = false
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    destroyScript()
end)

