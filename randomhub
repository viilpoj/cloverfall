--// FPS BOOST (dentro de Config)
--// ==========================================

local OriginalStructures = {}
local OriginalGraphics = settings().Rendering.QualityLevel
local optimizationConnection = nil
local StructureHighlights = {}
local LocateThread = nil
local LOCATE_RADIUS = 100

local setOtimizacao, getOtimizacao

local function isCharacterObject(obj)
    local current = obj
    while current and current ~= workspace do
        if current:IsA("Model") then
            local humanoid = current:FindFirstChildOfClass("Humanoid")
            if humanoid then
                return true
            end
        end
        current = current.Parent
    end
    return false
end

local function isGroundPart(part)
    if not part:IsA("BasePart") then return false end

    local name = part.Name:lower()
    local groundNames = {
        "baseplate", "floor", "ground", "chão", "chao",
        "grass", "grama", "terrain", "water", "água", "agua",
        "sand", "areia", "road", "estrada", "asphalt", "asfalto",
        "path", "caminho", "tile", "piso", "platform", "plataforma"
    }
    for _, pattern in ipairs(groundNames) do
        if name:find(pattern, 1, true) then
            return true
        end
    end

    local size = part.Size
    if size.Y < 3 and (size.X > 50 or size.Z > 50) then
        return true
    end

    return false
end

local function isIndicator(obj)
    if not obj:IsA("BasePart") then return false end

    local mat = obj.Material
    if mat == Enum.Material.Neon or mat == Enum.Material.ForceField then
        return true
    end

    local name = obj.Name:lower()
    local indicatorNames = {
        "range", "circle", "radius", "indicator", "hitbox",
        "aura", "ring", "zone", "area", "marker", "highlight",
        "visual", "effect", "glow", "outline", "selection"
    }
    for _, pattern in ipairs(indicatorNames) do
        if name:find(pattern, 1, true) then
            return true
        end
    end

    return false
end

local function addHighlight(obj)
    if not obj or not obj.Parent or not obj:IsA("BasePart") then return end
    if StructureHighlights[obj] then return end

    local sb = Instance.new("SelectionBox")
    sb.Adornee = obj
    sb.Color3 = Color3.fromRGB(120, 90, 255)
    sb.LineThickness = 0.05
    sb.SurfaceTransparency = 1
    sb.Parent = obj
    StructureHighlights[obj] = sb
end

local function removeHighlight(obj)
    if StructureHighlights[obj] then
        pcall(function() StructureHighlights[obj]:Destroy() end)
        StructureHighlights[obj] = nil
    end
end

local function removeAllHighlights()
    for obj, sb in pairs(StructureHighlights) do
        pcall(function() sb:Destroy() end)
    end
    StructureHighlights = {}
end

local function updateHighlightsLoop()
    if LocateThread then task.cancel(LocateThread) end
    LocateThread = task.spawn(function()
        while getLocateStructures and getLocateStructures() do
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local pos = root and root.Position

            if pos then
                for _, data in ipairs(OriginalStructures) do
                    if data.type == "part" and data.obj and data.obj.Parent then
                        local dist = (data.obj.Position - pos).Magnitude
                        if dist <= LOCATE_RADIUS then
                            addHighlight(data.obj)
                        else
                            removeHighlight(data.obj)
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

local function processStructure(obj)
    if isCharacterObject(obj) or isIndicator(obj) then return end

    if obj:IsA("BasePart") and not isGroundPart(obj) then
        table.insert(OriginalStructures, {
            obj = obj,
            type = "part",
            transparency = obj.Transparency,
            canCollide = obj.CanCollide,
        })
        obj.Transparency = 1
        obj.CanCollide = false

    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        local parent = obj.Parent
        local parentIsGround = parent and parent:IsA("BasePart") and isGroundPart(parent)
        local parentIsChar = parent and isCharacterObject(parent)
        if not parentIsGround and not parentIsChar then
            table.insert(OriginalStructures, {
                obj = obj,
                type = "decal",
                transparency = obj.Transparency,
            })
            obj.Transparency = 1
        end

    elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
        local parent = obj.Parent
        local parentIsGround = parent and parent:IsA("BasePart") and isGroundPart(parent)
        local parentIsChar = parent and isCharacterObject(parent)
        if not parentIsGround and not parentIsChar then
            table.insert(OriginalStructures, {
                obj = obj,
                type = "gui",
                enabled = obj.Enabled,
            })
            obj.Enabled = false
        end
    end
end

--// ============ CONTROLE DE SOMBRAS ============
local ShadowState = {
    GlobalShadows = nil,
    Parts = setmetatable({}, { __mode = "k" }),
    Connection = nil,
}

local function removeAllShadows()
    pcall(function()
        ShadowState.GlobalShadows = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
    end)

    ShadowState.Parts = setmetatable({}, { __mode = "k" })
    local count = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.CastShadow then
            ShadowState.Parts[obj] = true
            obj.CastShadow = false
            count = count + 1
            if count % 500 == 0 then
                task.wait()
            end
        end
    end

    if ShadowState.Connection then
        ShadowState.Connection:Disconnect()
    end
    ShadowState.Connection = workspace.DescendantAdded:Connect(function(obj)
        if not obj:IsA("BasePart") then return end
        task.defer(function()
            if obj.Parent and obj.CastShadow and getOtimizacao and getOtimizacao() then
                ShadowState.Parts[obj] = true
                obj.CastShadow = false
            end
        end)
    end)

    print(("[RAMDOM HUB] Sombras removidas em %d partes"):format(count))
end

local function restoreAllShadows()
    if ShadowState.Connection then
        ShadowState.Connection:Disconnect()
        ShadowState.Connection = nil
    end

    for part in pairs(ShadowState.Parts) do
        pcall(function()
            if part and part.Parent then
                part.CastShadow = true
            end
        end)
    end
    ShadowState.Parts = setmetatable({}, { __mode = "k" })

    if ShadowState.GlobalShadows ~= nil then
        pcall(function()
            Lighting.GlobalShadows = ShadowState.GlobalShadows
        end)
        ShadowState.GlobalShadows = nil
    end
    print("[RAMDOM HUB] Sombras restauradas!")
end
--// =============================================

local function hideStructures()
    if optimizationConnection then
        optimizationConnection:Disconnect()
        optimizationConnection = nil
    end

    OriginalStructures = {}
    local descendants = workspace:GetDescendants()
    local count = 0

    for _, obj in ipairs(descendants) do
        if not (getOtimizacao and getOtimizacao()) then break end
        
        processStructure(obj)
        count = count + 1
        
        if count % 500 == 0 then
            task.wait()
        end
    end

    if getOtimizacao and getOtimizacao() then
        optimizationConnection = workspace.DescendantAdded:Connect(function(obj)
            task.spawn(function()
                task.wait(0.1)
                if getOtimizacao and getOtimizacao() then
                    processStructure(obj)
                end
            end)
        end)
    end
    print(("[RAMDOM HUB] Estruturas escondidas: %d objetos"):format(#OriginalStructures))
end

local function restoreStructures()
    if optimizationConnection then
        optimizationConnection:Disconnect()
        optimizationConnection = nil
    end

    if LocateThread then
        pcall(task.cancel, LocateThread)
        LocateThread = nil
    end
    removeAllHighlights()

    for _, data in ipairs(OriginalStructures) do
        pcall(function()
            if data.obj and data.obj.Parent then
                if data.type == "part" then
                    data.obj.Transparency = data.transparency
                    data.obj.CanCollide = data.canCollide
                elseif data.type == "decal" then
                    data.obj.Transparency = data.transparency
                elseif data.type == "gui" then
                    data.obj.Enabled = data.enabled
                end
            end
        end)
    end
    OriginalStructures = {}
    print("[RAMDOM HUB] Estruturas restauradas!")
end

local optimizationLoading = false

local function waitAndHide(stateChecker)
    if optimizationLoading then return end
    optimizationLoading = true

    task.spawn(function()
        pcall(function()
            OriginalGraphics = settings().Rendering.QualityLevel
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level10
            
            StarterGui:SetCore("SendNotification", {
                Title = "Fps Boost",
                Text = "Renderizando o mapa, apagando estruturas e removendo sombras. Aguarde...",
                Duration = 4,
            })
        end)

        local lastCount = -1
        local stableTime = 0
        local startTime = os.clock()

        while optimizationLoading and stateChecker() and os.clock() - startTime < 10 do
            local count = #workspace:GetDescendants()
            if count == lastCount then
                stableTime = stableTime + 0.5
                if stableTime >= 2 then
                    break
                end
            else
                lastCount = count
                stableTime = 0
            end
            task.wait(0.5)
        end

        if optimizationLoading and stateChecker() then
            hideStructures()
            removeAllShadows()
            if getLocateStructures and getLocateStructures() then
                updateHighlightsLoop()
            end
        end

        pcall(function()
            settings().Rendering.QualityLevel = OriginalGraphics
        end)

        optimizationLoading = false
    end)
end

setOtimizacao, getOtimizacao = createToggleCard(
