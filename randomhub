local AntiAFKEnabled = false
local AntiAFKLoopThread = nil

local function performAntiAFKClick()
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0, 0))
        task.wait(0.05)
        VirtualUser:Button1Up(Vector2.new(0, 0))
    end)
end

local function startAntiAFK()
    AntiAFKEnabled = true
    if AntiAFKLoopThread then return end
    AntiAFKLoopThread = task.spawn(function()
        while AntiAFKEnabled do
            task.wait(300)
            if not AntiAFKEnabled then break end
            performAntiAFKClick()
        end
        AntiAFKLoopThread = nil
    end)
end

local function stopAntiAFK()
    AntiAFKEnabled = false
end

player.Idled:Connect(function()
    if AntiAFKEnabled then
        performAntiAFKClick()
    end
end)

--// ==========================================
--// AUTO FARM (MOB) — MOTOR
--// ==========================================
do
    local STEER_NAME = "RamdomHubAutoMobSteer"
    local ignored = setmetatable({}, { __mode = "k" })

    local function isActive(token)
        return AutoMob.Enabled and AutoMob.Token == token
    end

    local function getChar()
        local char = player.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            return char, hum, root
        end
        return nil
    end

    local function isPlayerModel(model)
        return Players:GetPlayerFromCharacter(model) ~= nil
    end

    local function modelRoot(model)
        if not model then return nil end
        return model:FindFirstChild("HumanoidRootPart")
            or model.PrimaryPart
            or model:FindFirstChildWhichIsA("BasePart", true)
    end

    local function mobAlive(mob)
        if not mob or not mob.Parent or not mob:IsDescendantOf(workspace) then
            return false
        end
        local h = mob:FindFirstChildOfClass("Humanoid")
        return h ~= nil and h.Health > 0
    end

    local function getMobLevel(model)
        local lvl = model.Name:match("%[Lv%.?%s*(%d+)%]") or model.Name:match("[Ll]v%.?%s*(%d+)")
        if lvl then return tonumber(lvl) end

        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("TextLabel") then
                local text = d.Text
                local lvlStr = text:match("[Ll]v%.?%s*(%d+)") or text:match("[Ll]evel%s*(%d+)")
                if lvlStr then
                    return tonumber(lvlStr)
                end
            end
        end
        return nil
    end

    local function isValidMob(model)
        if not model or not model:IsA("Model") then return false end
        if model == player.Character then return false end
        if isPlayerModel(model) then return false end
        
        local lowerName = string.lower(model.Name)
        if string.find(lowerName, "quest") or string.find(lowerName, "npc") then 
            return false 
        end

        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then 
                return false 
            end
        end
        return true
    end

    local function mobKey(name)
        local raw = string.lower(tostring(name or ""))
        local s = raw:gsub("%b[]", " ")
        s = s:gsub("%b()", " ")
        s = s:gsub("[%d%p]+", " ")
        s = s:gsub("%s+", " ")
        s = s:match("^%s*(.-)%s*$")
        if s == nil or s == "" then
            return raw
        end
        return s
    end
    AutoMob.MakeKey = mobKey

    local function typeId(key, level)
        return key .. "|" .. tostring(level or 0)
    end

    local function getMobType(model)
        local key = mobKey(model.Name)
        local level = getMobLevel(model)
        return key, level, typeId(key, level)
    end

    local function hasSelection()
        return next(AutoMob.SelectedTypes) ~= nil
    end

    local function matchesSelection(model)
        local key = mobKey(model.Name)
        local keyOk = false
        for _, t in pairs(AutoMob.SelectedTypes) do
            if t.Key == key then
                keyOk = true
                break
            end
        end
        if not keyOk then return false end

        return AutoMob.SelectedTypes[typeId(key, getMobLevel(model))] ~= nil
    end

    AutoMob.HasSelection = hasSelection

    AutoMob.IsSelected = function(id)
        return AutoMob.SelectedTypes[id] ~= nil
    end

    AutoMob.ToggleType = function(info)
        if not info or not info.Id then return end
        if AutoMob.SelectedTypes[info.Id] then
            AutoMob.SelectedTypes[info.Id] = nil
        else
            AutoMob.SelectedTypes[info.Id] = {
                Id = info.Id,
                Key = info.Key,
                Level = info.HasLevel and info.Level or nil,
                Name = info.Name,
            }
        end
        AutoMob.SelectionVersion = AutoMob.SelectionVersion + 1
    end

    AutoMob.ClearSelection = function()
        AutoMob.SelectedTypes = {}
        AutoMob.SelectionVersion = AutoMob.SelectionVersion + 1
    end

    local lastStatus, lastStatusTime = "", 0
    local function setStatus(text, force)
        if text == lastStatus then return end
        local now = os.clock()
        if not force and now - lastStatusTime < 0.25 then return end
        lastStatus, lastStatusTime = text, now
        AutoMob.Status = text
        if AutoMob.OnStatus then
            pcall(AutoMob.OnStatus, text)
        end
    end

    local moving = false
    local keysDown = false
    local steerPart = nil

    local function sendKeys(down)
        if not MOB_CFG.HoldShiftWhileMoving then return end
        pcall(function()
            VirtualInputManager:SendKeyEvent(down, Enum.KeyCode.LeftShift, false, game)
        end)
    end

    local function setMoving(state)
        if state then
            moving = true
            if not keysDown then
                keysDown = true
                sendKeys(true)
            end
        else
            moving = false
            if keysDown then
                keysDown = false
                sendKeys(false)
            end
        end
    end

    local function onRenderStep()
        local part = steerPart
        if not (part and part.Parent) then return end

        local _, _, root = getChar()
        if not root then return end

        local cam = workspace.CurrentCamera
        if not cam then return end

        local target = part.Position
        local flat = Vector3.new(target.X - root.Position.X, 0, target.Z - root.Position.Z)
        if flat.Magnitude > 0.5 then
            local dir = flat.Unit
            local cf = cam.CFrame
            local pitch = math.clamp(cf.LookVector.Y, -0.5, 0.5)
            local h = math.sqrt(1 - pitch * pitch)
            local look = Vector3.new(dir.X * h, pitch, dir.Z * h)
            cam.CFrame = CFrame.lookAt(cf.Position, cf.Position + look)
        end
    end

    AutoMob.ScanMobs = function()
        local mobs, byId = {}, {}
        local _, _, root = getChar()

        if root then
            for _, d in ipairs(workspace:GetDescendants()) do
                if d:IsA("Humanoid") then
                    local model = d.Parent
                    if model and model:IsA("Model") then
                        local mr = modelRoot(model)
                        if mr and (mr.Position - root.Position).Magnitude <= MOB_CFG.SearchRadius and isValidMob(model) then
                            local key, level, id = getMobType(model)
                            local item = byId[id]
                            if not item then
                                item = {
                                    Id = id,
                                    Name = model.Name,
                                    Key = key,
                                    Level = level or 1,
                                    HasLevel = level ~= nil,
                                    Model = model,
                                }
                                byId[id] = item
                                table.insert(mobs, item)
                            elseif model.Name < item.Name then
                                item.Name = model.Name
                                item.Model = model
                            end
                        end
                    end
                end
            end
        end

        for id, t in pairs(AutoMob.SelectedTypes) do
            if not byId[id] then
                local item = {
                    Id = id,
                    Name = t.Name,
                    Key = t.Key,
                    Level = t.Level or 1,
                    HasLevel = t.Level ~= nil,
                }
                byId[id] = item
                table.insert(mobs, item)
            end
        end

        table.sort(mobs, function(a, b)
            if a.Level ~= b.Level then return a.Level < b.Level end
            if a.Key ~= b.Key then return a.Key < b.Key end
            return a.Name < b.Name
        end)
        return mobs
    end

    AutoMob.IsMobNear = function(range)
        local _, _, root = getChar()
        if not root then return false end

        local onlySelected = MOB_CFG.AttackOnlySelected and AutoMob.Enabled and hasSelection()

        if onlySelected then
            local target = AutoMob.Target
            if target and mobAlive(target) then
                local tr = modelRoot(target)
                if tr and (tr.Position - root.Position).Magnitude <= range then
                    return true
                end
            end
        end

        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Humanoid") then
                local model = d.Parent
                if model and model:IsA("Model") then
                    local mr = modelRoot(model)
                    if mr and (mr.Position - root.Position).Magnitude <= range and isValidMob(model)
                        and (not onlySelected or matchesSelection(model)) then
                        return true
                    end
                end
            end
        end
        return false
    end

    local function isIgnored(model, now)
        local untilTime = ignored[model]
        if not untilTime then return false end
        if untilTime <= now then
            ignored[model] = nil
            return false
        end
        return true
    end

    local function findMob(root)
        local selected = hasSelection()
        if not selected and not MOB_CFG.AnyWhenNoSelection then
            return nil
        end

        local now = os.clock()
        local best, bestDist = nil, selected and MOB_CFG.SelectedSearchRadius or MOB_CFG.SearchRadius

        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Humanoid") and d.Health > 0 then
                local model = d.Parent
                if model and model:IsA("Model") and not isIgnored(model, now) then
                    local mr = modelRoot(model)
                    if mr then
                        local dist = (mr.Position - root.Position).Magnitude
                        if dist < bestDist and isValidMob(model) and (not selected or matchesSelection(model)) then
                            best, bestDist = model, dist
                        end
                    end
                end
            end
        end

        return best
    end

    local function getMobRadius(model, mr)
        local radius = 1
        local ok, size = pcall(function() return model:GetExtentsSize() end)
        if ok and size then
            radius = math.max(size.X, size.Z) / 2
        elseif mr then
            radius = math.max(mr.Size.X, mr.Size.Z) / 2
        end
        return math.clamp(radius, 1, 15)
    end

    local function faceTo(root, pos)
        local toTarget = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
        if toTarget.Magnitude < 0.1 then return end

        local look = root.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0.01 and flatLook.Unit:Dot(toTarget.Unit) > 0.99 then
            return 
        end

        root.CFrame = CFrame.lookAt(root.Position, Vector3.new(pos.X, root.Position.Y, pos.Z))
    end

    local function chase(mob, token)
        local mr0 = modelRoot(mob)
        local reach = MOB_CFG.StopDistance + getMobRadius(mob, mr0)

        local t0 = os.clock()
        local _, _, root0 = getChar()
        local startDist = (root0 and mr0) and (root0.Position - mr0.Position).Magnitude or 0
        local nearLimit = math.max(MOB_CFG.MobTimeout, startDist / 8)

        local lastNear = t0            
        local progressAt = t0          
        local bestDist = math.huge
        local engaged = false          
        local lastCheck, lastPos, stuck = t0, nil, 0
        local selVersion = AutoMob.SelectionVersion
        local reason = "fim"

        while isActive(token) do
            if not mobAlive(mob) then
                reason = "morto"
                break
            end

            if selVersion ~= AutoMob.SelectionVersion then
                selVersion = AutoMob.SelectionVersion
                local allowed
                if hasSelection() then
                    allowed = matchesSelection(mob)
                else
                    allowed = MOB_CFG.AnyWhenNoSelection
                end
                if not allowed then
                    reason = "desmarcado"
                    break
                end
            end

            local _, hum, root = getChar()
            local mr = modelRoot(mob)

            if not mr then
                reason = "sem-raiz"
                break
            end

            if not (hum and root) then
                setMoving(false)
                steerPart = nil
                local now = os.clock()
                lastNear, progressAt, bestDist = now, now, math.huge
                engaged, lastPos, stuck = false, nil, 0
                setStatus("aguardando seu personagem...")
                task.wait(0.3)
            else
                local now = os.clock()
                local dist = (root.Position - mr.Position).Magnitude
                steerPart = mr

                if engaged then
                    if dist > reach + MOB_CFG.StopBuffer then
                        engaged = false
                        bestDist, progressAt = dist, now
                    end
                elseif dist <= reach then
                    engaged = true
                end

                if engaged then
                    setMoving(false)
                    setStatus(string.format("perto de %s (%d studs)", mob.Name, math.floor(dist)))
                    hum:MoveTo(root.Position)
                    faceTo(root, mr.Position)
                    stuck, lastPos = 0, nil
                    lastNear, progressAt, bestDist = now, now, dist
                else
                    setMoving(true)
                    setStatus(string.format("indo até %s (%d studs)", mob.Name, math.floor(dist)))
                    hum:MoveTo(mr.Position)

                    if dist < bestDist - 1.5 then
                        bestDist, progressAt = dist, now
                    end
                    if dist <= reach + 4 then
                        lastNear, progressAt = now, now
                    end

                    if now - lastCheck >= 0.5 then
                        if lastPos and (root.Position - lastPos).Magnitude < 1 then
                            stuck = stuck + (now - lastCheck)
                        else
                            stuck = 0
                        end
                        lastPos, lastCheck = root.Position, now
                    end
                    if stuck > 1 then
                        hum.Jump = true
                    end

                    if now - progressAt > MOB_CFG.GiveUpTime or now - lastNear > nearLimit then
                        reason = "inalcancavel"
                        break
                    end
                end

                task.wait(MOB_CFG.TickRate)
            end
        end

        steerPart = nil
        return reason
    end

    local function step(token)
        local _, _, root = getChar()
        if not root then
            setMoving(false)
            steerPart = nil
            AutoMob.Target = nil
            setStatus("sem personagem")
            task.wait(0.5)
            return
        end

        local selected = hasSelection()
        if not selected and not MOB_CFG.AnyWhenNoSelection then
            setMoving(false)
            steerPart = nil
            AutoMob.Target = nil
            setStatus("marque um tipo de mob na lista")
            task.wait(0.5)
            return
        end

        local mob = findMob(root)
        if not mob then
            setMoving(false)
            steerPart = nil
            AutoMob.Target = nil
            if selected then
                setStatus("nenhum mob dos tipos marcados (esperando)")
            else
                setStatus("nenhum mob por perto")
            end
            task.wait(0.5)
            return
        end

        AutoMob.Target = mob
        local reason = chase(mob, token)
        AutoMob.Target = nil

        if reason == "inalcancavel" or reason == "sem-raiz" then
            ignored[mob] = os.clock() + MOB_CFG.IgnoreTime
            setStatus("não deu pra chegar em " .. tostring(mob.Name) .. ", indo pro próximo")
        end
    end

    local function startAutoMob()
        if AutoMob.Enabled then return end
        AutoMob.Enabled = true
        AutoMob.Token = AutoMob.Token + 1
        local token = AutoMob.Token

        if AutoMob.Thread then
            pcall(task.cancel, AutoMob.Thread)
            AutoMob.Thread = nil
        end

        setStatus("procurando mob...", true)

        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)
        RunService:BindToRenderStep(STEER_NAME, Enum.RenderPriority.Camera.Value + 1, onRenderStep)

        AutoMob.Thread = task.spawn(function()
            while isActive(token) do
                local ok, err = pcall(step, token)
                if not ok then
                    warn("[RAMDOM HUB] Auto Farm erro: " .. tostring(err))
                    setMoving(false)
                    steerPart = nil
                    AutoMob.Target = nil
                    setStatus("erro: " .. tostring(err), true)
                    task.wait(2)
                end
                task.wait(0.05)
            end
        end)
    end

    local function stopAutoMob()
        if not AutoMob.Enabled then return end
        AutoMob.Enabled = false
        AutoMob.Token = AutoMob.Token + 1

        if AutoMob.Thread then
            pcall(task.cancel, AutoMob.Thread)
            AutoMob.Thread = nil
        end

        AutoMob.Target = nil
        steerPart = nil
        setMoving(false)
        setStatus("desligado", true)
        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)

        local _, hum, root = getChar()
        if hum and root then
            pcall(function() hum:MoveTo(root.Position) end)
        end
    end

    AutoMob.Start = startAutoMob
    AutoMob.Stop = stopAutoMob
end

