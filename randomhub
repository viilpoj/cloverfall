--// AUTO FARM (MOB) — MOTOR
--// ==========================================
do
    local STEER_NAME = "RamdomHubAutoMobSteer"
    local ignored = setmetatable({}, { __mode = "k" })

    local function isActive(token)
        return AutoMob.Enabled and AutoMob.Token == token
    end

    local function getChar()
        local char = player.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            return char, hum, root
        end
        return nil
    end

    local function isPlayerModel(model)
        return Players:GetPlayerFromCharacter(model) ~= nil
    end

    local function modelRoot(model)
        if not model then return nil end
        return model:FindFirstChild("HumanoidRootPart")
            or model.PrimaryPart
            or model:FindFirstChildWhichIsA("BasePart", true)
    end

    local function mobAlive(mob)
        if not mob or not mob.Parent or not mob:IsDescendantOf(workspace) then
            return false
        end
        local h = mob:FindFirstChildOfClass("Humanoid")
        return h ~= nil and h.Health > 0
    end

    -- Aceita a barra nativa do Humanoid ou uma barra customizada no BillboardGui.
    -- Isso ajuda a evitar NPCs decorativos/de missão que têm modelo, mas não têm barra de vida.
    local HEALTH_BAR_HINTS = {
        "health", "healthbar", "health_bar", "hpbar", "hp_bar",
        "hitpoint", "hit_point", "vida", "life_bar", "lifebar",
    }
    local NPC_NAME_HINTS = {
        "quest", "npc", "vendor", "merchant", "shopkeeper",
        "blacksmith", "mission", "trainer", "questgiver", "quest giver",
    }

    local function containsHealthBarHint(value)
        local lower = string.lower(tostring(value or ""))
        for _, hint in ipairs(HEALTH_BAR_HINTS) do
            if lower:find(hint, 1, true) then
                return true
            end
        end
        return false
    end

    local function hasHealthBar(model, hum)
        local nativeOk, nativeBarEnabled = pcall(function()
            if hum.MaxHealth <= 0 or hum.HealthDisplayDistance <= 0
                or hum.DisplayDistanceType == Enum.HumanoidDisplayDistanceType.None then
                return false
            end

            local displayType = hum.HealthDisplayType
            return displayType == Enum.HumanoidHealthDisplayType.AlwaysOn
                or (displayType == Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
                    and hum.Health < hum.MaxHealth)
        end)
        if nativeOk and nativeBarEnabled then
            return true
        end

        for _, gui in ipairs(model:GetDescendants()) do
            if gui:IsA("BillboardGui") and gui.Enabled then
                if containsHealthBarHint(gui.Name) then
                    return true
                end

                for _, element in ipairs(gui:GetDescendants()) do
                    if containsHealthBarHint(element.Name) then
                        return true
                    end
                    if element:IsA("TextLabel") then
                        local labelText = string.lower(tostring(element.Text or ""))
                        if containsHealthBarHint(labelText)
                            or labelText:match("%d+%s*/%s*%d+")
                            or labelText:match("%d+%%") then
                            return true
                        end
                    end
                end
            end
        end
        return false
    end

    local function getMobLevel(model)
        local lvl = model.Name:match("%[Lv%.?%s*(%d+)%]") or model.Name:match("[Ll]v%.?%s*(%d+)")
        if lvl then return tonumber(lvl) end

        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("TextLabel") then
                local text = d.Text
                local lvlStr = text:match("[Ll]v%.?%s*(%d+)") or text:match("[Ll]evel%s*(%d+)")
                if lvlStr then
                    return tonumber(lvlStr)
                end
            end
        end
        return nil
    end

    local function isValidMob(model)
        if not model or not model:IsA("Model") then return false end
        if model == player.Character then return false end
        if isPlayerModel(model) then return false end
        
        local lowerName = string.lower(model.Name)
        for _, hint in ipairs(NPC_NAME_HINTS) do
            if lowerName:find(hint, 1, true) then
                return false
            end
        end

        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        if not hasHealthBar(model, hum) then return false end

        -- Interactivos suelen ser NPCs de diálogo/tienda/quest, no mobs de combate.
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
                return false
            end
        end
        return true
    end
    AutoMob.IsValidMob = isValidMob

    local function mobKey(name)
        local raw = string.lower(tostring(name or ""))
        local s = raw:gsub("%b[]", " ")
        s = s:gsub("%b()", " ")
        s = s:gsub("[%d%p]+", " ")
        s = s:gsub("%s+", " ")
        s = s:match("^%s*(.-)%s*$")
        if s == nil or s == "" then
            return raw
        end
        return s
    end
    AutoMob.MakeKey = mobKey

    local function typeId(key, level)
        return key .. "|" .. tostring(level or 0)
    end

    local function getMobType(model)
        local key = mobKey(model.Name)
        local level = getMobLevel(model)
        return key, level, typeId(key, level)
    end

    local function hasSelection()
        return next(AutoMob.SelectedTypes) ~= nil
    end

    local function matchesSelection(model)
        local key = mobKey(model.Name)
        local keyOk = false
        for _, t in pairs(AutoMob.SelectedTypes) do
            if t.Key == key then
                keyOk = true
                break
            end
        end
        if not keyOk then return false end

        return AutoMob.SelectedTypes[typeId(key, getMobLevel(model))] ~= nil
    end

    AutoMob.HasSelection = hasSelection

    AutoMob.IsSelected = function(id)
        return AutoMob.SelectedTypes[id] ~= nil
    end

    AutoMob.ToggleType = function(info)
        if not info or not info.Id then return end
        if AutoMob.SelectedTypes[info.Id] then
            AutoMob.SelectedTypes[info.Id] = nil
        else
            AutoMob.SelectedTypes[info.Id] = {
                Id = info.Id,
                Key = info.Key,
                Level = info.HasLevel and info.Level or nil,
                Name = info.Name,
            }
        end
        AutoMob.SelectionVersion = AutoMob.SelectionVersion + 1
    end

    AutoMob.ClearSelection = function()
        AutoMob.SelectedTypes = {}
        AutoMob.SelectionVersion = AutoMob.SelectionVersion + 1
    end

    local lastStatus, lastStatusTime = "", 0
    local function setStatus(text, force)
        if text == lastStatus then return end
        local now = os.clock()
        if not force and now - lastStatusTime < 0.25 then return end
        lastStatus, lastStatusTime = text, now
        AutoMob.Status = text
        if AutoMob.OnStatus then
            pcall(AutoMob.OnStatus, text)
        end
    end

    local moving = false
    local wDown = false
    local shiftDown = false
    local moveSequence = 0
    local steerPart = nil

    local function sendMoveKey(keyCode, down)
        pcall(function()
            VirtualInputManager:SendKeyEvent(down, keyCode, false, game)
        end)
    end

    local function releaseMoveKeys()
        -- Solta Shift primeiro e W depois para evitar deixar a corrida presa.
        if shiftDown then
            sendMoveKey(Enum.KeyCode.LeftShift, false)
            shiftDown = false
        end
        if wDown then
            sendMoveKey(Enum.KeyCode.W, false)
            wDown = false
        end
    end

    local function setMoving(state, immediateShift)
        if state then
            if moving then
                -- Se a recuperação acabou, garante Shift imediatamente sem reiniciar W.
                if immediateShift and MOB_CFG.HoldShiftWhileMoving and wDown and not shiftDown then
                    sendMoveKey(Enum.KeyCode.LeftShift, true)
                    shiftDown = true
                end
                return
            end

            moving = true
            moveSequence = moveSequence + 1
            local thisSequence = moveSequence

            -- O jogo exige W pressionado antes de Shift para ativar a corrida.
            sendMoveKey(Enum.KeyCode.W, true)
            wDown = true

            if MOB_CFG.HoldShiftWhileMoving then
                if immediateShift then
                    -- Após a recuperação, retoma W + Shift sem o atraso normal.
                    sendMoveKey(Enum.KeyCode.LeftShift, true)
                    shiftDown = true
                else
                    task.delay(0.35, function()
                        -- Só ativa a corrida se o mesmo ciclo de movimento ainda estiver ativo.
                        if moving and moveSequence == thisSequence and wDown
                            and MOB_CFG.HoldShiftWhileMoving and not shiftDown then
                            sendMoveKey(Enum.KeyCode.LeftShift, true)
                            shiftDown = true
                        end
                    end)
                end
            end
        else
            moving = false
            moveSequence = moveSequence + 1 -- invalida qualquer atraso pendente
            releaseMoveKeys()
        end
    end

    -- Registra quando o obstáculo saiu da frente, mas permite repetir a recuperação
    -- se ele continuar detectado após o intervalo de segurança.
    local obstacleLatched = false
    local obstacleClearSince = nil
    local lastObstacleRecoveryAt = -math.huge
    local recoverySpaceDown = false

    local function getForwardDirection(root)
        local cam = workspace.CurrentCamera
        local look = (cam and cam.CFrame.LookVector) or root.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)

        if flat.Magnitude < 0.05 then
            local rootLook = root.CFrame.LookVector
            flat = Vector3.new(rootLook.X, 0, rootLook.Z)
        end

        if flat.Magnitude < 0.05 then
            return Vector3.new(0, 0, -1)
        end
        return flat.Unit
    end

    local function raycastPhysicalObstacle(origin, direction)
        local exclusions = {}
        local character = player.Character
        if character then
            table.insert(exclusions, character)
        end

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = exclusions
        params.IgnoreWater = true
        pcall(function()
            params.RespectCanCollide = true
        end)

        -- Ignora modelos com Humanoid (incluindo o mob-alvo) e continua o Raycast
        -- para detectar a parede ou peça sólida atrás deles.
        for _ = 1, 12 do
            local result = workspace:Raycast(origin, direction * MOB_CFG.ObstacleRayDistance, params)
            if not result then
                return nil
            end

            local ancestor = result.Instance
            local humanoidModel = nil
            while ancestor and ancestor ~= workspace do
                if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
                    humanoidModel = ancestor
                    break
                end
                ancestor = ancestor.Parent
            end

            if humanoidModel then
                table.insert(exclusions, humanoidModel)
                params.FilterDescendantsInstances = exclusions
            else
                return result
            end
        end

        return nil
    end

    local function detectFrontObstacle(root)
        if not MOB_CFG.ObstacleRecoveryEnabled then
            return nil
        end

        local forward = getForwardDirection(root)
        local side = Vector3.new(-forward.Z, 0, forward.X)
        local lateralOffsets = {-MOB_CFG.ObstacleRayWidth, 0, MOB_CFG.ObstacleRayWidth}

        -- Dois níveis e três posições laterais ajudam a detectar paredes e obstáculos
        -- sólidos sem confundir o chão com uma parede.
        for _, heightOffset in ipairs(MOB_CFG.ObstacleRayHeights) do
            for _, lateralOffset in ipairs(lateralOffsets) do
                local origin = root.Position
                    + Vector3.new(0, heightOffset, 0)
                    + side * lateralOffset
                local hit = raycastPhysicalObstacle(origin, forward)
                if hit then
                    return hit
                end
            end
        end

        return nil
    end

    local function retreatTwoStuds(hum, root, token)
        if not (isActive(token) and hum and root and hum.Parent and root.Parent) then
            return
        end

        local startPosition = root.Position
        local backward = -getForwardDirection(root)
        local destination = startPosition + backward * MOB_CFG.ObstacleRetreatDistance
        -- Humanoid:MoveTo considera o destino alcançado quando chega a cerca de 1 stud.
        -- O alvo de movimento fica 0,95 stud além do destino desejado para compensar isso.
        local moveTarget = destination + backward * 0.95
        local reachedDestination = false
        local finishedConnection

        finishedConnection = hum.MoveToFinished:Connect(function(reached)
            if reached then
                reachedDestination = true
            end
        end)

        -- O destino fica exatamente 2 studs atrás do ponto inicial. A movimentação
        -- usa MoveTo e possui limite de tempo para não prender o Auto Farm.
        hum:MoveTo(moveTarget)
        local deadline = os.clock() + MOB_CFG.ObstacleRetreatTimeout
        while isActive(token) and hum.Parent and root.Parent do
            local delta = root.Position - destination
            local horizontalDistance = Vector3.new(delta.X, 0, delta.Z).Magnitude
            if horizontalDistance <= 0.25 or reachedDestination then
                break
            end
            if os.clock() >= deadline then
                break
            end
            task.wait(0.025)
        end

        pcall(function()
            hum:MoveTo(root.Position)
        end)
        if finishedConnection then
            finishedConnection:Disconnect()
        end
    end

    local function performOneObstacleJump(token)
        if not isActive(token) then
            return false
        end

        -- Um clique curto em Espaço: pressiona e solta. Não espera o pouso.
        sendMoveKey(Enum.KeyCode.Space, true)
        recoverySpaceDown = true
        task.wait(MOB_CFG.ObstacleJumpPressDuration)
        sendMoveKey(Enum.KeyCode.Space, false)
        recoverySpaceDown = false

        return isActive(token)
    end

    local function performObstacleRecovery(hum, root, token)
        -- Solta W/Shift antes de recuar para que as entradas não disputem o movimento.
        setMoving(false)
        sendMoveKey(Enum.KeyCode.S, false)
        sendMoveKey(Enum.KeyCode.Space, false)
        recoverySpaceDown = false

        retreatTwoStuds(hum, root, token)
        if not isActive(token) then
            sendMoveKey(Enum.KeyCode.Space, false)
            recoverySpaceDown = false
            return false
        end

        for jumpIndex = 1, MOB_CFG.ObstacleJumpCount do
            if not performOneObstacleJump(token) then
                break
            end

            -- Intervalo entre cliques, nunca mantém Espaço pressionado.
            -- Após o sexto clique, prossegue sem pausa adicional.
            if jumpIndex < MOB_CFG.ObstacleJumpCount then
                task.wait(MOB_CFG.ObstacleJumpGap)
            end
        end

        -- Nunca deixa Espaço preso, inclusive se o Auto Farm for desligado no meio.
        sendMoveKey(Enum.KeyCode.Space, false)
        recoverySpaceDown = false
        sendMoveKey(Enum.KeyCode.S, false)

        -- Retoma imediatamente mantendo W e Shift esquerdo pressionados.
        if isActive(token) then
            setMoving(true, true)
        end
        return isActive(token)
    end

    local function onRenderStep()
        local part = steerPart
        if not (part and part.Parent) then return end

        local _, _, root = getChar()
        if not root then return end

        local cam = workspace.CurrentCamera
        if not cam then return end

        -- A assistência de mira fica restrita ao alvo atual que corresponde à
        -- seleção do usuário e só entra quando ele está a 12 studs ou menos.
        local selectedMob = AutoMob.Target
        if MOB_CFG.CloseRangeAimEnabled and selectedMob and mobAlive(selectedMob)
            and hasSelection() and matchesSelection(selectedMob) then
            local targetRoot = modelRoot(selectedMob)
            if targetRoot then
                local distance = (targetRoot.Position - root.Position).Magnitude
                if distance <= MOB_CFG.CloseRangeAimDistance then
                    local aimPart = selectedMob:FindFirstChild("UpperTorso")
                        or selectedMob:FindFirstChild("Torso")
                        or selectedMob:FindFirstChild("Head")
                        or targetRoot
                    if aimPart and aimPart:IsA("BasePart") then
                        local aimPosition = aimPart.Position
                        local direction = aimPosition - cam.CFrame.Position
                        if direction.Magnitude > 0.1 then
                            local desired = CFrame.lookAt(cam.CFrame.Position, aimPosition)
                            cam.CFrame = cam.CFrame:Lerp(desired, MOB_CFG.CloseRangeAimLerp)
                            return
                        end
                    end
                end
            end
        end

        -- Mantém o direcionamento horizontal usado para navegar até o mob; ele
        -- não é a assistência de mira de curta distância acima.
        local target = part.Position
        local flat = Vector3.new(target.X - root.Position.X, 0, target.Z - root.Position.Z)
        if flat.Magnitude > 0.5 then
            local dir = flat.Unit
            local cf = cam.CFrame
            local pitch = math.clamp(cf.LookVector.Y, -0.5, 0.5)
            local h = math.sqrt(1 - pitch * pitch)
            local look = Vector3.new(dir.X * h, pitch, dir.Z * h)
            cam.CFrame = CFrame.lookAt(cf.Position, cf.Position + look)
        end
    end

    AutoMob.ScanMobs = function()
        local mobs, byId = {}, {}
        local _, _, root = getChar()

        if root then
            for _, d in ipairs(workspace:GetDescendants()) do
                if d:IsA("Humanoid") then
                    local model = d.Parent
                    if model and model:IsA("Model") then
                        local mr = modelRoot(model)
                        -- A lista mostra mobs em todo o mapa, não só os que estão próximos.
                        if mr and isValidMob(model) then
                            local key, level, id = getMobType(model)
                            local item = byId[id]
                            if not item then
                                item = {
                                    Id = id,
                                    Name = model.Name,
                                    Key = key,
                                    Level = level or 1,
                                    HasLevel = level ~= nil,
                                    Model = model,
                                }
                                byId[id] = item
                                table.insert(mobs, item)
                            elseif model.Name < item.Name then
                                item.Name = model.Name
                                item.Model = model
                            end
                        end
                    end
                end
            end
        end

        for id, t in pairs(AutoMob.SelectedTypes) do
            if not byId[id] then
                local item = {
                    Id = id,
                    Name = t.Name,
                    Key = t.Key,
                    Level = t.Level or 1,
                    HasLevel = t.Level ~= nil,
                }
                byId[id] = item
                table.insert(mobs, item)
            end
        end

        table.sort(mobs, function(a, b)
            if a.Level ~= b.Level then return a.Level < b.Level end
            if a.Key ~= b.Key then return a.Key < b.Key end
            return a.Name < b.Name
        end)
        return mobs
    end

    AutoMob.IsMobNear = function(range)
        local _, _, root = getChar()
        if not root then return false end

        local onlySelected = MOB_CFG.AttackOnlySelected and AutoMob.Enabled and hasSelection()

        if onlySelected then
            local target = AutoMob.Target
            if target and mobAlive(target) then
                local tr = modelRoot(target)
                if tr and (tr.Position - root.Position).Magnitude <= range then
                    return true
                end
            end
        end

        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Humanoid") then
                local model = d.Parent
                if model and model:IsA("Model") then
                    local mr = modelRoot(model)
                    if mr and (mr.Position - root.Position).Magnitude <= range and isValidMob(model)
                        and (not onlySelected or matchesSelection(model)) then
                        return true
                    end
                end
            end
        end
        return false
    end

    local function isIgnored(model, now)
        local untilTime = ignored[model]
        if not untilTime then return false end
        if untilTime <= now then
            ignored[model] = nil
            return false
        end
        return true
    end

    local function findMob(root)
        local selected = hasSelection()
        if not selected and not MOB_CFG.AnyWhenNoSelection then
            return nil
        end

        local now = os.clock()
        -- Com um tipo selecionado, não aplica limite de distância: procura esse tipo
        -- em qualquer ponto do mapa que esteja replicado/carregado no cliente.
        local best, bestDist = nil, selected and MOB_CFG.SelectedSearchRadius or MOB_CFG.SearchRadius

        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Humanoid") and d.Health > 0 then
                local model = d.Parent
                if model and model:IsA("Model") and not isIgnored(model, now) then
                    local mr = modelRoot(model)
                    if mr then
                        local dist = (mr.Position - root.Position).Magnitude
                        if dist < bestDist and isValidMob(model) and (not selected or matchesSelection(model)) then
                            best, bestDist = model, dist
                        end
                    end
                end
            end
        end

        return best
    end

    local function getMobRadius(model, mr)
        local radius = 1
        local ok, size = pcall(function() return model:GetExtentsSize() end)
        if ok and size then
            radius = math.max(size.X, size.Z) / 2
        elseif mr then
            radius = math.max(mr.Size.X, mr.Size.Z) / 2
        end
        return math.clamp(radius, 1, 15)
    end

    local function faceTo(root, pos)
        local toTarget = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
        if toTarget.Magnitude < 0.1 then return end

        local look = root.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0.01 and flatLook.Unit:Dot(toTarget.Unit) > 0.99 then
            return 
        end

        root.CFrame = CFrame.lookAt(root.Position, Vector3.new(pos.X, root.Position.Y, pos.Z))
    end

    local function chase(mob, token)
        local mr0 = modelRoot(mob)
        local reach = MOB_CFG.StopDistance + getMobRadius(mob, mr0)

        local t0 = os.clock()
        local _, _, root0 = getChar()
        local startDist = (root0 and mr0) and (root0.Position - mr0.Position).Magnitude or 0
        local nearLimit = math.max(MOB_CFG.MobTimeout, startDist / 8)

        local lastNear = t0            
        local progressAt = t0          
        local bestDist = math.huge
        local engaged = false          
        local selVersion = AutoMob.SelectionVersion
        local reason = "fim"

        while isActive(token) do
            if not mobAlive(mob) then
                reason = "morto"
                break
            end

            if selVersion ~= AutoMob.SelectionVersion then
                selVersion = AutoMob.SelectionVersion
                local allowed
                if hasSelection() then
                    allowed = matchesSelection(mob)
                else
                    allowed = MOB_CFG.AnyWhenNoSelection
                end
                if not allowed then
                    reason = "desmarcado"
                    break
                end
            end

            local _, hum, root = getChar()
            local mr = modelRoot(mob)

            if not mr then
                reason = "sem-raiz"
                break
            end

            if not (hum and root) then
                setMoving(false)
                steerPart = nil
                local now = os.clock()
                lastNear, progressAt, bestDist = now, now, math.huge
                engaged = false
                setStatus("aguardando seu personagem...")
                task.wait(0.3)
            else
                local now = os.clock()
                local dist = (root.Position - mr.Position).Magnitude
                steerPart = mr

                if engaged then
                    if dist > reach + MOB_CFG.StopBuffer then
                        engaged = false
                        bestDist, progressAt = dist, now
                    end
                elseif dist <= reach then
                    engaged = true
                end

                if engaged then
                    setMoving(false)
                    setStatus(string.format("perto de %s (%d studs)", mob.Name, math.floor(dist)))
                    hum:MoveTo(root.Position)
                    faceTo(root, mr.Position)
                    lastNear, progressAt, bestDist = now, now, dist
                else
                    local recoveredFromObstacle = false
                    if MOB_CFG.ObstacleRecoveryEnabled then
                        local obstacleHit = detectFrontObstacle(root)
                        if obstacleHit then
                            obstacleClearSince = nil
                            -- Se o mesmo obstáculo continuar à frente, repete a sequência
                            -- após o cooldown em vez de bloquear novas tentativas pelo latch.
                            if now - lastObstacleRecoveryAt >= MOB_CFG.ObstacleRecoveryCooldown then
                                obstacleLatched = true
                                setStatus("obstáculo à frente: recuando e pulando", true)
                                recoveredFromObstacle = performObstacleRecovery(hum, root, token)
                                -- O intervalo de segurança começa ao terminar a sequência.
                                lastObstacleRecoveryAt = os.clock()

                                if recoveredFromObstacle and isActive(token) and mr.Parent then
                                    dist = (root.Position - mr.Position).Magnitude
                                    now = os.clock()
                                    bestDist = dist
                                    progressAt = now
                                    lastNear = now
                                end
                            end
                        elseif obstacleLatched then
                            if not obstacleClearSince then
                                obstacleClearSince = now
                            elseif now - obstacleClearSince >= MOB_CFG.ObstacleClearResetDelay then
                                obstacleLatched = false
                                obstacleClearSince = nil
                            end
                        end
                    end

                    if isActive(token) then
                        setMoving(true)
                        setStatus(string.format("indo até %s (%d studs)", mob.Name, math.floor(dist)))
                    end
                    -- O deslocamento até o alvo é feito pelo controle normal do jogo:
                    -- W fica pressionado e Shift é acionado após 0,35 segundo.
                    -- Não chamar MoveTo(mr.Position) aqui evita competir com o input de corrida.

                    if dist < bestDist - 1.5 then
                        bestDist, progressAt = dist, now
                    end
                    if dist <= reach + 4 then
                        lastNear, progressAt = now, now
                    end

                    if now - progressAt > MOB_CFG.GiveUpTime
                        or now - lastNear > nearLimit then
                        reason = "inalcancavel"
                        break
                    end
                end

                task.wait(MOB_CFG.TickRate)
            end
        end

        steerPart = nil
        return reason
    end

    local function step(token)
        local _, _, root = getChar()
        if not root then
            setMoving(false)
            steerPart = nil
            AutoMob.Target = nil
            setStatus("sem personagem")
            task.wait(0.5)
            return
        end

        local selected = hasSelection()
        if not selected and not MOB_CFG.AnyWhenNoSelection then
            setMoving(false)
            steerPart = nil
            AutoMob.Target = nil
            setStatus("marque um tipo de mob na lista")
            task.wait(0.5)
            return
        end

        local mob = findMob(root)
        if not mob then
            setMoving(false)
            steerPart = nil
            AutoMob.Target = nil
            if selected then
                setStatus("nenhum mob dos tipos marcados (esperando)")
            else
                setStatus("nenhum mob por perto")
            end
            task.wait(0.5)
            return
        end

        AutoMob.Target = mob
        local reason = chase(mob, token)
        AutoMob.Target = nil

        if reason == "inalcancavel" or reason == "sem-raiz" then
            ignored[mob] = os.clock() + MOB_CFG.IgnoreTime
            setStatus("não deu pra chegar em " .. tostring(mob.Name) .. ", indo pro próximo")
        end
    end

    local function startAutoMob()
        if AutoMob.Enabled then return end
        AutoMob.Enabled = true
        AutoMob.Token = AutoMob.Token + 1
        local token = AutoMob.Token

        if AutoMob.Thread then
            pcall(task.cancel, AutoMob.Thread)
            AutoMob.Thread = nil
        end

        obstacleLatched = false
        obstacleClearSince = nil
        lastObstacleRecoveryAt = -math.huge
        recoverySpaceDown = false
        sendMoveKey(Enum.KeyCode.Space, false)
        sendMoveKey(Enum.KeyCode.S, false)
        setStatus("procurando mob...", true)

        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)
        RunService:BindToRenderStep(STEER_NAME, Enum.RenderPriority.Camera.Value + 1, onRenderStep)

        AutoMob.Thread = task.spawn(function()
            while isActive(token) do
                local ok, err = pcall(step, token)
                if not ok then
                    warn("[RAMDOM HUB] Auto Farm erro: " .. tostring(err))
                    setMoving(false)
                    sendMoveKey(Enum.KeyCode.S, false)
                    sendMoveKey(Enum.KeyCode.Space, false)
                    recoverySpaceDown = false
                    steerPart = nil
                    AutoMob.Target = nil
                    setStatus("erro: " .. tostring(err), true)
                    task.wait(2)
                end
                task.wait(0.05)
            end
        end)
    end

    local function stopAutoMob()
        if not AutoMob.Enabled then return end
        AutoMob.Enabled = false
        AutoMob.Token = AutoMob.Token + 1

        if AutoMob.Thread then
            pcall(task.cancel, AutoMob.Thread)
            AutoMob.Thread = nil
        end

        AutoMob.Target = nil
        steerPart = nil
        setMoving(false)
        -- Libera também teclas temporárias usadas durante a recuperação.
        sendMoveKey(Enum.KeyCode.S, false)
        sendMoveKey(Enum.KeyCode.Space, false)
        recoverySpaceDown = false
        obstacleLatched = false
        obstacleClearSince = nil
        setStatus("desligado", true)
        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)

        local _, hum, root = getChar()
        if hum and root then
            pcall(function() hum:MoveTo(root.Position) end)
        end
    end

    AutoMob.Start = startAutoMob
    AutoMob.Stop = stopAutoMob
end

--// ==========================================
--// AUTO MINER — MOTOR
--// ==========================================
do
    local PathfindingService = game:GetService("PathfindingService")
    local STEER_NAME = "RamdomHubAutoMinerSteer"

    local rejected = setmetatable({}, { __mode = "k" })
    local blocked = {}
    local nameKindCache = {}

    local candidateCache = nil
    local candidateCacheAt = 0
    local aimTarget = nil
    local moving, keysDown = false, false

    local function dbg(...)
        if MINER_CFG.Debug then
            print("[RAMDOM HUB][Miner]", ...)
        end
