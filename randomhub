    end

    local function worldBounds(cf, size)
        local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
        local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
        local ex = math.abs(r00) * hx + math.abs(r01) * hy + math.abs(r02) * hz
        local ey = math.abs(r10) * hx + math.abs(r11) * hy + math.abs(r12) * hz
        local ez = math.abs(r20) * hx + math.abs(r21) * hy + math.abs(r22) * hz
        return Vector3.new(x - ex, y - ey, z - ez), Vector3.new(x + ex, y + ey, z + ez)
    end

    local function livingAncestor(inst)
        local cur = inst
        while cur and cur ~= workspace do
            if cur:IsA("Model") and cur:FindFirstChildOfClass("Humanoid") then
                return cur
            end
            cur = cur.Parent
        end
        return nil
    end

    local ORE_PATTERNS = { "%f[%a]ores?%f[%A]" }
    local CRYSTAL_PATTERNS = {
        "crystals?", "cristal", "cristai", "%f[%a]gems?%f[%A]",
        "gemstone", "minerals?", "geodes?",
    }
    local RESOURCE_CONTEXT_PATTERNS = {
        "%f[%a]ores?%f[%A]", "crystals?", "cristal", "cristai",
        "%f[%a]gems?%f[%A]", "gemstone", "minerals?", "geodes?",
    }
    local BLOCKED_WORDS = {
        "shop", "store", "sell", "npc", "quest", "vendor", "merchant",
        "forge", "furnace", "smelt", "chest", "crate", "cart", "portal", "sign",
        "sword", "weapon", "pickaxe", "axe", "armor", "helmet", "tool", "coin",
        "ingot", "statue", "decoration", "building", "platform", "wall", "door", "gate",
        "pillar", "pilar", "column", "coluna",
        "decor", "lamp", "chandelier", "ornament", "furniture", "plant",
        "bush", "flower", "tree", "scenery", "prop", "display", "showcase",
    }

    local PILLAR_PATTERNS = {
        "%f[%a]pillars?%f[%A]", "%f[%a]pilar%f[%A]", "%f[%a]pilares%f[%A]",
        "%f[%a]columns?%f[%A]", "%f[%a]coluna%f[%A]", "%f[%a]colunas%f[%A]",
    }

    local KNOWN_ORE_TYPES = {
        { Label = "Iron", Names = { "iron", "ferro" } },
        { Label = "Diamond", Names = { "diamond", "diamante" } },
        { Label = "Gold", Names = { "gold", "ouro" } },
        { Label = "Copper", Names = { "copper", "cobre" } },
        { Label = "Silver", Names = { "silver", "prata" } },
        { Label = "Coal", Names = { "coal", "carvao", "carvão" } },
        { Label = "Emerald", Names = { "emerald", "esmeralda" } },
        { Label = "Ruby", Names = { "ruby", "rubi" } },
        { Label = "Sapphire", Names = { "sapphire", "safira" } },
        { Label = "Amethyst", Names = { "amethyst", "ametista" } },
        { Label = "Quartz", Names = { "quartz", "quartzo" } },
        { Label = "Obsidian", Names = { "obsidian", "obsidiana" } },
        { Label = "Tin", Names = { "tin", "estanho" } },
        { Label = "Cobalt", Names = { "cobalt", "cobalto" } },
        { Label = "Mithril", Names = { "mithril", "mithril ore" } },
        { Label = "Platinum", Names = { "platinum", "platina" } },
        { Label = "Uranium", Names = { "uranium", "uranio", "urânio" } },
        { Label = "Titanium", Names = { "titanium", "titanio", "titânio" } },
        { Label = "Nickel", Names = { "nickel", "niquel", "níquel" } },
    }

    local function normalizeName(name)
        local s = tostring(name or "")
        s = s:gsub("(%l)(%u)", "%1 %2")
        s = s:gsub("[_%-%\.]+", " ")
        s = s:gsub("%s+", " ")
        return string.lower(s)
    end

    local function matchesAny(s, patterns)
        for _, p in ipairs(patterns) do
            if s:find(p) then return true end
        end
        return false
    end

    local function titleCase(s)
        s = tostring(s or ""):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
        return (s:gsub("%S+", function(word)
            return word:sub(1, 1):upper() .. word:sub(2)
        end))
    end

    local function knownOreTypeFromText(text)
        local s = normalizeName(text)
        for _, entry in ipairs(KNOWN_ORE_TYPES) do
            for _, alias in ipairs(entry.Names) do
                local a = normalizeName(alias)
                if s == a or s:find(" " .. a .. " ", 1, true)
                    or s:sub(1, #a + 1) == a .. " "
                    or s:sub(-#a - 1) == " " .. a then
                    return entry.Label
                end
            end
        end
        return nil
    end

    local function genericOreTypeFromText(text, fallback)
        local s = normalizeName(text)
        local cleaned = s
        for _, pattern in ipairs({
            "%f[%a]ores?%f[%A]", "crystals?", "cristais?", "%f[%a]gems?%f[%A]",
            "gemstone", "minerals?", "geodes?", "veins?", "deposits?", "nodes?",
            "fragments?", "shards?", "chunks?", "large", "small", "ancient", "rich",
        }) do
            cleaned = cleaned:gsub(pattern, " ")
        end
        cleaned = cleaned:gsub("%d+", " "):gsub("[%p_]+", " "):gsub("%s+", " ")
        cleaned = cleaned:match("^%s*(.-)%s*$") or ""
        if cleaned ~= "" then return titleCase(cleaned) end
        return fallback or "Other Ores"
    end

    local function attributesSuggestOre(inst)
        if not inst then return false end
        local ok, attrs = pcall(function() return inst:GetAttributes() end)
        if not ok or type(attrs) ~= "table" then return false end

        for key, value in pairs(attrs) do
            local k = normalizeName(key)
            local compactKey = k:gsub("%s+", "")
            local keyNamesOre = k:find("ore", 1, true)
                or k:find("mineral", 1, true)
                or k:find("crystal", 1, true)
                or k:find("gem", 1, true)

            if keyNamesOre then
                if value == true then return true end
                if type(value) == "string" and value ~= "" then
                    if knownOreTypeFromText(value)
                        or matchesAny(normalizeName(value), RESOURCE_CONTEXT_PATTERNS) then
                        return true
                    end
                end
            elseif (compactKey == "resourcetype" or compactKey == "nodetype"
                or compactKey == "materialtype") and type(value) == "string" then
                if knownOreTypeFromText(value)
                    or matchesAny(normalizeName(value), RESOURCE_CONTEXT_PATTERNS) then
                    return true
                end
            elseif (compactKey == "ismineable" or compactKey == "mineable")
                and value == true then
                local named = normalizeName(inst.Name)
                if matchesAny(named, RESOURCE_CONTEXT_PATTERNS)
                    or knownOreTypeFromText(named) then
                    return true
                end
            end
        end
        return false
    end

    local function nameKind(name)
        local cached = nameKindCache[name]
        if cached ~= nil then return cached end

        local s = normalizeName(name)
        local kind = false
        local isBlockedName = false
        for _, w in ipairs(BLOCKED_WORDS) do
            if s:find(w, 1, true) then
                isBlockedName = true
                break
            end
        end

        if not isBlockedName then
            local known = knownOreTypeFromText(s)
            local hasResourceContext = matchesAny(s, RESOURCE_CONTEXT_PATTERNS)
            local bareKnownType = known ~= nil and s == string.lower(known)
            local knownTypeWithResourceSuffix = known ~= nil and matchesAny(s, {
                "veins?", "deposits?", "nodes?", "fragments?", "shards?", "chunks?", "clusters?",
            })
            if matchesAny(s, ORE_PATTERNS) or hasResourceContext
                or bareKnownType or knownTypeWithResourceSuffix then
                kind = "ore"
            end
        end

        nameKindCache[name] = kind
        return kind
    end

    local function isOreItemName(name, allowBareType)
        local normalized = normalizeName(name)
        normalized = normalized:gsub("%s*[xX]%s*%d+%s*$", "")
            :gsub("%s*%(%d+%)%s*$", "")
            :gsub("^%d+%s*[xX]%s*", "")
            :match("^%s*(.-)%s*$") or normalized
        local known = knownOreTypeFromText(normalized)
        if known and normalized == string.lower(known) and not allowBareType then
            return false
        end
        return nameKind(normalized) ~= false
    end
    local CRYSTAL_MATERIALS = {
        [Enum.Material.Neon] = true,
        [Enum.Material.Glass] = true,
        [Enum.Material.Ice] = true,
    }

    local function looksLikeCrystal(part)
        if not CRYSTAL_MATERIALS[part.Material] then return false end
        local s = part.Size
        local m = math.max(s.X, s.Y, s.Z)
        if m < MINER_CFG.CrystalMinSize or m > MINER_CFG.CrystalMaxSize then return false end
        return part:IsA("MeshPart") or part:IsA("WedgePart") or part:IsA("CornerWedgePart")
            or part:FindFirstChildOfClass("SpecialMesh") ~= nil
    end

    local function isContainer(inst)
        if inst:IsA("Folder") then return true end
        if inst:IsA("Model") then
            for _, c in ipairs(inst:GetChildren()) do
                if c:IsA("Model") then return true end
            end
        end
        return false
    end

    local function getOreType(inst, kind)
        if not inst then return "Other Ores" end
        local names = {}
        local cur = inst
        local depth = 0
        while cur and cur ~= workspace and depth < 5 do
            table.insert(names, cur.Name)
            cur = cur.Parent
            depth = depth + 1
        end

        for _, name in ipairs(names) do
            local known = knownOreTypeFromText(name)
            if known then return known end
        end

        cur = inst
        depth = 0
        while cur and cur ~= workspace and depth < 4 do
            local ok, attrs = pcall(function() return cur:GetAttributes() end)
            if ok and type(attrs) == "table" then
                for key, value in pairs(attrs) do
                    local k = normalizeName(key)
                    local compactKey = k:gsub("%s+", "")
                    local relevant = k:find("ore", 1, true) or k:find("resource", 1, true)
                        or k:find("mineral", 1, true) or k:find("crystal", 1, true)
                        or k:find("mineable", 1, true) or k:find("mining", 1, true)
                        or compactKey == "resourcetype" or compactKey == "nodetype" or compactKey == "materialtype"
                    if relevant and type(value) == "string" and value ~= "" then
                        local known = knownOreTypeFromText(value)
                        if known then return known end
                        if matchesAny(normalizeName(value), RESOURCE_CONTEXT_PATTERNS) then
                            return genericOreTypeFromText(value, "Other Ores")
                        end
                        if relevant and (compactKey ~= "materialtype" or kind == "ore" or (kind and kind:find("ore", 1, true))) then
                            return titleCase(value)
                        end
                    end
                end
            end
            cur = cur.Parent
            depth = depth + 1
        end

        for _, name in ipairs(names) do
            local normalized = normalizeName(name)
            if matchesAny(normalized, ORE_PATTERNS) or matchesAny(normalized, RESOURCE_CONTEXT_PATTERNS) then
                return genericOreTypeFromText(name, (kind and kind:find("crystal", 1, true)) and "Other Crystals" or "Other Ores")
            end
        end
        if kind and kind:find("crystal", 1, true) then return "Other Crystals" end
        if kind == "aparencia" then return "Other Crystals" end
        return "Other Ores"
    end

    local function isPillarStructure(inst)
        local cur = inst
        local depth = 0
        while cur and cur ~= workspace and depth < 7 do
            local normalized = normalizeName(cur.Name)
            if matchesAny(normalized, PILLAR_PATTERNS) then
                return true
            end

            local ok, attrs = pcall(function() return cur:GetAttributes() end)
            if ok and type(attrs) == "table" then
                for key, value in pairs(attrs) do
                    local compactKey = normalizeName(key):gsub("%s+", "")
                    if value == true and (compactKey == "ispillar" or compactKey == "iscolumn"
                        or compactKey == "isstructuralpillar") then
                        return true
                    end
                    if type(value) == "string" and (compactKey == "structuretype"
                        or compactKey == "objecttype" or compactKey == "parttype" or compactKey == "type")
                        and matchesAny(normalizeName(value), PILLAR_PATTERNS) then
                        return true
                    end
                end
            end
            cur = cur.Parent
            depth = depth + 1
        end
        return false
    end

    local function classify(d)
        local isModel = d:IsA("Model")
        local isPart = (not isModel) and d:IsA("BasePart") and not d:IsA("Terrain")
        if not (isModel or isPart) then return nil end
        if isPillarStructure(d) then return nil end

        local normalizedName = normalizeName(d.Name)
        for _, blockedWord in ipairs(BLOCKED_WORDS) do
            if normalizedName:find(blockedWord, 1, true) then
                return nil
            end
        end

        -- A resource-looking part inside a wall, shop, decoration, or NPC container is not a mine target.
        local ancestor = d.Parent
        local ancestorDepth = 0
        while ancestor and ancestor ~= workspace and ancestorDepth < 6 do
            local ancestorName = normalizeName(ancestor.Name)
            for _, blockedWord in ipairs(BLOCKED_WORDS) do
                if ancestorName:find(blockedWord, 1, true) then
                    return nil
                end
            end
            if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
                return nil
            end
            ancestor = ancestor.Parent
            ancestorDepth = ancestorDepth + 1
        end

        local kind = nameKind(d.Name)
        if not kind and attributesSuggestOre(d) then kind = "ore" end

        if not kind then
            local parent = d.Parent
            if parent and parent ~= workspace then
                local pk = nameKind(parent.Name)
                if not pk and attributesSuggestOre(parent) then pk = "ore" end
                if pk == "ore" and isContainer(parent) then
                    kind = "pasta:ore"
                end
            end
        end

        if not kind then return nil end
        if isModel and isContainer(d) then return nil end
        if livingAncestor(d) then return nil end
        if d:FindFirstAncestorOfClass("Tool") then return nil end
        return kind
    end

    local function rebuildCandidateCache(token)
        local found, set = {}, {}
        local stack = { workspace }
        local visited = 0
        local yieldEvery = math.max(100, tonumber(MINER_CFG.CandidateScanYieldEvery) or 250)

        while #stack > 0 do
            if token and not isActive(token) then
                return false
            end

            local current = table.remove(stack)
            if current ~= workspace then
                local kind = classify(current)
                if kind then
                    table.insert(found, {
                        Inst = current,
                        Kind = kind,
                        OreType = getOreType(current, kind),
                    })
                    set[current] = true
                end
            end

            local okChildren, children = pcall(function()
                return current:GetChildren()
            end)
            if okChildren and children then
                for _, child in ipairs(children) do
                    table.insert(stack, child)
                end
            end

            visited = visited + 1
            if visited % yieldEvery == 0 then
                task.wait()
            end
        end

        local roots = {}
        for _, c in ipairs(found) do
            local nested = false
            local anc = c.Inst.Parent
            while anc and anc ~= workspace do
                if set[anc] then
                    nested = true
                    break
                end
                anc = anc.Parent
            end
            if not nested then
                table.insert(roots, c)
            end
        end

        candidateCache = roots
        candidateCacheAt = os.clock()
        return true
    end

    local function getCandidatePosition(inst)
        if not inst or not inst.Parent then return nil end
        local ok, pos = pcall(function()
            if inst:IsA("BasePart") then
                return inst.Position
            end
            return inst:GetBoundingBox().Position
        end)
        if ok and pos then return pos end
        ok, pos = pcall(function() return inst:GetPivot().Position end)
        if ok then return pos end
        return nil
    end

    local function collectCandidates(root, token)
        if not candidateCache or (os.clock() - candidateCacheAt) >= MINER_CFG.CandidateCacheSeconds then
            if not rebuildCandidateCache(token) then
                return {}
            end
        end

        local rp = root.Position
        local radius = MINER_CFG.SearchRadius
        local list = {}
        for _, cached in ipairs(candidateCache or {}) do
            local inst = cached.Inst
            if inst and inst.Parent then
                local okInWorkspace, inWorkspace = pcall(function()
                    return inst:IsDescendantOf(workspace)
                end)
                if okInWorkspace and inWorkspace then
                    local pivot = getCandidatePosition(inst)
                    if pivot then
                        local dist = (pivot - rp).Magnitude
                        if dist <= radius then
                            table.insert(list, {
                                Inst = inst,
                                Pos = pivot,
                                Dist = dist,
                                Kind = cached.Kind,
                                OreType = cached.OreType,
                            })
                        end
                    end
                end
            end
        end

        table.sort(list, function(a, b) return a.Dist < b.Dist end)
        return list
    end

    local function getBox(inst)
        if inst:IsA("BasePart") then
            return inst.CFrame, inst.Size
        end
        local ok, cf, size = pcall(function() return inst:GetBoundingBox() end)
        if ok and cf and size then
            return cf, size
        end
        return nil
    end

    local function collectParts(inst)
        if inst:IsA("BasePart") then
            return { inst }
        end
        local parts = {}
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("BasePart") then
                table.insert(parts, d)
                if #parts >= 60 then break end
            end
        end
        return parts
    end

    -- For a BasePart this checks its actual CFrame. For a Model, getBox()
    -- returns the model/PrimaryPart-oriented bounding box, which detects when
    -- the whole resource has been rotated onto its side or upside down.
    local function isNormallyOriented(inst, boxCf)
        if not MINER_CFG.RequireUprightOres then
            return true
        end
        if not inst or not inst.Parent then
            return false
        end

        if not boxCf then
            boxCf = select(1, getBox(inst))
        end
        if not boxCf then
            return false
        end

        local worldUp = Vector3.new(0, 1, 0)
        local upDot = boxCf.UpVector:Dot(worldUp)
        return upDot >= (tonumber(MINER_CFG.MinOreUpDot) or 0.75)
    end

    local function getVisualSignature(inst)
        if not inst or not inst.Parent then return nil end
        local _, boundsSize = getBox(inst)
        if not boundsSize then return nil end

        local parts = collectParts(inst)
        local visibleCount, volumeSum, linearSizeSum = 0, 0, 0
        for _, part in ipairs(parts) do
            if part.Parent and part.Transparency < 0.98 then
                visibleCount = visibleCount + 1
                local size = part.Size
                volumeSum = volumeSum + math.max(0.001, size.X * size.Y * size.Z)
                linearSizeSum = linearSizeSum + size.Magnitude
            end
        end

        return {
            BoundsSize = boundsSize,
            PartCount = #parts,
            VisibleCount = visibleCount,
            Volume = volumeSum,
            LinearSize = linearSizeSum,
        }
    end

    local function visualSizeDecreased(before, after)
        if not before or not after then return false end
        if after.PartCount < before.PartCount or after.VisibleCount < before.VisibleCount then
            return true
        end

        if before.Volume > 0 and after.Volume < before.Volume * 0.98 then
            return true
        end
        if before.LinearSize > 0
            and after.LinearSize < before.LinearSize - math.max(0.05, before.LinearSize * 0.02) then
            return true
        end

        local oldSize, newSize = before.BoundsSize, after.BoundsSize
        local axes = {
            { oldSize.X, newSize.X },
            { oldSize.Y, newSize.Y },
            { oldSize.Z, newSize.Z },
        }
        for _, pair in ipairs(axes) do
            local oldValue, newValue = pair[1], pair[2]
            if oldValue - newValue >= math.max(0.05, oldValue * 0.025) then
                return true
            end
        end
        return false
    end

    local function castRay(origin, direction, ignoreList)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        pcall(function() params.RespectCanCollide = true end)

        local ignore = {}
        for i, v in ipairs(ignoreList) do
            ignore[i] = v
        end

        for _ = 1, 5 do
            params.FilterDescendantsInstances = ignore
            local res = workspace:Raycast(origin, direction, params)
            if not res then return nil end
            local living = livingAncestor(res.Instance)
            if not living then return res end
            table.insert(ignore, living)
        end
        return nil
    end

    local function checkGround(inst, mn, mx, center)
        local ignore = { inst }
        local char = player.Character
        if char then table.insert(ignore, char) end

        local startY = mx.Y + 0.75
        local length = (mx.Y - mn.Y) + 400
        local dx = math.clamp((mx.X - mn.X) * 0.35, 0, 3)
        local dz = math.clamp((mx.Z - mn.Z) * 0.35, 0, 3)
        local offsets = {
            Vector3.new(0, 0, 0),
            Vector3.new(dx, 0, 0),
            Vector3.new(-dx, 0, 0),
            Vector3.new(0, 0, dz),
            Vector3.new(0, 0, -dz),
        }

        local okCount, centerOk, groundPos = 0, false, nil
        local supports = {}

        for i, o in ipairs(offsets) do
            local res = castRay(
                Vector3.new(center.X + o.X, startY, center.Z + o.Z),
                Vector3.new(0, -length, 0),
                ignore
            )
            if res then
                local gap = mn.Y - res.Position.Y
                local good = res.Normal.Y >= MINER_CFG.MinGroundNormalY
                    and res.Position.Y <= mx.Y + 0.1
                    and gap <= MINER_CFG.GroundGapMax
                if good then
                    okCount = okCount + 1
                    supports[res.Instance] = true
                end
                if i == 1 then
                    centerOk = good
                    groundPos = res.Position
                end
            end
        end

        if not (centerOk and okCount >= 3) then
            return false
        end
        return true, groundPos, supports
    end

    local function findGroundBelow(inst, center, ext, fromPosition)
        local char = player.Character
        local reference = fromPosition or center
        local startY = math.min(center.Y + 1, reference.Y + 6)
        local offset = math.clamp(math.max(ext.X, ext.Z) * 0.5 + 2, 2, 10)
        local offsets = {
            Vector3.new(0, 0, 0),
            Vector3.new(offset, 0, 0),
            Vector3.new(-offset, 0, 0),
            Vector3.new(0, 0, offset),
            Vector3.new(0, 0, -offset),
        }

        local bestPosition, bestScore = nil, math.huge
        for _, o in ipairs(offsets) do
            local ignore = { inst }
            if char then table.insert(ignore, char) end
            local origin = Vector3.new(center.X + o.X, startY, center.Z + o.Z)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = ignore
            params.IgnoreWater = true
            pcall(function() params.RespectCanCollide = true end)

            for _ = 1, 4 do
                params.FilterDescendantsInstances = ignore
                local okRay, hit = pcall(function()
                    return workspace:Raycast(origin, Vector3.new(0, -600, 0), params)
                end)
                if not okRay or not hit then break end

                if hit.Normal.Y >= 0.45 then
                    local pos = hit.Position
                    local score = (pos - reference).Magnitude + horizontal(pos, center) * 0.2
                    if score < bestScore then
                        bestScore, bestPosition = score, pos
                    end
                    break
                end

                if hit.Instance == workspace.Terrain then break end
                table.insert(ignore, hit.Instance)
            end
        end
        return bestPosition
    end

    local function evaluate(inst)
        local cf, size = getBox(inst)
        if not cf then return nil, "sem-caixa" end
        if not isNormallyOriented(inst, cf) then
            return nil, "ore-de-lado-ou-invertido"
        end

        local mn, mx = worldBounds(cf, size)
        local ext = mx - mn
        local biggest = math.max(ext.X, ext.Y, ext.Z)
        if biggest < 0.2 then return nil, "vazio" end
        if biggest > MINER_CFG.MaxOreSize then return nil, "grande-demais" end

        local center = (mn + mx) / 2
        local _, _, playerRoot = getChar()
        local reference = playerRoot and playerRoot.Position or center

        local good, groundPos = checkGround(inst, mn, mx, center)
        if not good then
            groundPos = findGroundBelow(inst, center, ext, reference)
        end
        if not groundPos then
            groundPos = Vector3.new(center.X, reference.Y, center.Z)
        end

        local parts = collectParts(inst)
        local visibleCount = 0
        local initialTransparency = {}
        for _, p in ipairs(parts) do
            initialTransparency[p] = p.Transparency
            if p.Transparency < 0.98 then
                visibleCount = visibleCount + 1
            end
        end

        return {
            Inst = inst,
            Name = inst.Name,
            OreType = getOreType(inst, nameKind(inst.Name)),
            Center = center,
            Top = mx.Y,
            Bottom = mn.Y,
            Radius = math.clamp(math.max(ext.X, ext.Z) / 2, 1, 8),
            InitialSize = ext,
            InitialPartCount = #parts,
            InitialVisibleCount = visibleCount,
            InitialTransparency = initialTransparency,
            GroundPos = groundPos,
            Parts = parts,
            WasVisible = visibleCount > 0,
            StandPoint = nil,
            Waypoints = nil,
        }
    end

    local function computeStandPoint(info, from, angle)
        local flat = Vector3.new(from.X - info.Center.X, 0, from.Z - info.Center.Z)
        local dir
        if angle ~= nil then
            dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
        else
            dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(1, 0, 0)
        end

        local offset = (info.Radius or 1) + MINER_CFG.MineDistance * 0.5
        local px = info.Center.X + dir.X * offset
        local pz = info.Center.Z + dir.Z * offset
        local groundY = info.GroundPos and info.GroundPos.Y or from.Y

        local ignore = { info.Inst }
        if player.Character then table.insert(ignore, player.Character) end
        local res = castRay(
            Vector3.new(px, groundY + 8, pz),
            Vector3.new(0, -80, 0),
            ignore
        )
        if res and res.Normal.Y >= 0.45 then
            return res.Position
        end

        return Vector3.new(px, groundY, pz)
    end

    local function computePath(fromPos, toPos)
        if not MINER_CFG.UsePathfinding then
            return true, nil
        end

        local profiles = {
            { AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 4 },
            { AgentRadius = 1, AgentHeight = 4, AgentCanJump = true, WaypointSpacing = 3 },
        }

        for _, profile in ipairs(profiles) do
            local okCreate, path = pcall(function()
                return PathfindingService:CreatePath(profile)
            end)
            if okCreate and path then
                local okCompute = pcall(function()
                    path:ComputeAsync(fromPos, toPos)
                end)
                if okCompute and path.Status == Enum.PathStatus.Success then
                    local okWaypoints, wps = pcall(function()
                        return path:GetWaypoints()
                    end)
                    if okWaypoints and wps and #wps > 0 then
                        return true, wps
                    end
                end
            end
        end

        return false, nil
    end

    local function checkReachable(info, root, forceAlternate)
        local dx = root.Position.X - info.Center.X
        local dz = root.Position.Z - info.Center.Z
        local baseAngle = (math.abs(dx) + math.abs(dz) > 0.1) and math.atan2(dz, dx) or 0
        local order = forceAlternate and { 1, 2, 3, 4, 5, 6, 7, 0 }
            or { 0, 1, 2, 3, 4, 5, 6, 7 }

        for _, offsetIndex in ipairs(order) do
            local angle = baseAngle + offsetIndex * (math.pi / 4)
            local stand = computeStandPoint(info, root.Position, angle)
            if stand then
                local ok, wps = computePath(root.Position, stand)
                if ok then
                    if wps then
                        local last = wps[#wps].Position
                        if horizontal(last, stand) > 8 or math.abs(last.Y - stand.Y) > 8 then
                            info.Waypoints = nil
                        else
                            info.StandPoint = stand
                            info.Waypoints = wps
                            return true
                        end
                    else
                        info.StandPoint = stand
                        info.Waypoints = nil
                        return true
                    end
                end
            end
        end

        info.Waypoints = nil
        return false
    end

    local function blockSpot(pos, secs)
        table.insert(blocked, { Pos = pos, Until = os.clock() + secs })
    end

    local function isBlocked(pos, now)
        for i = #blocked, 1, -1 do
            local b = blocked[i]
            if b.Until <= now then
                table.remove(blocked, i)
            elseif (b.Pos - pos).Magnitude <= MINER_CFG.BlockRadius then
                return true
            end
        end
        return false
    end

    local function pickTarget(root, token)
        local now = os.clock()
        local cands = collectCandidates(root, token)
        local stats = { Total = #cands, Ground = 0, Rejected = 0, Blocked = 0, PathTries = 0 }

        for _, c in ipairs(cands) do
            if not isActive(token) then return nil, stats end

            local inst = c.Inst
            local untilT = rejected[inst]
            if untilT and untilT > now then
                stats.Rejected = stats.Rejected + 1
            elseif isBlocked(c.Pos, now) then
                stats.Blocked = stats.Blocked + 1
            elseif inst.Parent then
                local info, reason = evaluate(inst)
                if not info then
                    local rejectFor = reason == "ore-de-lado-ou-invertido"
                        and MINER_CFG.OrientationIgnoreTime or MINER_CFG.RejectCacheTime
                    rejected[inst] = now + rejectFor
                    stats.Rejected = stats.Rejected + 1
                    dbg(inst:GetFullName(), "[" .. tostring(c.Kind) .. "] descartado:", reason)
                else
                    info.OreType = c.OreType or getOreType(inst, c.Kind)
                    stats.Ground = stats.Ground + 1
                    stats.PathTries = stats.PathTries + 1
                    if checkReachable(info, root) then
                        dbg(inst:GetFullName(), "[" .. tostring(c.Kind) .. "] alvo mais próximo aceito")
                        return info, stats
                    else
                        rejected[inst] = now + MINER_CFG.IgnoreTime
                        stats.Rejected = stats.Rejected + 1
                        dbg(inst:GetFullName(), "sem rota acessível; tentando outro ore")
                    end
                    if stats.PathTries >= MINER_CFG.MaxPathChecks then
                        break
                    end
                end
            end
        end

        return nil, stats
    end

    local function findNearbyBetterTarget(root, currentInfo, token)
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = player.Character and { player.Character } or {}
        pcall(function() params.MaxParts = 180 end)
        local okQuery, parts = pcall(function()
            return workspace:GetPartBoundsInRadius(root.Position, MINER_CFG.NearbyScanRadius, params)
        end)
        if not okQuery or not parts then return nil end

        local seen, candidates = {}, {}
        for _, part in ipairs(parts) do
            local cur = part
            local chosen = nil
            local depth = 0
            while cur and cur ~= workspace and depth < 6 do
                if cur:IsA("Model") or cur:IsA("BasePart") then
                    local kind = classify(cur)
                    if kind then chosen = { Inst = cur, Kind = kind } end
                end
                cur = cur.Parent
                depth = depth + 1
            end
            local relatedToCurrent = false
            if chosen and chosen.Inst then
                pcall(function()
                    relatedToCurrent = chosen.Inst == currentInfo.Inst
                        or chosen.Inst:IsDescendantOf(currentInfo.Inst)
                        or currentInfo.Inst:IsDescendantOf(chosen.Inst)
                end)
            end
            if chosen and chosen.Inst and not relatedToCurrent and not seen[chosen.Inst] then
                seen[chosen.Inst] = true
                local oreType = getOreType(chosen.Inst, chosen.Kind)
                local ignoredUntil = rejected[chosen.Inst]
                if not ignoredUntil or ignoredUntil <= os.clock() then
                    local posOK, pos = pcall(function()
                        if chosen.Inst:IsA("BasePart") then return chosen.Inst.Position end
                        local cf = chosen.Inst:GetBoundingBox()
                        return cf.Position
                    end)
                    if posOK and pos and not isBlocked(pos, os.clock()) then
                        table.insert(candidates, { Inst = chosen.Inst, Kind = chosen.Kind, OreType = oreType, Pos = pos, Dist = (pos - root.Position).Magnitude })
                    end
                end
            end
        end
        table.sort(candidates, function(a, b) return a.Dist < b.Dist end)

        local currentDist = (root.Position - currentInfo.Center).Magnitude
        local evaluated = 0
        for _, candidate in ipairs(candidates) do
            if not isActive(token) then return nil end
            if candidate.Dist + MINER_CFG.TargetSwitchMargin < currentDist then
                local info = evaluate(candidate.Inst)
                evaluated = evaluated + 1
                if info then
                    info.OreType = candidate.OreType
                    if checkReachable(info, root) then
                        dbg("alvo próximo encontrado:", info.Name, "[" .. tostring(info.OreType) .. "]")
                        return info
                    else
                        rejected[candidate.Inst] = os.clock() + MINER_CFG.IgnoreTime
                    end
                end
                if evaluated >= 3 then break end
            else
                break
            end
        end
        return nil
    end

    local function hasDepletedFlag(inst)
        if not inst then return false end
        local objects = { inst }
        for _, d in ipairs(inst:GetDescendants()) do
            table.insert(objects, d)
            if #objects >= 80 then break end
        end

        local depletedNames = {
            destroyed = true, isdestroyed = true, collected = true, iscollected = true,
            mined = true, ismined = true, depleted = true, isdepleted = true,
            broken = true, isbroken = true,
        }
        for _, obj in ipairs(objects) do
            local ok, attrs = pcall(function() return obj:GetAttributes() end)
            if ok and type(attrs) == "table" then
                for key, value in pairs(attrs) do
                    local compactKey = normalizeName(key):gsub("%s+", "")
                    if depletedNames[compactKey] and value == true then
                        return true
                    end
                    if (compactKey == "health" or compactKey == "hp" or compactKey == "hitpoints"
                        or compactKey == "durability") and type(value) == "number" and value <= 0 then
                        return true
                    end
                end
            end

            local compactName = normalizeName(obj.Name):gsub("%s+", "")
            if obj:IsA("BoolValue") and depletedNames[compactName] and obj.Value then
                return true
            end
            if (obj:IsA("IntValue") or obj:IsA("NumberValue"))
                and (compactName == "health" or compactName == "hp" or compactName == "hitpoints"
                    or compactName == "durability") and obj.Value <= 0 then
                return true
            end
        end
        return false
    end

    local function oreGone(info)
        local inst = info.Inst
        if not inst or not inst.Parent or not inst:IsDescendantOf(workspace) then
            return true, "sumiu"
        end

        if hasDepletedFlag(inst) then
            return true, "estado destruído confirmado"
        end

        local currentParts = collectParts(inst)
        local currentCount, visibleCount = 0, 0
        for _, part in ipairs(currentParts) do
            if part.Parent and (part == inst or part:IsDescendantOf(inst)) then
                currentCount = currentCount + 1
                if part.Transparency < 0.98 then
                    visibleCount = visibleCount + 1
                end
            end
        end

        local initialCount = info.InitialPartCount or #(info.Parts or {})
        local initialVisible = info.InitialVisibleCount or (info.WasVisible and 1 or 0)
        if initialCount > 0 and currentCount == 0 then
            return true, "partes do cristal removidas"
        end

        if info.WasVisible and visibleCount == 0 then
            local originalPartsRemaining = 0
            for _, part in ipairs(info.Parts or {}) do
                if part.Parent and (part == inst or part:IsDescendantOf(inst)) then
                    originalPartsRemaining = originalPartsRemaining + 1
                end
            end

            local substantialRemoval = initialCount > 0
                and originalPartsRemaining <= math.max(0, math.floor(initialCount * 0.25))
            local now = os.clock()
            info.HiddenSince = info.HiddenSince or now
            local hiddenFor = now - info.HiddenSince
            -- If most of the original model parts were actually removed, accept only
            -- after the structural change remains stable briefly.
            if substantialRemoval and hiddenFor >= 0.9 then
                return true, "maioria das partes removida"
            end

            -- Some games leave mined resources in Workspace with Transparency = 1.
            -- Do not confuse a short hit/respawn animation with destruction: this
            -- fallback is allowed only during mining, after multiple click attempts,
            -- and only when invisibility has remained stable long enough.
            local hitCount = tonumber(info.ClickAttempts) or 0
            if info.MiningStarted == true
                and hitCount >= MINER_CFG.HiddenDestroyMinClicks
                and hiddenFor >= MINER_CFG.HiddenDestroyConfirmTime then
                return true, "cristal permaneceu invisível após vários golpes"
            end
        else
            info.HiddenSince = nil
        end

        if initialCount >= 3 and currentCount <= math.max(1, math.floor(initialCount * 0.2))
            and visibleCount <= math.max(1, math.floor((initialVisible or 1) * 0.2)) then
            info.BrokenShapeSince = info.BrokenShapeSince or os.clock()
            if os.clock() - info.BrokenShapeSince >= 0.6 then
                return true, "estrutura do cristal desmontada"
            end
        else
            info.BrokenShapeSince = nil
        end

        return false
    end

    local function stackCount(name)
        local n = name:match("[xX]%s*(%d+)%s*$") or name:match("%((%d+)%)%s*$") or name:match("^(%d+)%s*[xX]")
        return tonumber(n) or 1
    end

    local function baseName(name)
        local s = name:gsub("%s*[xX]%s*%d+%s*$", ""):gsub("%s*%(%d+%)%s*$", ""):gsub("^%d+%s*[xX]%s*", "")
        return string.lower(s)
    end

    local function snapshotInventory()
        local total, byName = 0, {}

        local function add(key, n)
            byName[key] = (byName[key] or 0) + n
            total = total + n
        end

        local function scanTools(container)
            if not container then return end
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("Tool") and isOreItemName(c.Name, true) then
                    add(baseName(c.Name), stackCount(c.Name))
                end
            end
        end

        scanTools(player:FindFirstChildOfClass("Backpack"))
        scanTools(player.Character)

        for _, child in ipairs(player:GetChildren()) do
            if child.Name ~= "PlayerGui" and child.Name ~= "PlayerScripts" and not child:IsA("Backpack") then
                for _, d in ipairs(child:GetDescendants()) do
                    if (d:IsA("IntValue") or d:IsA("NumberValue")) and isOreItemName(d.Name, false) then
                        add("valor:" .. d:GetFullName(), d.Value)
                    end
                end
            end
        end

        return { Total = total, ByName = byName }
    end

    local function hasWholePhrase(text, phrase)
        local haystack = " " .. normalizeName(text) .. " "
        local needle = " " .. normalizeName(phrase) .. " "
        return phrase ~= nil and phrase ~= "" and haystack:find(needle, 1, true) ~= nil
    end

    local function inventoryKeyMatchesTarget(key, info)
        local text = tostring(key or "")
        text = text:gsub("^valor:", "")
        local normalized = normalizeName(text)
        local targetType = normalizeName(info.OreType or "")
        local genericTarget = targetType == "other ores" or targetType == "other crystals"
            or targetType == "other ore" or targetType == ""

        if not genericTarget then
            local itemType = knownOreTypeFromText(normalized)
            if itemType and normalizeName(itemType) == targetType then
                return true
            end
            if hasWholePhrase(normalized, targetType) then
                return true
            end
        end

        local targetName = normalizeName(info.Name or "")
        if #targetName >= 4 and hasWholePhrase(normalized, targetName) then
            return true
        end
        local nameType = knownOreTypeFromText(targetName)
        local itemType = knownOreTypeFromText(normalized)
        if nameType and itemType == nameType then
            return true
        end
        return false
    end

    local function inventoryIncreased(before, after, info)
        local changedKeys = {}
        for k, v in pairs(after.ByName) do
            if v > (before.ByName[k] or 0) then
                table.insert(changedKeys, k)
                if inventoryKeyMatchesTarget(k, info) then
                    return true
                end
            end
        end

        local targetType = normalizeName(info.OreType or "")
        local genericTarget = targetType == "other ores" or targetType == "other crystals"
            or targetType == "other ore" or targetType == ""
        if genericTarget and #changedKeys == 1 then
            local changed = normalizeName(changedKeys[1]:gsub("^valor:", ""))
            if changed:find("ore", 1, true) or changed:find("crystal", 1, true)
                or changed:find("mineral", 1, true) or changed:find("gem", 1, true) then
                return true
            end
        end
        return false
    end

    local function onRenderStep()
        local t = aimTarget
        if not t then return end
        local cam = workspace.CurrentCamera
        if not cam then return end

        local cf = cam.CFrame
        local dir = t - cf.Position
        if dir.Magnitude < 0.5 then return end
        local unitDir = dir.Unit
        if cf.LookVector:Dot(unitDir) > 0.9995 then return end
        local up = math.abs(unitDir.Y) > 0.98 and Vector3.new(0, 0, -1) or Vector3.new(0, 1, 0)
        cam.CFrame = CFrame.lookAt(cf.Position, t, up)
    end

    local function faceTo(root, pos)
        local toTarget = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
        if toTarget.Magnitude < 0.1 then return end

        local look = root.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0.01 and flatLook.Unit:Dot(toTarget.Unit) > 0.99 then
            return
        end

        root.CFrame = CFrame.lookAt(root.Position, Vector3.new(pos.X, root.Position.Y, pos.Z))
    end

    local function walkTo(info, token)
        local waypoints = info.Waypoints
        local idx = 1

        local t0 = os.clock()
        local _, _, root0 = getChar()
        local startDist = root0 and horizontal(root0.Position, info.Center) or 0
        local limit = math.max(MINER_CFG.WalkTimeoutMin, startDist / 6)

        local lastCheck = t0
        local lastPos = root0 and root0.Position or nil
        local lastTargetDistance = nil
        local stuck = 0
        local recoveryAttempts = 0
        local lastTargetRefresh = t0
        local plannedCenter = info.Center
        local lastMoveTarget, lastMoveAt = nil, 0
        local lastWaypointJumpAt = 0
        local lastRecoveryJumpAt = -math.huge
        local result = "parou"

        local function releaseSpace()
            pcall(function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
            end)
        end

        local function tapSpace()
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            end)
            task.wait(0.08)
            releaseSpace()
        end

        local function attemptRecovery(hum, root)
            recoveryAttempts = recoveryAttempts + 1
            if recoveryAttempts > MINER_CFG.MaxRecoveryAttempts then
                return false
            end

            dbg("personagem preso; recuperação", recoveryAttempts, "de", MINER_CFG.MaxRecoveryAttempts)
            setMoving(false)
            pcall(function() hum:MoveTo(root.Position) end)
            task.wait(0.12)
            if not isActive(token) then
                releaseSpace()
                return false
            end

            local stand = info.StandPoint or info.GroundPos or info.Center
            local toward = Vector3.new(stand.X - root.Position.X, 0, stand.Z - root.Position.Z)
            if toward.Magnitude < 0.1 then
                local look = root.CFrame.LookVector
                toward = Vector3.new(look.X, 0, look.Z)
            end
            if toward.Magnitude < 0.1 then
                toward = Vector3.new(1, 0, 0)
            else
                toward = toward.Unit
            end
            local side = Vector3.new(-toward.Z, 0, toward.X)
            local directionIndex = ((recoveryAttempts - 1) % 3) + 1
            local nudgeDirection
            if directionIndex == 1 then
                nudgeDirection = side
            elseif directionIndex == 2 then
                nudgeDirection = -side
            else
                nudgeDirection = -toward
            end

            local beforeNudge = root.Position
            local nudgeTarget = beforeNudge + nudgeDirection * MINER_CFG.RecoveryMoveDistance
            setMoving(true)
            pcall(function() hum:MoveTo(nudgeTarget) end)
            task.wait(MINER_CFG.RecoveryMoveWait)
            if not isActive(token) then
                setMoving(false)
                releaseSpace()
                return false
            end

            local _, humAfterNudge, rootAfterNudge = getChar()
            local nudged = rootAfterNudge
                and horizontal(rootAfterNudge.Position, beforeNudge) >= MINER_CFG.StuckPositionThreshold

            if not nudged and os.clock() - lastRecoveryJumpAt >= MINER_CFG.RecoveryJumpCooldown then
                lastRecoveryJumpAt = os.clock()
                -- One short Space press per recovery attempt; never hold it during normal movement.
                tapSpace()
                local _, jumpHum, jumpRoot = getChar()
                if jumpHum and jumpRoot then
                    -- Humanoid fallback complements the explicit Space key tap if input simulation is restricted.
                    pcall(function() jumpHum.Jump = true end)
                    local jumpDestination = info.StandPoint or info.Center
                    pcall(function() jumpHum:MoveTo(jumpDestination) end)
                end
                task.wait(0.35)
            end

            releaseSpace()
            local _, currentHum, currentRoot = getChar()
            if not (currentHum and currentRoot) then
                setMoving(false)
                return false
            end

            -- Always rebuild from the real current position, not from the old route's origin.
            local destination = info.StandPoint or info.Center
            local okPath, newWps = computePath(currentRoot.Position, destination)
            if okPath and newWps and #newWps > 0 then
                local endpoint = newWps[#newWps].Position
                if horizontal(endpoint, destination) > 8
                    or math.abs(endpoint.Y - destination.Y) > 8 then
                    okPath, newWps = false, nil
                end
            end

            if not okPath then
                okPath = checkReachable(info, currentRoot, true)
                if okPath then
                    newWps = info.Waypoints
                end
            end

            if not okPath then
                dbg("rota alternativa não encontrada após recuperação", recoveryAttempts)
                -- Keep a bounded direct MoveTo fallback while the remaining recovery attempts run.
                waypoints = nil
                idx = 1
                plannedCenter = info.Center
                lastMoveTarget, lastMoveAt = nil, 0
                lastTargetDistance = nil
                lastPos = currentRoot.Position
                lastCheck = os.clock()
                stuck = 0
                setMoving(true)
                pcall(function() currentHum:MoveTo(destination) end)
                return recoveryAttempts < MINER_CFG.MaxRecoveryAttempts
            end

            waypoints = newWps
            idx = 1
            plannedCenter = info.Center
            lastMoveTarget, lastMoveAt = nil, 0
            lastTargetDistance = nil
            lastPos = currentRoot.Position
            lastCheck = os.clock()
            stuck = 0
            setMoving(true)
            dbg("rota recalculada após recuperação", recoveryAttempts)
            return true
        end

        while isActive(token) do
            local gone = oreGone(info)
            if gone then
                result = "sumiu"
                break
            end

            -- Revalidate the selected instance before moving; stale cache entries must not become targets.
            local _, hum, root = getChar()
            if not (info.Inst and info.Inst.Parent and info.Inst:IsDescendantOf(workspace)
                and classify(info.Inst)) then
                result = "sumiu"
                break
            end

            if not root then
                setMoving(false)
                lastPos, lastTargetDistance, stuck = nil, nil, 0
                task.wait(0.3)
            else
                local now = os.clock()
                local flat = horizontal(root.Position, info.Center)
                local stand = info.StandPoint or info.GroundPos or info.Center
                local standFlat = horizontal(root.Position, stand)
                -- StandPoint is a ground position. The root part normally sits a few studs above it.
                local standVerticalError = math.abs(root.Position.Y - (stand.Y + 3))

                if standFlat <= MINER_CFG.WalkStopDistance
                    and standVerticalError <= MINER_CFG.ArrivalVerticalTolerance then
                    result = "arrived"
                    break
                end

                -- Refresh target geometry at a modest rate to follow moved ores without rescanning every frame.
                if now - lastTargetRefresh >= MINER_CFG.TargetPositionRefreshInterval then
                    lastTargetRefresh = now
                    local boxOk, boxCf, boxSize = pcall(function()
                        return getBox(info.Inst)
                    end)
                    if not boxOk or not boxCf or not boxSize then
                        result = "sumiu"
                        break
                    end
                    if not isNormallyOriented(info.Inst, boxCf) then
                        rejected[info.Inst] = os.clock() + MINER_CFG.OrientationIgnoreTime
                        result = "orientacao-invalida"
                        break
                    end

                    local mn, mx = worldBounds(boxCf, boxSize)
                    local newCenter = (mn + mx) / 2
                    local newExt = mx - mn
                    info.Center = newCenter
                    info.Top = mx.Y
                    info.Bottom = mn.Y
                    info.Radius = math.clamp(math.max(newExt.X, newExt.Z) / 2, 1, 8)

                    if (newCenter - plannedCenter).Magnitude >= MINER_CFG.TargetMoveRepathDistance then
                        local grounded, newGround = checkGround(info.Inst, mn, mx, newCenter)
                        if not grounded then
                            newGround = findGroundBelow(info.Inst, newCenter, newExt, root.Position)
                        end
                        info.GroundPos = newGround or Vector3.new(newCenter.X, root.Position.Y, newCenter.Z)
                        info.StandPoint, info.Waypoints = nil, nil

                        if not checkReachable(info, root, true) then
                            result = "inalcancavel"
                            break
                        end

                        waypoints = info.Waypoints
                        idx = 1
                        plannedCenter = info.Center
                        lastMoveTarget, lastMoveAt = nil, 0
                        lastTargetDistance = nil
                        stuck = 0
                        dbg("alvo se moveu; rota recalculada")
                    end
                end

                if now - t0 > limit then
                    result = "inalcancavel"
                    break
                end

                setMoving(true)

                local target = info.StandPoint or info.Center
                local wp = waypoints and waypoints[idx]
                if wp then
                    while idx < #waypoints
                        and horizontal(root.Position, wp.Position) < 3.5
                        and math.abs(root.Position.Y - wp.Position.Y) < 6 do
                        idx = idx + 1
                        wp = waypoints[idx]
                        lastTargetDistance = nil
                    end
                    target = wp.Position
                    if wp.Action == Enum.PathWaypointAction.Jump
                        and horizontal(root.Position, wp.Position) < 4.5
                        and now - lastWaypointJumpAt >= MINER_CFG.WaypointJumpCooldown then
                        hum.Jump = true
                        lastWaypointJumpAt = now
                    end
                    if idx >= #waypoints and horizontal(root.Position, wp.Position) < 3.5 then
                        target = info.StandPoint or info.Center
                    end
                end

                local targetChanged = not lastMoveTarget
                    or (target - lastMoveTarget).Magnitude > 1.25
                if targetChanged or (now - lastMoveAt) >= MINER_CFG.MoveToRefreshInterval then
                    hum:MoveTo(target)
                    lastMoveTarget = target
                    lastMoveAt = now
                    if targetChanged then
                        lastTargetDistance = nil
                        lastPos = root.Position
                        lastCheck = now
                        stuck = 0
                    end
                end

                if now - lastCheck >= MINER_CFG.StuckCheckInterval then
                    local movement = lastPos and (root.Position - lastPos).Magnitude or math.huge
                    local targetDistance = (root.Position - target).Magnitude
                    local movedTowardTarget = lastTargetDistance == nil
                        or targetDistance < lastTargetDistance - 0.2
                    local madeProgress = movement >= MINER_CFG.StuckPositionThreshold and movedTowardTarget
                    if madeProgress then
                        stuck = 0
                    else
                        stuck = stuck + (now - lastCheck)
                    end
                    lastPos = root.Position
                    lastTargetDistance = targetDistance
                    lastCheck = now
                end

                if stuck >= MINER_CFG.StuckTimeout then
                    stuck = 0
                    local recovered = attemptRecovery(hum, root)
                    if not recovered then
                        if recoveryAttempts >= MINER_CFG.MaxRecoveryAttempts then
                            result = "inalcancavel"
                            break
                        end
                        -- Failed path checks still consume a bounded attempt; retry from the new position.
                        task.wait(0.15)
                    end
                end

                task.wait(MINER_CFG.TickRate)
            end
        end

        releaseSpace()
        return result
    end

    local function mineLoop(info, token)
        setMoving(false)

        local reach = (info.Radius or 1) + MINER_CFG.MineDistance
        local t0 = os.clock()
        local invBefore = snapshotInventory()
        local lastInvCheck = 0
        local result, why = "parou", nil
        local clickAttempts = 0
        local firstClickPending = false
        local firstClickDeadline = nil
        local firstClickAt = nil
        local firstClickSignature = nil
        info.MiningStarted = true
        info.ClickAttempts = 0
        -- Start the invisibility timer fresh; an ore may have been hidden briefly
        -- while the character was still walking toward it.
        info.HiddenSince = nil

        while isActive(token) do
            local _, hum, root = getChar()
            if not (hum and root) then
                result = "sem-personagem"
                break
            end

            local gone, goneWhy = oreGone(info)
            if gone then
                result, why = "coletado", goneWhy
                break
            end

            -- The ore may rotate after the walking phase; do not click it if it
            -- is no longer upright when mining begins or continues.
            local currentBoxCf = select(1, getBox(info.Inst))
            if not isNormallyOriented(info.Inst, currentBoxCf) then
                rejected[info.Inst] = os.clock() + MINER_CFG.OrientationIgnoreTime
                result = "orientacao-invalida"
                break
            end

            local now = os.clock()
            if now - lastInvCheck >= 0.15 then
                lastInvCheck = now
                if inventoryIncreased(invBefore, snapshotInventory(), info) then
                    result, why = "coletado", "item no inventário"
                    break
                end
            end

            if firstClickPending and now >= firstClickDeadline then
                local afterSignature = getVisualSignature(info.Inst)
                if visualSizeDecreased(firstClickSignature, afterSignature) then
                    -- A visible change proves this target is responding; continue
                    -- mining until destruction/inventory evidence confirms completion.
                    firstClickPending = false
                elseif clickAttempts >= MINER_CFG.NoProgressMinClicks
                    and firstClickAt and now - firstClickAt >= MINER_CFG.NoProgressGraceTime then
                    -- Only reject after many attempts over a grace period. Earlier
                    -- versions stopped after the first unsuccessful visual check.
                    result = "sem-progresso-mineracao"
                    why = "sem alteração visual após várias tentativas"
                    break
                else
                    -- Keep delivering clicks while waiting for a visual response.
                    -- The deadline is just a polling point, not a reason to stop.
                    firstClickDeadline = now + MINER_CFG.FirstClickVerifyDelay
                end
            end

            local horizontalDistance = horizontal(root.Position, info.Center)
            local verticalDistance = math.abs(root.Position.Y - info.Center.Y)
            if horizontalDistance > reach + MINER_CFG.ReachBuffer
                or verticalDistance > MINER_CFG.MaxVerticalReach then
                result = "inalcancavel"
                break
            end

            if now - t0 > MINER_CFG.MineTimeout then
                result = "timeout"
                break
            end

            hum:MoveTo(root.Position)
            faceTo(root, info.Center)
            aimTarget = info.Center

            if CombatCfg.SkillBusy then
                task.wait(0.03)
            else
                local signatureBefore = nil
                if clickAttempts == 0 then
                    signatureBefore = getVisualSignature(info.Inst)
                end

                local clickOk, clickSent = pcall(function()
                    return clickOnce(true)
                end)
                if clickOk and clickSent then
                    clickAttempts = clickAttempts + 1
                    info.ClickAttempts = clickAttempts
                    if clickAttempts == 1 then
                        firstClickSignature = signatureBefore
                        firstClickPending = true
                        firstClickAt = os.clock()
                        firstClickDeadline = firstClickAt + MINER_CFG.FirstClickVerifyDelay
                    end
                end
                task.wait(MINER_CFG.ClickDelay)
            end
        end

        aimTarget = nil
        return result, why
    end

    local function mineTarget(info, token)
        local deadline = os.clock() + MINER_CFG.TargetMaxTime

        while isActive(token) and os.clock() < deadline do
            local walked, nextInfo = walkTo(info, token)
            if walked == "retarget" and nextInfo then
                info = nextInfo
                AutoMiner.Target = info.Inst
                setMoving(false)
            elseif walked ~= "arrived" then
                setMoving(false)
                return walked, nil, info
            else
                local result, why = mineLoop(info, token)
                return result, why, info
            end
        end

        setMoving(false)
        if isActive(token) then
            return "timeout", nil, info
        end
        return "parou", nil, info
    end

    local function step(token)
        if AutoMob.Enabled then
            setMoving(false)
            task.wait(0.5)
            return
        end

        local _, _, root = getChar()
        if not root then
            setMoving(false)
            aimTarget = nil
            AutoMiner.Target = nil
            task.wait(0.5)
            return
        end

        local info, stats = pickTarget(root, token)
        if not isActive(token) then return end

        if not info then
            setMoving(false)
            AutoMiner.Target = nil
            if stats.PathTries >= MINER_CFG.MaxPathChecks then
                task.wait(0.2)
            else
                task.wait(MINER_CFG.RescanDelay)
            end
            return
        end

        AutoMiner.Target = info.Inst
        local result, why, finalInfo = mineTarget(info, token)
        info = finalInfo or info
        AutoMiner.Target = nil
        aimTarget = nil

        if not isActive(token) then return end

        if result == "coletado" then
            AutoMiner.Collected = AutoMiner.Collected + 1
            blockSpot(info.Center, MINER_CFG.MinedSpotTime)
            rejected[info.Inst] = os.clock() + MINER_CFG.MinedSpotTime
        elseif result == "sumiu" then
            blockSpot(info.Center, 10)
        elseif result == "sem-progresso-mineracao" then
            rejected[info.Inst] = os.clock() + MINER_CFG.IgnoreTime
        elseif result == "orientacao-invalida" then
            rejected[info.Inst] = os.clock() + MINER_CFG.OrientationIgnoreTime
        elseif result == "inalcancavel" or result == "timeout" then
            rejected[info.Inst] = os.clock() + MINER_CFG.IgnoreTime
        elseif result == "sem-personagem" then
            task.wait(0.5)
        end
    end

    local function startAutoMiner()
        if AutoMiner.Enabled then return end
        AutoMiner.Enabled = true
        AutoMiner.Token = AutoMiner.Token + 1
        local token = AutoMiner.Token

        if AutoMiner.Thread then
            pcall(task.cancel, AutoMiner.Thread)
            AutoMiner.Thread = nil
        end

        blocked = {}
        candidateCache = nil
        candidateCacheAt = 0
        for k in pairs(rejected) do
            rejected[k] = nil
        end
        AutoMiner.Collected = 0
        aimTarget = nil

        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)
        RunService:BindToRenderStep(STEER_NAME, Enum.RenderPriority.Camera.Value + 1, onRenderStep)

        AutoMiner.Thread = task.spawn(function()
            while isActive(token) do
                local ok, err = pcall(step, token)
                if not ok then
                    warn("[RAMDOM HUB] Auto Miner erro: " .. tostring(err))
                    setMoving(false)
                    aimTarget = nil
                    AutoMiner.Target = nil
                    task.wait(2)
                end
                task.wait(0.05)
            end
        end)
    end

    local function stopAutoMiner()
        if not AutoMiner.Enabled then return end
        AutoMiner.Enabled = false
        AutoMiner.Token = AutoMiner.Token + 1

        if AutoMiner.Thread then
            pcall(task.cancel, AutoMiner.Thread)
            AutoMiner.Thread = nil
        end

        AutoMiner.Target = nil
        aimTarget = nil
        setMoving(false)
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
        releaseMouse()
        pcall(function() RunService:UnbindFromRenderStep(STEER_NAME) end)

        local _, hum, root = getChar()
        if hum and root then
            pcall(function() hum:MoveTo(root.Position) end)
        end
    end

    AutoMiner.Start = startAutoMiner
    AutoMiner.Stop = stopAutoMiner
end

--// ==========================================
--// COMBAT — MOTOR
--// ==========================================
do
    local function pressKey(keyCode)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end)
    end

    -- Mapeia slot lógico → KeyCode. Slot 10 corresponde à tecla 0.
    local function pressSlotKey(slot)
        local keyMap = {
            [1] = Enum.KeyCode.One,
            [2] = Enum.KeyCode.Two,
            [3] = Enum.KeyCode.Three,
            [4] = Enum.KeyCode.Four,
            [5] = Enum.KeyCode.Five,
            [6] = Enum.KeyCode.Six,
            [7] = Enum.KeyCode.Seven,
            [8] = Enum.KeyCode.Eight,
            [9] = Enum.KeyCode.Nine,
            [10] = Enum.KeyCode.Zero,
        }
        local key = keyMap[slot]
        if key then
            pressKey(key)
        end
    end

    local function startEquipLoop(slot)
        if CombatCfg.EquipThread then
            task.cancel(CombatCfg.EquipThread)
            CombatCfg.EquipThread = nil
        end
        CombatCfg.EquipThread = task.spawn(function()
            while CombatCfg.SelectedSlot == slot and CombatCfg.AutoEquipEnabled do
                task.wait(1)
                local char = player.Character
                if char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
                    local currentTool = char:FindFirstChildOfClass("Tool")
                    if not currentTool or (CombatCfg.LastEquippedTool and currentTool ~= CombatCfg.LastEquippedTool) then
                        pressSlotKey(slot)
                        task.wait(0.2)
                        CombatCfg.LastEquippedTool = char:FindFirstChildOfClass("Tool")
                    end
                end
            end
            CombatCfg.EquipThread = nil
        end)
    end

    -- equipSlot: apenas SALVA a seleção. Se o toggle estiver ligado, equipa de imediato.
    local function equipSlot(slot)
        if CombatCfg.EquipThread then
            task.cancel(CombatCfg.EquipThread)
            CombatCfg.EquipThread = nil
        end

        if slot == 0 or slot == nil or CombatCfg.SelectedSlot == slot then
            CombatCfg.SelectedSlot = nil
            CombatCfg.LastEquippedTool = nil
            return
        end

        CombatCfg.SelectedSlot = slot

        -- Só equipa agora se o toggle estiver ativo
        if CombatCfg.AutoEquipEnabled then
            pressSlotKey(slot)
            task.delay(0.3, function()
                local char = player.Character
                if char then
                    CombatCfg.LastEquippedTool = char:FindFirstChildOfClass("Tool")
                end
            end)
            startEquipLoop(slot)
        end
    end

    -- setAutoEquip: NÃO limpa mais SelectedSlot/LastEquippedTool ao desligar
    local function setAutoEquip(state)
        CombatCfg.AutoEquipEnabled = state
        if state then
            if CombatCfg.SelectedSlot and CombatCfg.SelectedSlot > 0 then
                -- Toggle ligou com slot já selecionado: equipa agora e inicia loop
                pressSlotKey(CombatCfg.SelectedSlot)
                task.delay(0.3, function()
                    local char = player.Character
                    if char then
                        CombatCfg.LastEquippedTool = char:FindFirstChildOfClass("Tool")
                    end
                end)
                startEquipLoop(CombatCfg.SelectedSlot)
            end
        else
            if CombatCfg.EquipThread then
                task.cancel(CombatCfg.EquipThread)
                CombatCfg.EquipThread = nil
            end
            -- Mantém CombatCfg.SelectedSlot e LastEquippedTool intactos
        end
    end

    local AttackThread = nil
    local function toggleAutoAttack(state)
        CombatCfg.AutoAttackEnabled = state
        if not state then return end
        if AttackThread then return end

        AttackThread = task.spawn(function()
            local lastScan = 0
            local mobNear = false

            while CombatCfg.AutoAttackEnabled do
                if CombatCfg.SkillBusy then
                    task.wait(0.03)
                else
                    local now = os.clock()
                    if now - lastScan >= CombatCfg.AttackScanInterval then
                        lastScan = now
                        local ok, result = pcall(AutoMob.IsMobNear, CombatCfg.AttackRange)
                        if ok then
                            mobNear = result
                        else
                            mobNear = false
                            warn("[RAMDOM HUB] Auto Attack erro: " .. tostring(result))
                        end
                    end

                    if mobNear then
                        pcall(clickOnce)
                        task.wait(CombatCfg.AttackDelay)
                    else
                        task.wait(0.05)
                    end
                end
            end
            AttackThread = nil
        end)
    end

    local function toggleAutoSkill(state)
        CombatCfg.AutoSkillEnabled = state
        if not state then
            CombatCfg.SkillBusy = false
            return
        end
        if CombatCfg.SkillThread then return end

        CombatCfg.SkillThread = task.spawn(function()
            while CombatCfg.AutoSkillEnabled do
                local cycleStart = os.clock()

                for _, data in ipairs(SKILL_KEYS) do
                    if not CombatCfg.AutoSkillEnabled then break end
                    if CombatCfg.SelectedSkills[data.Key] then
                        CombatCfg.SkillBusy = true
                        pressKey(data.Key)
                        task.wait(CombatCfg.SkillKeyGap)
                    end
                end

